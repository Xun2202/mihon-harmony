+            val start = pos
+            while (pos < length && buffer[pos] != ' '.code.toByte() && buffer[pos] != '\n'.code.toByte()) {
+                pos++
+            }
+            if (start == pos) return null
+            if (field == 11) {
+                utime = parseStatLong(buffer, start, pos) ?: return null
+            } else if (field == 12) {
+                stime = parseStatLong(buffer, start, pos) ?: return null
+            }
+            field++
+            if (pos < length && buffer[pos] == ' '.code.toByte()) pos++
+        }
