+    /** Reads [suffix] of [tid] into [buffer]. Returns the byte count. Does not allocate the buffer. */
+    private fun readProc(tid: Int, suffix: String, buffer: ByteArray): Int {
+        pathBuilder.setLength(0)
+        pathBuilder.append("/proc/self/task/")
+        pathBuilder.append(tid)
+        pathBuilder.append(suffix)
+        val fd = Os.open(pathBuilder.toString(), OsConstants.O_RDONLY, 0)
+        return try {
+            var total = 0
+            while (total < buffer.size) {
+                val count = Os.read(fd, buffer, total, buffer.size - total)
+                if (count <= 0) break
+                total += count
+            }
+            total
+        } finally {
+            Os.close(fd)
+        }
+    }
