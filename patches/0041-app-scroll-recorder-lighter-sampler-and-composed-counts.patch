+    private fun parseStatLong(buffer: ByteArray, start: Int, end: Int): Long? {
+        if (start >= end) return null
+        var index = start
+        var sign = 1L
+        if (buffer[index] == '-'.code.toByte()) {
+            sign = -1L
+            index++
+            if (index >= end) return null
