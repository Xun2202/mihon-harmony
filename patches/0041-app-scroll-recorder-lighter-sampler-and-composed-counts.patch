+        var value = 0L
+        var any = false
+        while (index < end) {
+            val digit = buffer[index].toInt() and 0xFF
+            if (digit < '0'.code || digit > '9'.code) return null
+            value = value * 10 + (digit - '0'.code)
+            any = true
+            index++
+        }
+        if (!any) return null
+        return sign * value
+    }
