+    fun parseStatCpuTicks(buffer: ByteArray, length: Int): Long? {
+        if (length <= 0) return null
+        var end = -1
+        for (index in 0 until length) {
+            if (buffer[index] == ')'.code.toByte()) end = index
+        }
+        if (end < 0 || end + 2 >= length) return null
+        var pos = end + 2
+        var field = 0
+        var utime = -1L
+        var stime = -1L
