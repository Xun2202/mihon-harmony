+        suspend fun book() = checkNotNull(manga.getMangaByUrlAndSourceId("/series/book", SOURCE))
+
+        suspend fun chapter() = chapters.getChapterByMangaId(book().id).single()
+
+        suspend fun revision() = db.manga_syncQueries.localRevision().awaitAsOne()
+
+        suspend fun refreshSourceDetails() {
+            val book = book()
+            val update = MangaRemoteUpdate(
+                id = book.id,
+                title = book.title,
+                author = book.author,
+                artist = book.artist,
