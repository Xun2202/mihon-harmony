+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.tachiyomi.data.backup.models.BackupCategory
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class MangaSyncLibraryTest {
+    @Test
+    fun `category reorder keeps wire membership identity and a concurrent local category`() {
+        val localOnly = BackupCategory(name = "New local category", order = 1, id = 1)
+        val first = BackupCategory(name = "Earlier", order = 2, id = 2)
+        val second = BackupCategory(name = "Later", order = 0, id = 3)
+        val firstOnWire = first.copy(id = 12, order = 900, uid = 900, syncOrder = 0)
+        val secondOnWire = second.copy(id = 13, order = 100, uid = 100, syncOrder = 1)
+
+        val layout = arrangeMangaSyncCategories(listOf(secondOnWire to second, firstOnWire to first), listOf(localOnly))
+
+        assertEquals(listOf(2L, 1L, 3L), layout.rows.map { it.id })
+        assertEquals(listOf(0L, 1L, 2L), layout.rows.map { it.order })
+        assertEquals(mapOf(900L to 2L, 100L to 3L), layout.idsByWireOrder)
+        assertEquals(localOnly, layout.rows[1])
+    }
+
+    @Test
+    fun `restored edit times preserve precision and do not invent a timestamp for old data`() {
+        val millis = 1_700_000_000_321L
+        assertEquals(millis, syncMillis(millis / 1_000, millis))
+        assertEquals(millis, syncMillis(millis, 12))
+        assertEquals(1_700_000_000_000L, syncMillis(millis / 1_000, 12))
+        assertEquals(0L, syncMillis(0, 12))
+    }
+
+    @Test
+    fun `incoming progress can rewind independently of a newly edited local bookmark`() {
+        val priorProgress = true to 20
+        assertTrue(incomingChapterFieldWins(priorProgress, priorProgress, false to 0, guard = true))
+        assertFalse(incomingChapterFieldWins(true, false, false, guard = true))
+        assertFalse(incomingChapterFieldWins(false, true, false, guard = true))
+    }
+
+    @Test
+    fun `a round trip with conflicting progress changes retries without overwriting the local edit`() {
+        val failure = assertThrows(SyncYomiFailure::class.java) {
+            incomingChapterFieldWins(false to 25, false to 5, true to 0, guard = true)
+        }
+        assertEquals(SyncYomiProblem.STALE, failure.problem)
+    }
+}
