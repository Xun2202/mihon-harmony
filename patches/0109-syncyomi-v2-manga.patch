+class MangaSyncWorker(context: Context, workerParams: WorkerParameters) : CoroutineWorker(context, workerParams) {
+
+    @Inject private lateinit var settings: MangaSyncSettings
+
+    @Inject private lateinit var service: MangaSyncService
+
+    @Inject private lateinit var changes: MangaSyncChangeObserver
+
+    override suspend fun doWork(): Result {
+        applicationContext.appGraph.inject(this)
+
+        val config = inputData.getLong(INPUT_CONFIGURATION, -1)
+        val trigger = when {
+            TAG_MANUAL in tags -> Trigger.MANUAL
+            TAG_PERIODIC in tags -> Trigger.PERIODIC
+            else -> Trigger.CHANGE
+        }
+        if (trigger == Trigger.PERIODIC && settings.periodicHours.get() <= 0) return Result.success()
+        if (trigger == Trigger.CHANGE && !settings.syncOnChange.get()) return Result.success()
+        val connection = settings.connection(config) ?: return Result.success()
+        if (BackupRestoreWorker.isRunning(applicationContext.workManager)) return Result.retry()
+        if (!syncLock.tryLock()) return Result.retry()
+
+        return try {
+            val revision = changes.localRevision()
+            if (trigger == Trigger.CHANGE && !settings.hasPendingChanges(config, revision)) return Result.success()
+            setForegroundSafely()
+            service.sync(connection.host, connection.apiKey, connection.deviceId)
+            settings.recordSuccess(config, revision)
+            Result.success()
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            val issue = e.toIssue()
+            settings.recordIssue(config, issue)
+            logcat(LogPriority.WARN) { "SyncYomi synchronization failed (${issue.error})" }
+            val transient = when (e) {
+                is SyncYomiFailure -> e.isTransient
+                is SSLException -> false
+                else -> e is IOException
+            }
+            if (transient && runAttemptCount < 3) Result.retry() else Result.failure()
+        } finally {
+            syncLock.unlock()
+        }
+    }
+
+    override suspend fun getForegroundInfo(): ForegroundInfo {
+        val context = applicationContext
+        val notification = NotificationCompat.Builder(context, Notifications.CHANNEL_COMMON)
+            .setSmallIcon(android.R.drawable.stat_notify_sync)
+            .setContentTitle(context.stringResource(MR.strings.syncyomi_title))
+            .setContentText(context.stringResource(MR.strings.syncyomi_running))
+            .setOnlyAlertOnce(true)
+            .setOngoing(true)
+            .build()
+        return ForegroundInfo(
+            NOTIFICATION_ID,
+            notification,
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) ServiceInfo.FOREGROUND_SERVICE_TYPE_DATA_SYNC else 0,
+        )
+    }
+
+    companion object {
+        private const val INPUT_CONFIGURATION = "sync_configuration_revision"
+        private const val NOTIFICATION_ID = -801
+        private const val TAG = "MangaSync"
+        internal const val TAG_MANUAL = "$TAG:manual"
+        internal const val TAG_PERIODIC = "$TAG:periodic"
+        private const val TAG_CHANGE = "$TAG:change"
+        private const val TAG_TRAILING_CHANGE = "$TAG_CHANGE:trailing"
+
+        private val syncLock = Mutex()
+        private val constraints = Constraints(requiredNetworkType = NetworkType.CONNECTED)
+
+        internal fun configurationTag(revision: Long) = "$TAG:configuration:$revision"
+
+        private fun workName(tag: String, revision: Long) = "$tag:$revision"
+
+        internal fun startNow(context: Context, revision: Long) {
+            val request = OneTimeWorkRequestBuilder<MangaSyncWorker>()
+                .addTag(TAG)
+                .addTag(configurationTag(revision))
+                .addTag(TAG_MANUAL)
+                .setInputData(workDataOf(INPUT_CONFIGURATION to revision))
+                .setConstraints(constraints)
+                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, 30, TimeUnit.SECONDS)
+                .build()
+            context.workManager.enqueueUniqueWork(workName(TAG_MANUAL, revision), ExistingWorkPolicy.KEEP, request)
+        }
+
+        internal fun configurePeriodic(context: Context, revision: Long, hours: Int) {
+            val name = workName(TAG_PERIODIC, revision)
+            if (hours <= 0) {
+                context.workManager.cancelUniqueWork(name)
+                return
+            }
+            val request = PeriodicWorkRequestBuilder<MangaSyncWorker>(hours.toLong(), TimeUnit.HOURS)
+                .addTag(TAG)
+                .addTag(configurationTag(revision))
+                .addTag(TAG_PERIODIC)
+                .setInputData(workDataOf(INPUT_CONFIGURATION to revision))
+                .setConstraints(constraints)
+                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, 1, TimeUnit.MINUTES)
+                .setInitialDelay(hours.toLong(), TimeUnit.HOURS)
+                .build()
+            context.workManager.enqueueUniquePeriodicWork(name, ExistingPeriodicWorkPolicy.UPDATE, request)
+        }
+
+        internal fun cancelChanges(context: Context, revision: Long) {
+            context.workManager.cancelUniqueWork(workName(TAG_CHANGE, revision))
+            context.workManager.cancelUniqueWork(workName(TAG_TRAILING_CHANGE, revision))
+        }
+
+        internal suspend fun cancelPreviousConfigurations(
+            context: Context,
+            settings: MangaSyncSettings,
+            revision: Long,
+        ) {
+            val manager = context.workManager
+            val tasks = manager.getWorkInfosByTagFlow(TAG).first()
+            if (settings.revision.get() != revision) return
+            tasks.filter { !it.state.isFinished && configurationTag(revision) !in it.tags }
+                .forEach { manager.cancelWorkById(it.id) }
+        }
+
+        internal suspend fun afterLocalChange(context: Context, revision: Long) {
+            val manager = context.workManager
+            val tasks = manager.getWorkInfosByTagFlow(configurationTag(revision)).first()
+                .filter { TAG_CHANGE in it.tags }
+            if (tasks.any { it.state == WorkInfo.State.ENQUEUED || it.state == WorkInfo.State.BLOCKED }) return
+
+            // An edit during a running sync still needs a pending work request of its own.
+            val tag = if (tasks.any { it.state == WorkInfo.State.RUNNING && TAG_TRAILING_CHANGE !in it.tags }) {
+                TAG_TRAILING_CHANGE
+            } else {
+                TAG_CHANGE
+            }
+            val request = OneTimeWorkRequestBuilder<MangaSyncWorker>()
+                .addTag(TAG)
+                .addTag(configurationTag(revision))
+                .addTag(TAG_CHANGE)
+                .addTag(tag)
+                .setInputData(workDataOf(INPUT_CONFIGURATION to revision))
+                .setConstraints(constraints)
+                .setInitialDelay(1, TimeUnit.MINUTES)
+                .setBackoffCriteria(BackoffPolicy.EXPONENTIAL, 1, TimeUnit.MINUTES)
+                .build()
+            manager.enqueueUniqueWork(workName(tag, revision), ExistingWorkPolicy.KEEP, request).result.get()
+        }
+    }
+
+    private enum class Trigger { MANUAL, PERIODIC, CHANGE }
+}
+
+@Inject
+@SingleIn(AppScope::class)
+class MangaSyncChangeObserver(
+    private val context: Context,
+    private val settings: MangaSyncSettings,
+    private val database: Lazy<Database>,
+    private val driver: Lazy<SqlDriver>,
+) {
+    fun start(scope: CoroutineScope) {
+        scope.launch(Dispatchers.IO) {
+            var previous: Schedule? = null
+            combine(
+                settings.revision.changes(),
+                settings.periodicHours.changes(),
+                settings.syncOnChange.changes(),
+                ::Schedule,
+            )
+                .distinctUntilChanged()
+                .collectLatest { schedule ->
+                    val previousRevision = previous?.revision
+                    if (schedule.revision == 0L) return@collectLatest
+                    if (previousRevision != schedule.revision) {
+                        MangaSyncWorker.cancelPreviousConfigurations(context, settings, schedule.revision)
+                    }
+                    val connection = settings.summary()
+                    if (connection.revision != schedule.revision) return@collectLatest
+                    val periodicChanged = previousRevision != schedule.revision ||
+                        previous?.periodicHours != schedule.periodicHours
+                    if (connection.configured && periodicChanged) {
+                        MangaSyncWorker.configurePeriodic(context, schedule.revision, schedule.periodicHours)
+                    }
+                    previous = schedule
+                    if (connection.configured && schedule.afterChanges) {
+                        observeLocalRevision(schedule.revision)
+                    } else if (connection.configured) {
+                        MangaSyncWorker.cancelChanges(context, schedule.revision)
+                    }
+                }
+        }
+    }
+
+    internal suspend fun localRevision(): Long = database.value.manga_syncQueries.localRevision().awaitAsOne()
+
+    private suspend fun observeLocalRevision(configurationRevision: Long) {
+        callbackFlow {
+            val listener = Query.Listener { trySend(Unit) }
+            val sqlDriver = driver.value
+            sqlDriver.addListener(*OBSERVED_TABLES, listener = listener)
+            trySend(Unit)
+            awaitClose { sqlDriver.removeListener(*OBSERVED_TABLES, listener = listener) }
+        }
+            .conflate()
+            .map { localRevision() }
+            .distinctUntilChanged()
+            .onEach { localRevision ->
+                if (settings.hasPendingChanges(configurationRevision, localRevision)) {
+                    MangaSyncWorker.afterLocalChange(context, configurationRevision)
+                }
+            }
+            .retryWhen { cause, _ ->
+                if (cause !is Exception || cause is CancellationException) return@retryWhen false
+                logcat(LogPriority.WARN) { "Unable to observe local SyncYomi changes" }
+                delay(30_000)
+                true
+            }
+            .collect {}
+    }
+
+    private data class Schedule(val revision: Long, val periodicHours: Int, val afterChanges: Boolean)
+
+    private companion object {
+        val OBSERVED_TABLES = arrayOf(
+            "manga",
+            "chapter",
+            "category",
+            "manga_category",
+            "history",
+            "manga_track",
+            "excluded_scanlator",
+            "manga_sync_revision",
+        )
+    }
+}
+
+private fun Exception.toIssue(): MangaSyncIssue {
+    val error = when (this) {
+        is SyncYomiFailure -> MangaSyncError.valueOf(problem.name)
+        is SSLException -> MangaSyncError.CERTIFICATE
+        is IOException -> MangaSyncError.NETWORK
+        else -> MangaSyncError.GENERAL
+    }
+    return MangaSyncIssue(error, (this as? SyncYomiFailure)?.status ?: 0)
+}
