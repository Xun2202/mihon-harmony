+                assertEquals(remote.genre, first.book().genre)
+                assertEquals("https://reader.example/series/book", remote.sourceUrl)
+                assertEquals("https://reader.example/cover.jpg", remote.thumbnailUrl)
+                assertEquals(2L, remote.chapters.single().lastPageRead)
