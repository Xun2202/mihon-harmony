+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.tachiyomi.data.backup.models.Backup
+import eu.kanade.tachiyomi.data.backup.models.BackupCategory
+import eu.kanade.tachiyomi.data.backup.models.BackupChapter
+import eu.kanade.tachiyomi.data.backup.models.BackupManga
+import eu.kanade.tachiyomi.data.backup.models.BackupPreference
+import eu.kanade.tachiyomi.data.backup.models.BackupTracking
+import eu.kanade.tachiyomi.data.backup.models.StringPreferenceValue
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+
+class MangaSyncCheckpointTest {
+    @TempDir
+    lateinit var directory: File
+
+    private val now = 1_750_000_000_000L
+    private val chapter = BackupChapter(url = "/1", name = "One", read = true, lastPageRead = 25, lastModifiedAt = now)
+    private val second = BackupChapter(url = "/2", name = "Two", lastModifiedAt = now)
+    private val work = BackupManga(
+        source = 42,
+        url = "/work",
+        title = "Work",
+        favorite = true,
+        lastModifiedAt = now,
+        chapters = listOf(chapter, second),
+    )
+
+    @Test
+    fun `unfavorite unread and rewind send exact values with edit time even after delay`() {
+        val sync = checkpoint()
+        val initial = sync.plan(backup(work), null, now)
+        val old = initial.acknowledge(1, false)
+        val edited = work.copy(
+            favorite = false,
+            lastModifiedAt = now + 300,
+            chapters = listOf(chapter.copy(read = false, lastPageRead = 0, lastModifiedAt = now + 200), second),
+        )
+        val delta = sync.plan(backup(edited), old, now + 180_000, initial.upload)
+        val sent = delta.upload.backupManga.single()
+        assertFalse(sent.favorite)
+        assertEquals(now + 300, sent.version)
+        val unread = sent.chapters.single()
+        assertFalse(unread.read)
+        assertEquals(0L, unread.lastPageRead)
+        assertEquals(now + 200, unread.version)
+        assertEquals((now + 200) / 1000, unread.lastModifiedAt)
+    }
+
+    @Test
+    fun `an older offline edit syncing last returns the newer remote winner`() {
+        val sync = checkpoint()
+        val baseline = sync.plan(backup(work), null, now).acknowledge(1, false)
+        val later =
+            wire(
+                work.copy(
+                    lastModifiedAt = now + 3000,
+                    chapters = listOf(
+                        chapter.copy(
+                            read = false,
+                            lastPageRead = 0,
+                            lastModifiedAt =
+                            now + 2000,
+                        ),
+                        second,
+                    ),
+                ),
+            )
+        val stale = work.copy(chapters = listOf(chapter.copy(lastPageRead = 70, lastModifiedAt = now + 1000), second))
+        val reply = sync.plan(backup(stale), baseline, now + 90_000, backup(later)).upload.backupManga.single()
+        assertTrue(reply.chapters.single().version < later.chapters.first().version)
+        assertFalse(reply.chapters.single().read)
+        assertEquals(0L, reply.chapters.single().lastPageRead)
+    }
+
+    @Test
+    fun `independent offline bookmark and rewind edits merge in either arrival order`() {
+        val sync = checkpoint()
+        val original = chapter.copy(progressModifiedAt = now, bookmarkModifiedAt = now)
+        val initial = work.copy(chapters = listOf(original))
+        val before = sync.plan(backup(initial), null, now).acknowledge(1, false)
+        val bookmark = original.copy(bookmark = true, lastModifiedAt = now + 1000, bookmarkModifiedAt = now + 1000)
+        val rewind = original.copy(
+            read = false,
+            lastPageRead = 0,
+            lastModifiedAt = now + 2000,
+            progressModifiedAt =
+            now + 2000,
+        )
+
+        fun upload(local: BackupChapter, remote: BackupChapter): BackupChapter {
+            val localWork = initial.copy(chapters = listOf(local))
+            val remoteWork = wire(initial.copy(chapters = listOf(remote)))
+            val plan = sync.plan(backup(localWork), before, now + 3000, backup(remoteWork))
+            assertTrue(plan.full)
+            return plan.upload.backupManga.single().chapters.single()
+        }
+
+        val rewindFirst = upload(bookmark, rewind)
+        val bookmarkFirst = upload(rewind, bookmark)
+        for (merged in listOf(rewindFirst, bookmarkFirst)) {
+            assertTrue(merged.bookmark)
+            assertFalse(merged.read)
+            assertEquals(0L, merged.lastPageRead)
+            assertEquals(now + 1000, merged.bookmarkModifiedAt)
+            assertEquals(now + 2000, merged.progressModifiedAt)
+        }
+        assertTrue(rewindFirst.version > now + 2000)
+
+        val lateStale = original.copy(lastPageRead = 99, lastModifiedAt = now + 1500, progressModifiedAt = now + 1500)
+        val latest = wire(initial).copy(chapters = listOf(rewindFirst))
+        val stalePlan = sync.plan(
+            backup(initial.copy(chapters = listOf(lateStale))),
+            before,
+            now + 4000,
+            backup(latest),
+        )
+        val refused = stalePlan.upload.backupManga.single().chapters.single()
+        assertTrue(refused.version < rewindFirst.version)
+        assertEquals(0L, refused.lastPageRead)
+        assertTrue(refused.bookmark)
+    }
+
+    @Test
+    fun `a synthetic wire revision cannot outrank a later actual edit to the same field`() {
+        val sync = checkpoint()
+        val baselineChapter = chapter.copy(
+            bookmark = true,
+            lastModifiedAt = now + 1000,
+            bookmarkModifiedAt = now + 1000,
+            progressModifiedAt = now,
+        )
+        val initial = work.copy(chapters = listOf(baselineChapter))
+        val before = sync.plan(backup(initial), null, now + 1000).acknowledge(1, false)
+        val composed = baselineChapter.copy(
+            bookmark = true,
+            read = false,
+            lastPageRead = 0,
+            version = now + 2005,
+            lastModifiedAt = (now + 2000) / 1000,
+            progressModifiedAt = now + 2000,
+        )
+        val localBookmark = baselineChapter.copy(
+            bookmark = false,
+            lastModifiedAt = now + 1500,
+            bookmarkModifiedAt = now + 1500,
+        )
+        val latest = wire(initial).copy(chapters = listOf(composed))
+        val request = sync.plan(
+            backup(initial.copy(chapters = listOf(localBookmark))),
+            before,
+            now + 3000,
+            backup(latest),
+        )
+        val sent = request.upload.backupManga.single().chapters.single()
+        assertFalse(sent.bookmark)
+        assertFalse(sent.read)
+        assertEquals(0L, sent.lastPageRead)
+        assertEquals(now + 1500, sent.bookmarkModifiedAt)
+        assertEquals(now + 2000, sent.progressModifiedAt)
+        assertTrue(sent.version > composed.version)
+    }
+
+    @Test
+    fun `first join keeps existing work fields while publishing a new local chapter or work`() {
+        val sync = checkpoint()
+        val tracks = listOf(BackupTracking(syncId = 1, libraryId = 7))
+        val serverWork = wire(work.copy(title = "Existing library title", tracking = tracks))
+        val third = BackupChapter(url = "/3", name = "Three", lastModifiedAt = now + 2000)
+        val untouched = work.copy(
+            title = "Legacy title",
+            lastModifiedAt = 0,
+            chapters = listOf(chapter.copy(lastModifiedAt = 0), third),
+        )
+        val localOnly = work.copy(url = "/local", chapters = emptyList())
+        val plan = sync.plan(backup(untouched, localOnly), null, now + 3000, backup(serverWork))
+        val published = plan.upload.backupManga.associateBy { it.url }
+        assertEquals(setOf(work.url, localOnly.url), published.keys)
+        val target = published.getValue(work.url)
+        assertEquals("Existing library title", target.title)
+        assertEquals(tracks, target.tracking)
+        assertEquals(listOf(third.url), target.chapters.map { it.url })
+        assertTrue(target.version < serverWork.version)
+        assertTrue(plan.deletedChapters.isEmpty())
+    }
+
+    @Test
+    fun `fresh source scans can publish new chapters without overwriting remote reader progress`() {
+        val sync = checkpoint()
+        val serverWork = wire(work.copy(chapters = listOf(chapter)))
+        val scanned = chapter.copy(read = false, lastPageRead = 0, lastModifiedAt = 0, syncSourceAddedAt = now + 1000)
+        val newFromSource = second.copy(lastModifiedAt = 0, syncSourceAddedAt = now + 2000)
+        val local = work.copy(lastModifiedAt = 0, chapters = listOf(scanned, newFromSource))
+        val plan = sync.plan(backup(local), null, now + 2000, backup(serverWork))
+        val chapters = plan.upload.backupManga.single().chapters.associateBy { it.url }
+        val existing = chapters.getValue(scanned.url)
+        assertTrue(existing.version < serverWork.chapters.single().version)
+        assertEquals(25L, existing.lastPageRead)
+        assertTrue(existing.read)
+        val discovered = chapters.getValue(newFromSource.url)
+        assertEquals(now + 2000, discovered.version)
+        assertEquals((now + 2000) / 1000, discovered.lastModifiedAt)
+    }
+
+    @Test
+    fun `only explicit newer deletions of acknowledged chapters are sent and safely retried`() {
+        val sync = checkpoint()
+        val initial = sync.plan(backup(work), null, now)
+        val old = initial.acknowledge(1, false)
+        val removed = work.copy(chapters = listOf(chapter))
+        val key = "42|/work\u001f/2"
+        val proof = mapOf(key to now + 1000)
+        assertTrue(sync.plan(backup(removed), old, now + 1000, initial.upload).deletedChapters.isEmpty())
+        val deleted = sync.plan(backup(removed), old, now + 1000, initial.upload, proof)
+        assertEquals(setOf(key), deleted.deletedChapters)
+        assertEquals(
+            deleted.deletedChapters,
+            sync.plan(backup(removed), old, now + 9000, initial.upload, proof).deletedChapters,
+        )
+        val newer =
+            wire(work.copy(chapters = listOf(chapter, second.copy(lastModifiedAt = now + 2000, bookmark = true))))
+        val obsolete = sync.plan(backup(removed), old, now + 9000, backup(newer), proof)
+        assertTrue(obsolete.deletedChapters.isEmpty())
+        assertTrue(obsolete.upload.backupManga.single().version < newer.version)
+    }
+
+    @Test
+    fun `local-only legacy chapters never become deletion candidates after joining`() {
+        val sync = checkpoint()
+        val untouched = second.copy(lastModifiedAt = 0)
+        val remote = backup(wire(work.copy(chapters = listOf(chapter))))
+        val joined = sync.plan(backup(work.copy(chapters = listOf(chapter, untouched))), null, now, remote)
+        val previous = joined.acknowledge(1, false, remote, backup(work.copy(chapters = listOf(chapter, untouched))))
+        assertFalse(previous.snapshot.backupManga.single().chapters.last().wasAcknowledgedForMangaSync)
+        val proof = mapOf("42|/work\u001f/2" to now + 20)
+        val next = sync.plan(backup(work.copy(chapters = listOf(chapter))), previous, now + 20, remote, proof)
+        assertTrue(next.deletedChapters.isEmpty())
+        assertTrue(next.upload.backupManga.isEmpty())
+    }
+
+    @Test
+    fun `reconciliation acknowledges a restored chapter while keeping an independent local edit pending`() {
+        val sync = checkpoint()
+        val old = sync.plan(backup(work), null, now).acknowledge(1, false)
+        val request = sync.plan(backup(work), old, now + 2000, backup(wire(work)))
+        val remoteFirst = chapter.copy(read = false, lastPageRead = 0, lastModifiedAt = now + 1000)
+        val localSecond = second.copy(bookmark = true, lastModifiedAt = now + 2000)
+        val remote = backup(wire(work.copy(chapters = listOf(remoteFirst, second))))
+        val actual = backup(work.copy(chapters = listOf(remoteFirst, localSecond)))
+        val acknowledged = request.acknowledge(2, false, remote, actual)
+        val next = sync.plan(actual, acknowledged, now + 3000, remote)
+        val sent = next.upload.backupManga.single().chapters.single()
+        assertEquals(localSecond.url, sent.url)
+        assertTrue(sent.bookmark)
+        assertEquals(now + 2000, sent.version)
+    }
+
+    @Test
+    fun `memo comparison ignores array identity and JSON key order`() {
+        val sync = checkpoint()
+        val original = work.copy(
+            memo = """{"name":"title","hint":{"z":2,"a":1}}""".encodeToByteArray(),
+            chapters = listOf(chapter.copy(memo = "{}".encodeToByteArray())),
+        )
+        val initial = sync.plan(backup(original), null, now)
+        val old = initial.acknowledge(1, false)
+        val reordered = original.copy(
+            memo = """{"hint":{"a":1,"z":2},"name":"title"}""".encodeToByteArray(),
+            chapters = listOf(chapter.copy(memo = byteArrayOf())),
+        )
+        assertTrue(sync.plan(backup(reordered), old, now + 1000, initial.upload).upload.backupManga.isEmpty())
+    }
+
+    @Test
+    fun `wire order is unique and a metadata edit keeps a remote-only category`() {
+        val sync = checkpoint()
+        val remoteCategory = BackupCategory("Server", id = 4, order = 420, uid = 420, syncOrder = 0)
+        val localCategory = BackupCategory("Local", id = 7, order = 0)
+        val remote = backup(
+            wire(work.copy(categories = listOf(remoteCategory.order))),
+        ).copy(backupCategories = listOf(remoteCategory))
+        val local = backup(
+            work.copy(notes = "Local edit", lastModifiedAt = now + 1000, categories = listOf(localCategory.order)),
+        )
+            .copy(backupCategories = listOf(localCategory))
+        val plan = sync.plan(local, null, now + 1000, remote)
+        val categories = plan.upload.backupCategories
+        assertEquals(2, categories.map { it.order }.toSet().size)
+        assertEquals(setOf(0L), categories.map { it.syncOrder }.toSet())
+        assertEquals(categories.map { it.order }.toSet(), plan.upload.backupManga.single().categories.toSet())
+        assertEquals(listOf(0L), plan.local.backupManga.single().categories)
+    }
+
+    @Test
+    fun `an unfavorite and late source details converge in either device arrival order`() {
+        val left = checkpoint()
+        val right = MangaSyncCheckpoint(directory, "https://sync.example", "fake-api-key", "device-b")
+        val initial = left.plan(backup(work), null, now)
+        val beforeLeft = initial.acknowledge(1, false)
+        val beforeRight = right.plan(backup(work), null, now).acknowledge(1, false)
+        val unfavorite = work.copy(
+            favorite = false,
+            lastModifiedAt = now + 1000,
+            notes = "Personal note",
+            chapterFlags = 8,
+        )
+        val details = work.copy(
+            genre = listOf("Adventure", "Drama"),
+            description = "Arrived after the favorite had synced.",
+            thumbnailUrl = "https://covers.example/title",
+            sourceUrl = "https://reader.example/books/title",
+        )
+
+        val leftFirst = left.plan(backup(unfavorite), beforeLeft, now + 1000, initial.upload).upload
+        val rightAfterLeft = right.plan(backup(details), beforeRight, now + 2000, leftFirst)
+        assertTrue(rightAfterLeft.full)
+        val rightFirst = right.plan(backup(details), beforeRight, now + 2000, initial.upload).upload
+        val leftAfterRight = left.plan(backup(unfavorite), beforeLeft, now + 3000, rightFirst)
+        for (merged in listOf(rightAfterLeft.upload.backupManga.single(), leftAfterRight.upload.backupManga.single())) {
+            assertFalse(merged.favorite)
+            assertEquals("Personal note", merged.notes)
+            assertEquals(8, merged.chapterFlags)
+            assertEquals(now + 1000, merged.syncUserModifiedAt())
+            assertEquals(details.genre, merged.genre)
+            assertEquals(details.description, merged.description)
+            assertEquals(details.thumbnailUrl, merged.thumbnailUrl)
+            assertEquals(details.sourceUrl, merged.sourceUrl)
+        }
+        assertTrue(rightAfterLeft.upload.backupManga.single().version > leftFirst.backupManga.single().version)
+    }
+
+    @Test
+    fun `a sparse stale source refresh preserves concurrent tags and newer user fields`() {
+        val sync = checkpoint()
+        val original = work.copy(genre = listOf("Early"), description = "Description", thumbnailUrl = "/cover")
+        val before = sync.plan(backup(original), null, now).acknowledge(1, false)
+        val remote = wire(
+            original.copy(
+                favorite = false,
+                notes = "New notes",
+                chapterFlags = 16,
+                genre = listOf("Remote update"),
+                lastModifiedAt = now + 1000,
+            ),
+        )
+        val stale = original.copy(
+            title = "",
+            genre = listOf("Older source copy"),
+            description = null,
+            thumbnailUrl = "",
+            sourceUrl = "https://reader.example/books/late-link",
+        )
+        val result = sync.plan(backup(stale), before, now + 2000, backup(remote)).upload.backupManga.single()
+        assertEquals("Work", result.title)
+        assertEquals(listOf("Remote update"), result.genre)
+        assertEquals("Description", result.description)
+        assertEquals("/cover", result.thumbnailUrl)
+        assertEquals(stale.sourceUrl, result.sourceUrl)
+        assertFalse(result.favorite)
+        assertEquals("New notes", result.notes)
+        assertEquals(16, result.chapterFlags)
+        assertEquals(remote.syncUserModifiedAt(), result.syncUserModifiedAt())
+    }
+
+    @Test
+    fun `source-only synthetic revisions do not make a real user edit obsolete`() {
+        val sync = checkpoint()
+        val before = sync.plan(backup(work), null, now).acknowledge(1, false)
+        val remote = wire(work.copy(description = "Fetched")).copy(version = now + 5000, userModifiedAt = now)
+        val removed = work.copy(favorite = false, lastModifiedAt = now + 1000)
+        val result = sync.plan(backup(removed), before, now + 6000, backup(remote)).upload.backupManga.single()
+        assertFalse(result.favorite)
+        assertEquals("Fetched", result.description)
+        assertEquals(now + 1000, result.syncUserModifiedAt())
+        assertTrue(result.version > remote.version)
+    }
+
+    @Test
+    fun `checkpoint uses atomic private account files and discards unrelated preference sections`() {
+        val sync = checkpoint()
+        val selected = backup(work).copy(
+            backupPreferences = listOf(BackupPreference("secret", StringPreferenceValue("fixture"))),
+        )
+        val old = sync.plan(selected, null, now).acknowledge(2, true)
+        sync.save(old)
+        assertEquals(2L, sync.load()?.cursor)
+        assertTrue(sync.load()!!.snapshot.backupPreferences.isEmpty())
+        assertNull(checkpoint(key = "different").load())
+        assertNull(checkpoint(host = "https://other.example").load())
+        val file = directory.listFiles()!!.single()
+        assertFalse("fake-api-key" in file.name)
+        File(directory, "${file.name}.new").writeText("interrupted")
+        assertEquals(2L, sync.load()?.cursor)
+        sync.save(old.copy(cursor = 3))
+        assertEquals(3L, sync.load()?.cursor)
+        assertEquals(listOf(file.name), directory.list()!!.toList())
+    }
+
+    private fun backup(vararg works: BackupManga) = Backup(backupManga = works.toList())
+
+    private fun wire(work: BackupManga) = work.copy(
+        version = work.lastModifiedAt,
+        lastModifiedAt = work.lastModifiedAt / 1000,
+        userModifiedAt = work.userModifiedAt ?: work.lastModifiedAt,
+        chapters = work.chapters.map {
+            it.copy(version = it.lastModifiedAt, lastModifiedAt = it.lastModifiedAt / 1000)
+        },
+    )
+
+    private fun checkpoint(host: String = "https://sync.example", key: String = "fake-api-key") =
+        MangaSyncCheckpoint(directory, host, key, "device")
+}
