+            val id = manga.insertNetworkManga(listOf(new)).single().id
+            manga.update(MangaUpdate(id) { favoriteAt = Clock.System.now() })
+            db.chapterQueries.insertReturningId(
+                mangaId = id,
+                remoteUrl = "/chapters/1",
+                remoteName = "Chapter 1",
+                remoteScanlator = null,
+                remoteChapterNumber = 1.0,
+                remoteDateUpload = null,
