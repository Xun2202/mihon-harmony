+startInbound:
+INSERT INTO manga_sync_inbound(id) VALUES (1);
+
+finishInbound:
+DELETE FROM manga_sync_inbound WHERE id = 1;
+
+localRevision:
+SELECT revision FROM manga_sync_revision WHERE id = 1;
+
+eligibleWorks:
+SELECT M.*
+FROM manga M
+WHERE M.user_favorite_at IS NOT NULL
+    OR EXISTS (SELECT 1 FROM manga_sync_work_stamp S WHERE S.manga_id = M.id)
+    OR EXISTS (
+        SELECT 1 FROM chapter C
+        LEFT JOIN manga_sync_chapter_stamp S ON S.chapter_id = C.id
+        WHERE C.manga_id = M.id
+        AND (C.user_read = 1 OR C.user_bookmark = 1 OR C.user_last_page_read != 0 OR S.user_touched = 1)
+    );
+
+workStamps:
+SELECT manga_id, modified_at FROM manga_sync_work_stamp WHERE manga_id IN :ids;
+
+chapterStamps:
+SELECT C.manga_id, C.remote_url, S.modified_at, S.source_added_at, S.progress_modified_at, S.bookmark_modified_at
+FROM manga_sync_chapter_stamp S JOIN chapter C ON C.id = S.chapter_id
+WHERE C.manga_id IN :ids;
+
+categoryStamps:
+SELECT category_id, modified_at FROM manga_sync_category_stamp;
+
+unfavorites:
+SELECT source_id, manga_url, modified_at FROM manga_sync_unfavorite;
+
+chapterDeletions:
+SELECT source_id, manga_url, chapter_url, deleted_at FROM manga_sync_chapter_deleted;
+
+categoryDeletions:
+SELECT category_id, deleted_at FROM manga_sync_category_deleted;
+
+clearChapterDeletion:
+DELETE FROM manga_sync_chapter_deleted
+WHERE source_id = :sourceId AND manga_url = :mangaUrl AND chapter_url = :chapterUrl;
+
+clearUnfavorite:
+DELETE FROM manga_sync_unfavorite WHERE source_id = :sourceId AND manga_url = :mangaUrl;
+
+restoreWorkStamp:
+INSERT INTO manga_sync_work_stamp(manga_id, modified_at)
+VALUES (:mangaId, :modifiedAt)
+ON CONFLICT(manga_id) DO UPDATE SET modified_at = excluded.modified_at;
+
+restoreChapterStamp:
+INSERT INTO manga_sync_chapter_stamp(chapter_id, modified_at, progress_modified_at, bookmark_modified_at, user_touched)
+VALUES (:chapterId, :modifiedAt, :progressModifiedAt, :bookmarkModifiedAt, 0)
+ON CONFLICT(chapter_id) DO UPDATE SET
+    modified_at = excluded.modified_at,
+    progress_modified_at = excluded.progress_modified_at,
+    bookmark_modified_at = excluded.bookmark_modified_at;
+
+restoreCategoryStamp:
+INSERT INTO manga_sync_category_stamp(category_id, modified_at)
+VALUES (:categoryId, :modifiedAt)
+ON CONFLICT(category_id) DO UPDATE SET modified_at = excluded.modified_at;
+
+insertCategory:
+INSERT INTO category(name, `order`, flags)
+VALUES (:name, (SELECT coalesce(max(`order`), -1) + 1 FROM category), :flags)
+RETURNING id;
+
+assignedWorks:
+SELECT M.source_id, M.remote_url FROM manga_category C JOIN manga M ON C.manga_id = M.id
+WHERE C.category_id = :categoryId;
