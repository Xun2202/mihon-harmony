+                if (existing != membership) {
+                    database.manga_categoryQueries.deleteMangaCategoryByMangaId(id)
+                    membership.forEach { database.manga_categoryQueries.insert(id, it) }
+                }
+                val restored = desired.copy(id = id)
+                applyChapters(restored, before ?: restored, incoming, current, sent, prior, chaptersToRename)
+                applyTracking(id, incoming, current, sent, prior)
+                applyScanlators(id, incoming, current, sent)
+                applyHistory(id, incoming, current, sent)
