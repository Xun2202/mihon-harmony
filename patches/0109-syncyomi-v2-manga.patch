+    @Test
+    fun `two SQLite bookshelves converge on unfavorite unread rewind and bookmark over v2`() = runBlocking {
+        val host = System.getenv("MIHON_TEST_SYNCYOMI_URL")
+        val key = System.getenv("MIHON_TEST_SYNCYOMI_KEY")
+        assumeTrue(host != null && key != null, "Run with scripts/with-test-syncyomi.py")
+        require(checkNotNull(host).startsWith("http://127.0.0.1:"))
+        val token = checkNotNull(key)
+        Device(File(directory, "first")).use { first ->
+            Device(File(directory, "second")).use { second ->
+                first.createBook()
+                first.readState(read = true, bookmarked = true, page = 63)
+                first.service.sync(host, token, "first")
+                second.service.sync(host, token, "second")
+                assertTrue(second.book().favorite)
+                assertTrue(second.chapter().read)
+                assertEquals(63, second.chapter().lastPageRead)
+
+                first.manga.update(MangaUpdate(first.book().id) { favoriteAt = null })
+                first.readState(read = false, bookmarked = false, page = 4)
+                first.service.sync(host, token, "first")
+                val revision = second.revision()
+                second.refreshSourceDetails()
+                assertTrue(second.revision() > revision)
+                val alreadyRefreshed = second.revision()
+                second.refreshSourceDetails()
+                assertEquals(alreadyRefreshed, second.revision())
+                second.service.sync(host, token, "second")
+                assertFalse(second.book().favorite)
+                assertEquals(listOf("demo", "mystery"), second.book().genre)
+                assertFalse(second.chapter().read)
+                assertFalse(second.chapter().bookmark)
+                assertEquals(4, second.chapter().lastPageRead)
