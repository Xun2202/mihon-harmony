+
+class SyncYomiTransportTest {
+    @Test
+    fun `guards raw and rendered libraries independently`() = runBlocking {
+        val manga = serialize(Backup(backupManga = listOf(BackupManga(1, "/manga"))))
+        val video = byteArrayOf(0xa0.toByte(), 0x1f, 0, 0xaa.toByte(), 0x1f, 0)
+        for ((raw, rendered) in listOf(manga to video, video to manga)) {
+            val calls = Collections.synchronizedList(mutableListOf<String>())
+            val server = start { exchange ->
+                val path = exchange.requestURI.path
+                calls += path
+                when (path) {
+                    "/api/sync/v2/capabilities" -> exchange.reply(200, CAPABILITIES)
+                    "/api/sync/content" -> exchange.reply(200, raw, etag = "uuid=fixture")
+                    "/api/sync/v2/snapshot" -> exchange.reply(200, rendered, etag = "seq=8", cursor = 8)
+                    else -> exchange.reply(500)
+                }
+            }
+            try {
+                val error = failureFrom { server.transport().inspect() }
+                assertEquals(SyncYomiProblem.OTHER_LIBRARY, error.problem)
+                assertEquals(2 + if (raw === manga) 1 else 0, calls.size)
+            } finally {
+                server.stop(0)
+            }
+        }
+    }
+
+    @Test
+    fun `uses conditional guards and refuses a later foreign raw write before merging`() = runBlocking {
+        val manga = serialize(Backup(backupManga = listOf(BackupManga(1, "/manga"))))
+        val calls = Collections.synchronizedList(mutableListOf<Pair<String, String?>>())
+        val server = start { exchange ->
+            when (val path = exchange.requestURI.path) {
+                "/api/sync/v2/capabilities" -> exchange.reply(200, CAPABILITIES)
+                "/api/sync/content" -> {
+                    val etag = exchange.requestHeaders.getFirst("If-None-Match")
+                    calls += path to etag
+                    if (etag == null) {
+                        exchange.reply(200, manga, etag = "seq=8")
+                    } else {
+                        exchange.reply(200, byteArrayOf(0xa0.toByte(), 0x1f, 0), etag = "uuid=video")
+                    }
+                }
+                "/api/sync/v2/snapshot" -> {
+                    calls += path to exchange.requestHeaders.getFirst("X-Sync-Cursor")
+                    exchange.reply(200, manga, etag = "seq=8", cursor = 8)
+                }
+                else -> {
+                    calls += path to null
+                    exchange.reply(500)
+                }
+            }
+        }
+        try {
+            val transport = server.transport()
+            assertEquals(8, transport.inspect().cursor)
+            val error = failureFrom { transport.merge(Backup(), cursor = 8, full = false) }
+            assertEquals(SyncYomiProblem.OTHER_LIBRARY, error.problem)
+            assertEquals(
+                listOf("/api/sync/content" to null, "/api/sync/v2/snapshot" to null, "/api/sync/content" to "seq=8"),
+                calls,
+            )
+        } finally {
+            server.stop(0)
+        }
+    }
+
+    @Test
+    fun `replans edits and tombstones after discovering a changed server cursor`() = runBlocking {
+        val cursor = AtomicLong(8)
+        val tombstone = "1|/manga\u001f/chapter"
+        val mutations = Collections.synchronizedList(mutableListOf<String>())
+        val server = start { exchange ->
+            val current = cursor.get()
+            val etag = "seq=$current"
+            when (val path = exchange.requestURI.path) {
+                "/api/sync/v2/capabilities" -> exchange.reply(200, CAPABILITIES)
+                "/api/sync/content" -> {
+                    val code = if (exchange.requestHeaders.getFirst("If-None-Match") == etag) 304 else 200
+                    exchange.reply(code, etag = etag)
+                }
+                "/api/sync/v2/snapshot" -> {
+                    val code = if (exchange.requestHeaders.getFirst("X-Sync-Cursor") == "$current") 304 else 200
+                    exchange.reply(code, etag = etag, cursor = current)
+                }
+                "/api/sync/v2/deletions" -> {
+                    mutations += path
+                    cursor.compareAndSet(9, 10)
+                    exchange.reply(200, """{"acknowledged":1}""".encodeToByteArray())
+                }
+                "/api/sync/v2/merge" -> {
+                    mutations += path
+                    exchange.responseHeaders.add("X-Sync-Changed", "false")
+                    exchange.reply(200, etag = etag, cursor = current)
+                }
+                else -> exchange.reply(500)
+            }
+        }
+        try {
+            val transport = server.transport()
+            assertEquals(8, transport.inspect().cursor)
+            cursor.incrementAndGet()
+            val pending = Backup(backupManga = listOf(BackupManga(1, "/manga", version = 20)))
+            assertEquals(SyncYomiProblem.STALE, failureFrom { transport.merge(pending, 8, false) }.problem)
+            with(failureFrom { transport.deleteChapters(setOf(tombstone)) }) {
+                assertEquals(SyncYomiProblem.STALE, problem)
+                assertTrue(isTransient)
+            }
+            assertTrue(mutations.isEmpty())
+
+            assertEquals(9, transport.inspect().cursor)
+            transport.deleteChapters(setOf(tombstone))
+            val blockedCategory = failureFrom { transport.merge(Backup(), 9, false, setOf(15)) }
+            assertEquals(SyncYomiProblem.STALE, blockedCategory.problem)
+            assertEquals(listOf("/api/sync/v2/deletions"), mutations)
+
+            assertEquals(10, transport.inspect().cursor)
+            transport.deleteChapters(setOf(tombstone))
+            transport.merge(Backup(), 10, false, setOf(15))
+            assertEquals(listOf("/api/sync/v2/deletions", "/api/sync/v2/deletions", "/api/sync/v2/merge"), mutations)
+        } finally {
+            server.stop(0)
+        }
+    }
+
+    @Test
+    fun `streams gzip and sends acknowledged chapter tombstones`() = runBlocking {
+        val upload = Backup(backupManga = listOf(BackupManga(1, "/manga", version = 8)))
+        val tombstone = "1|/manga\u001f/chapter"
+        val requests = Collections.synchronizedList(mutableListOf<String>())
+        val server = start { exchange ->
+            val path = exchange.requestURI.path
+            requests += path
+            check(exchange.requestHeaders.getFirst("X-API-Token") == "isolated-test-token")
+            when (path) {
+                "/api/sync/v2/capabilities" -> exchange.reply(200, CAPABILITIES)
+                "/api/sync/content", "/api/sync/v2/snapshot" -> exchange.reply(404)
+                "/api/sync/v2/deletions" -> {
+                    val json = exchange.requestBody.readAllBytes().decodeToString()
+                    check(json.contains("\\u001f"))
+                    exchange.reply(200, """{"acknowledged":1}""".encodeToByteArray())
+                }
+                "/api/sync/v2/merge" -> {
+                    check(exchange.requestHeaders.getFirst("Content-Encoding") == "gzip")
+                    check(exchange.requestHeaders.getFirst("X-Sync-Deleted-Categories") == "15")
+                    val decoded = SyncYomiWire.decode(GZIPInputStream(exchange.requestBody).readAllBytes())
+                    check(decoded.backupManga.single().version == 8L)
+                    exchange.responseHeaders.add("X-Sync-Changed", "true")
+                    exchange.reply(200, serialize(upload), etag = "seq=9", cursor = 9)
+                }
+                else -> exchange.reply(500)
+            }
+        }
+        try {
+            val transport = server.transport()
+            assertTrue(transport.inspect().supportsV2)
+            transport.deleteChapters(setOf(tombstone))
+            val merged = transport.merge(upload, cursor = 0, full = true, deletedCategoryUids = setOf(15))
+            assertEquals(9, merged.cursor)
+            assertEquals("/manga", merged.backup?.backupManga?.single()?.url)
+            assertFalse(merged.fullRequested)
+            assertEquals(3, requests.count { it == "/api/sync/content" })
+            assertEquals(3, requests.count { it == "/api/sync/v2/snapshot" })
+        } finally {
+            server.stop(0)
+        }
+    }
+
+    @Test
+    fun `reports unsupported and denies redirecting credentials`() = runBlocking {
+        var redirectsReceived = false
+        val receiver = start { exchange ->
+            redirectsReceived = true
+            exchange.reply(200, CAPABILITIES)
+        }
+        val redirects = start { exchange ->
+            exchange.responseHeaders.add("Location", "http://127.0.0.1:${receiver.address.port}/elsewhere")
+            exchange.reply(302)
+        }
+        val old = start { exchange -> exchange.reply(404) }
+        try {
+            assertFalse(old.transport().inspect().supportsV2)
+            val error = failureFrom { redirects.transport().inspect() }
+            assertEquals(302, error.status)
+            assertFalse(redirectsReceived)
+        } finally {
+            old.stop(0)
+            redirects.stop(0)
+            receiver.stop(0)
+        }
+    }
+
+    private suspend fun failureFrom(operation: suspend () -> Unit): SyncYomiFailure {
+        try {
+            operation()
+        } catch (failure: SyncYomiFailure) {
+            return failure
+        }
+        error("Expected a SyncYomi failure")
+    }
+
+    private fun start(handler: (HttpExchange) -> Unit): HttpServer = HttpServer.create(
+        InetSocketAddress("127.0.0.1", 0),
+        0,
+    ).apply {
+        createContext("/") { exchange -> exchange.use { handler(it) } }
+        start()
+    }
+
+    private fun HttpServer.transport() = MangaSyncTransport(
+        "http://127.0.0.1:${address.port}",
+        "isolated-test-token",
+        "test-device",
+    )
+
+    private fun HttpExchange.reply(
+        code: Int,
+        body: ByteArray = byteArrayOf(),
+        etag: String? = null,
+        cursor: Long? = null,
+    ) {
+        etag?.let { responseHeaders.add("ETag", it) }
+        cursor?.let { responseHeaders.add("X-Sync-Cursor", it.toString()) }
+        sendResponseHeaders(code, body.size.toLong().takeIf { it > 0 } ?: -1)
+        if (body.isNotEmpty()) responseBody.write(body)
+    }
+
+    private fun serialize(backup: Backup) = Buffer().apply { SyncYomiWire.writeTo(backup, this) }.readByteArray()
+
+    companion object {
+        private val CAPABILITIES = """{"version":2}""".encodeToByteArray()
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/sync/SyncYomiWireTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/sync/SyncYomiWireTest.kt
new file mode 100644
index 000000000..120d192e8
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/data/sync/SyncYomiWireTest.kt
@@ -0,0 +1,189 @@
+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.tachiyomi.data.backup.models.Backup
+import eu.kanade.tachiyomi.data.backup.models.BackupCategory
+import eu.kanade.tachiyomi.data.backup.models.BackupChapter
+import eu.kanade.tachiyomi.data.backup.models.BackupHistory
+import eu.kanade.tachiyomi.data.backup.models.BackupManga
+import eu.kanade.tachiyomi.data.backup.models.BackupPreference
+import eu.kanade.tachiyomi.data.backup.models.BackupSource
+import eu.kanade.tachiyomi.data.backup.models.BackupTracking
+import eu.kanade.tachiyomi.data.backup.models.StringPreferenceValue
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.SerializationException
+import kotlinx.serialization.protobuf.ProtoBuf
+import kotlinx.serialization.protobuf.ProtoNumber
+import okio.Buffer
+import okio.ByteString.Companion.toByteString
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertThrows
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class SyncYomiWireTest {
+    @Test
+    fun `reads Go proto3 fields omitted at zero`() {
+        val sparseWork = byteArrayOf(
+            0x12, 1, 0x77, // Work URL and no source ID.
+            0x82.toByte(), 1, 3, 0x0a, 1, 0x63, // Chapter URL and no chapter name.
+            0x92.toByte(), 1, 0, // Empty tracker record.
+            0xc2.toByte(), 6, 3, 0x0a, 1, 0x63, // History URL and no timestamp.
+        )
+        val bytes =
+            records(works = listOf(sparseWork), categories = listOf(byteArrayOf()), sources = listOf(byteArrayOf()))
+        val restored = SyncYomiWire.decode(bytes)
+        val manga = restored.backupManga.single()
+        assertEquals(0L, manga.source)
+        assertEquals("w", manga.url)
+        assertTrue(manga.favorite)
+        assertEquals("c", manga.chapters.single().url)
+        assertEquals("", manga.chapters.single().name)
+        assertEquals(BackupTracking(0, 0), manga.tracking.single())
+        assertEquals(BackupHistory("c", 0), manga.history.single())
+        assertEquals(BackupCategory(""), restored.backupCategories.single())
+        assertEquals(BackupSource("", 0), restored.backupSources.single())
+    }
+
+    @Test
+    fun `rejects native and adapted anime without confusing ordinary manga`() {
+        val manga =
+            records(works = listOf(ProtoBuf.encodeToByteArray(BackupManga.serializer(), BackupManga(20, "/manga"))))
+        val signature = ProtoBuf.encodeToByteArray(VideoSignature.serializer(), VideoSignature(0x414e4b32))
+        val legacyMarker = byteArrayOf(0xa0.toByte(), 0x1f, 0)
+        val nativeWork = byteArrayOf(0xaa.toByte(), 0x1f, 0)
+        val signedWork = records(works = listOf(signature))
+        val preSignatureVideo = records(works = listOf(byteArrayOf(0x82.toByte(), 1, 3, 0x80.toByte(), 1, 1)))
+
+        SyncYomiWire.verifyManga(manga)
+        SyncYomiWire.verifyManga(byteArrayOf())
+        SyncYomiWire.verifyManga(records(sources = listOf(byteArrayOf())))
+        for (foreign in listOf(
+            signature,
+            legacyMarker,
+            nativeWork,
+            byteArrayOf(0x1a, 0),
+            signedWork,
+            preSignatureVideo,
+        )) {
+            assertThrows(SyncYomiWire.OtherLibrary::class.java) { SyncYomiWire.verifyManga(foreign) }
+            assertThrows(SyncYomiWire.OtherLibrary::class.java) { SyncYomiWire.decode(manga + foreign) }
+        }
+        assertThrows(SerializationException::class.java) { SyncYomiWire.decode(byteArrayOf(0x0a, 7)) }
+    }
+
+    @Test
+    fun `serializes official revisions and preserves nested opaque records without uploading settings`() {
+        val opaque = ProtoBuf.encodeToByteArray(OpaqueField.serializer(), OpaqueField("keep this metadata"))
+        val inputChapter = BackupChapter(
+            "/chapter",
+            "Chapter",
+            lastPageRead = 9,
+            version = 4,
+            lastModifiedAt = 1_700_000_005,
+            progressModifiedAt = 1_700_000_005_000,
+            bookmarkModifiedAt = 0L,
+            syncSourceAddedAt = 1_700_000_001_000,
+        )
+        val inputHistory = BackupHistory(inputChapter.url, 1_700_000_000_000, 1200)
+        val inputTrack = BackupTracking(15, 0, mediaId = 950)
+        val inputCategory =
+            BackupCategory("Queue", 547, id = 81, version = 3, uid = 547, lastModifiedAt = 1_700_000_000, syncOrder = 0)
+        val inputSource = BackupSource("Fixture source", 874)
+        val inputWork = BackupManga(
+            inputSource.sourceId,
+            "/manga",
+            title = "Title",
+            genre = listOf("Mystery", "Drama"),
+            sourceUrl = "https://example.test/manga?q=1",
+            categories = listOf(inputCategory.order),
+            version = 6,
+            lastModifiedAt = 1_700_000_123,
+        )
+        val workBytes = ProtoBuf.encodeToByteArray(BackupManga.serializer(), inputWork) +
+            ProtoBuf.encodeToByteArray(
+                Children.serializer(),
+                Children(
+                    chapters = listOf(ProtoBuf.encodeToByteArray(BackupChapter.serializer(), inputChapter) + opaque),
+                    tracks = listOf(ProtoBuf.encodeToByteArray(BackupTracking.serializer(), inputTrack) + opaque),
+                    history = listOf(ProtoBuf.encodeToByteArray(BackupHistory.serializer(), inputHistory) + opaque),
+                ),
+            ) + opaque
+        val inspected = SyncYomiWire.read(
+            records(
+                works = listOf(workBytes),
+                categories = listOf(ProtoBuf.encodeToByteArray(BackupCategory.serializer(), inputCategory) + opaque),
+                sources = listOf(ProtoBuf.encodeToByteArray(BackupSource.serializer(), inputSource) + opaque),
+            ) + opaque,
+        )
+        val work = inspected.backup.backupManga.single()
+        val modified = inspected.backup.copy(
+            backupManga = listOf(work.copy(chapters = listOf(work.chapters.single().copy(lastPageRead = 23)))),
+            backupPreferences = listOf(BackupPreference("exclude_from_sync", StringPreferenceValue("settings"))),
+        )
+        val streamed = Buffer().apply { SyncYomiWire.writeTo(modified, this, inspected.extras) }.readByteArray()
+        val wireRows = ProtoBuf.decodeFromByteArray(RootRecords.serializer(), streamed)
+        val decoded = SyncYomiWire.read(streamed)
+        val restoredWork = decoded.backup.backupManga.single()
+        val extras = decoded.extras.works.values.single()
+        val expectedOpaque = opaque.toByteString()
+        assertEquals(expectedOpaque, extras.work)
+        assertEquals(expectedOpaque, extras.chapters[inputChapter.url])
+        assertEquals(expectedOpaque, extras.history[inputHistory.url])
+        assertEquals(expectedOpaque, extras.tracks[inputTrack.syncId])
+        assertEquals(expectedOpaque, decoded.extras.categories[inputCategory.uid])
+        assertEquals(expectedOpaque, decoded.extras.sources[inputSource.sourceId])
+        assertEquals(inputCategory, decoded.backup.backupCategories.single())
+        assertEquals(inputWork.version, restoredWork.version)
+        assertEquals(inputWork.lastModifiedAt, restoredWork.lastModifiedAt)
+        assertEquals(inputWork.sourceUrl, restoredWork.sourceUrl)
+        assertEquals(inputChapter.version, restoredWork.chapters.single().version)
+        assertEquals(inputChapter.progressModifiedAt, restoredWork.chapters.single().progressModifiedAt)
+        assertEquals(0L, restoredWork.chapters.single().bookmarkModifiedAt)
+        assertEquals(0L, restoredWork.chapters.single().syncSourceAddedAt)
+        assertEquals(23L, restoredWork.chapters.single().lastPageRead)
+        assertTrue(wireRows.prefs.isEmpty())
+        assertEquals(null, wireRows.opaqueRoot)
+    }
+
+    @Test
+    fun `normal file backups omit added optional fields`() {
+        val oldFileShape = ProtoBuf.encodeToByteArray(BackupManga.serializer(), BackupManga(1, "/manga"))
+        val metadata = ProtoBuf.decodeFromByteArray(WorkMetadata.serializer(), oldFileShape)
+        assertEquals(WorkMetadata(), metadata)
+    }
+
+    private fun records(
+        works: List<ByteArray> = emptyList(),
+        categories: List<ByteArray> = emptyList(),
+        sources: List<ByteArray> = emptyList(),
+    ) = ProtoBuf.encodeToByteArray(RootRecords.serializer(), RootRecords(works, categories, sources))
+
+    @Serializable
+    private data class RootRecords(
+        @ProtoNumber(1) val works: List<ByteArray> = emptyList(),
+        @ProtoNumber(2) val categories: List<ByteArray> = emptyList(),
+        @ProtoNumber(101) val sources: List<ByteArray> = emptyList(),
+        @ProtoNumber(104) val prefs: List<ByteArray> = emptyList(),
+        @ProtoNumber(840) val opaqueRoot: String? = null,
+    )
+
+    @Serializable
+    private data class Children(
+        @ProtoNumber(16) val chapters: List<ByteArray>,
+        @ProtoNumber(18) val tracks: List<ByteArray>,
+        @ProtoNumber(104) val history: List<ByteArray>,
+    )
+
+    @Serializable
+    private data class VideoSignature(@ProtoNumber(511) val signature: Long)
+
+    @Serializable
+    private data class OpaqueField(@ProtoNumber(840) val data: String)
+
+    @Serializable
+    private data class WorkMetadata(
+        @ProtoNumber(106) val lastModifiedAt: Long? = null,
+        @ProtoNumber(109) val version: Long? = null,
+        @ProtoNumber(900) val sourceUrl: String? = null,
+    )
+}
diff --git a/data/src/main/sqldelight/tachiyomi/data/manga_sync.sq b/data/src/main/sqldelight/tachiyomi/data/manga_sync.sq
new file mode 100644
index 000000000..0db269dad
--- /dev/null
+++ b/data/src/main/sqldelight/tachiyomi/data/manga_sync.sq
@@ -0,0 +1,361 @@
+-- Local edit times are stored separately from source content and upload revisions.
+-- The inbound marker is installed and removed within a single database transaction.
+CREATE TABLE manga_sync_inbound(
+    id INTEGER NOT NULL PRIMARY KEY CHECK(id = 1)
+);
+
+CREATE TABLE manga_sync_revision(
+    id INTEGER NOT NULL PRIMARY KEY CHECK(id = 1),
+    revision INTEGER NOT NULL
+);
+
+INSERT INTO manga_sync_revision(id, revision) VALUES (1, 0);
+
+CREATE TABLE manga_sync_work_stamp(
+    manga_id INTEGER NOT NULL PRIMARY KEY REFERENCES manga(id) ON DELETE CASCADE,
+    modified_at INTEGER NOT NULL
+);
+
+CREATE TABLE manga_sync_chapter_stamp(
+    chapter_id INTEGER NOT NULL PRIMARY KEY REFERENCES chapter(id) ON DELETE CASCADE,
+    modified_at INTEGER NOT NULL,
+    source_added_at INTEGER NOT NULL DEFAULT 0,
+    progress_modified_at INTEGER,
+    bookmark_modified_at INTEGER,
+    user_touched INTEGER NOT NULL
+);
+
+CREATE TABLE manga_sync_category_stamp(
+    category_id INTEGER NOT NULL PRIMARY KEY REFERENCES category(id) ON DELETE CASCADE,
+    modified_at INTEGER NOT NULL
+);
+
+CREATE TABLE manga_sync_unfavorite(
+    source_id INTEGER NOT NULL,
+    manga_url TEXT NOT NULL,
+    modified_at INTEGER NOT NULL,
+    PRIMARY KEY(source_id, manga_url)
+);
+
+CREATE TABLE manga_sync_chapter_deleted(
+    source_id INTEGER NOT NULL,
+    manga_url TEXT NOT NULL,
+    chapter_url TEXT NOT NULL,
+    deleted_at INTEGER NOT NULL,
+    PRIMARY KEY(source_id, manga_url, chapter_url)
+);
+
+CREATE TABLE manga_sync_category_deleted(
+    category_id INTEGER NOT NULL PRIMARY KEY,
+    deleted_at INTEGER NOT NULL
+);
+
+CREATE TRIGGER manga_sync_work_created
+AFTER INSERT ON manga
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound) AND (new.user_favorite_at IS NOT NULL OR length(new.user_notes) != 0 OR new.user_reader_flags != 0 OR new.user_chapter_flags != 0)
+BEGIN
+    INSERT INTO manga_sync_work_stamp(manga_id, modified_at)
+    VALUES (new.id, (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)))
+    ON CONFLICT(manga_id) DO UPDATE SET modified_at = excluded.modified_at;
+    DELETE FROM manga_sync_unfavorite
+    WHERE source_id = new.source_id AND manga_url = new.remote_url AND new.user_favorite_at IS NOT NULL;
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
+
+CREATE TRIGGER manga_sync_work_edited
+AFTER UPDATE OF user_favorite_at, user_notes, user_reader_flags, user_chapter_flags ON manga
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound) AND (new.user_favorite_at IS NOT old.user_favorite_at OR new.user_notes IS NOT old.user_notes OR new.user_reader_flags IS NOT old.user_reader_flags OR new.user_chapter_flags IS NOT old.user_chapter_flags)
+BEGIN
+    INSERT INTO manga_sync_work_stamp(manga_id, modified_at)
+    VALUES (new.id, (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)))
+    ON CONFLICT(manga_id) DO UPDATE SET modified_at = excluded.modified_at;
+    INSERT INTO manga_sync_unfavorite(source_id, manga_url, modified_at)
+    SELECT new.source_id, new.remote_url, (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER))
+    WHERE old.user_favorite_at IS NOT NULL AND new.user_favorite_at IS NULL
+    ON CONFLICT(source_id, manga_url) DO UPDATE SET modified_at = excluded.modified_at;
+    DELETE FROM manga_sync_unfavorite
+    WHERE source_id = new.source_id AND manga_url = new.remote_url AND new.user_favorite_at IS NOT NULL;
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
+
+-- Source refreshes can fill in missing library metadata without authoring a favorite change.
+CREATE TRIGGER manga_sync_source_refreshed
+AFTER UPDATE OF remote_title, remote_author, remote_artist, remote_description, remote_genre, remote_status, remote_cover, state_initialized ON manga
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound) AND new.user_favorite_at IS NOT NULL
+AND (
+    old.remote_title IS NOT new.remote_title OR
+    old.remote_author IS NOT new.remote_author OR
+    old.remote_artist IS NOT new.remote_artist OR
+    old.remote_description IS NOT new.remote_description OR
+    old.remote_genre IS NOT new.remote_genre OR
+    old.remote_status IS NOT new.remote_status OR
+    old.remote_cover IS NOT new.remote_cover OR
+    old.state_initialized IS NOT new.state_initialized
+)
+BEGIN
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
+
+CREATE TRIGGER manga_sync_chapter_created
+AFTER INSERT ON chapter
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound)
+BEGIN
+    INSERT INTO manga_sync_chapter_stamp(
+        chapter_id, modified_at, source_added_at, progress_modified_at, bookmark_modified_at, user_touched
+    ) VALUES (
+        new.id,
