+            version = 0,
+            dateFetch = 0,
+            memo = canonicalMemo(memo),
+            progressModifiedAt = null,
+            bookmarkModifiedAt = null,
+        )
+
+        fun canonicalMemo(bytes: ByteArray): ByteArray {
+            if (bytes.isEmpty()) return "{}".encodeToByteArray()
+            return try {
+                canonicalJson(Json.parseToJsonElement(bytes.decodeToString(throwOnInvalidSequence = true)))
+                    .toString().encodeToByteArray()
+            } catch (_: IllegalArgumentException) {
+                bytes
+            } catch (_: java.nio.charset.CharacterCodingException) {
+                bytes
+            }
+        }
+
+        fun canonicalJson(value: JsonElement): JsonElement = when (value) {
+            is JsonObject -> JsonObject(value.toSortedMap().mapValues { (_, element) -> canonicalJson(element) })
+            is JsonArray -> JsonArray(value.map(::canonicalJson))
+            else -> value
+        }
+
+        fun BackupChapter.authored(at: Long = lastModifiedAt) = copy(
+            lastModifiedAt = at / 1000L,
+            version = versionOf(at, version),
+            progressModifiedAt = progressModifiedAt ?: lastModifiedAt,
+            bookmarkModifiedAt = bookmarkModifiedAt ?: lastModifiedAt,
+        )
+
+        fun BackupChapter.withWireClocks(accepted: BackupChapter) = copy(
+            version = accepted.version,
+            progressModifiedAt = accepted.progressClock(),
+            bookmarkModifiedAt = accepted.bookmarkClock(),
+        )
+
+        fun BackupChapter.progressClock() = progressModifiedAt ?: editTime()
+        fun BackupChapter.bookmarkClock() = bookmarkModifiedAt ?: editTime()
+        fun BackupChapter.progress() = read to lastPageRead
+
+        fun BackupChapter.mergeReaderState(prior: BackupChapter?, remote: BackupChapter): BackupChapter? {
+            val localProgress = progress()
+            val priorProgress = prior?.progress()
+            val localProgressAt = progressModifiedAt ?: if (localProgress != priorProgress) lastModifiedAt else 0L
+            val localBookmarkAt = bookmarkModifiedAt ?: if (bookmark != prior?.bookmark) lastModifiedAt else 0L
+            val progress = mergeField(
+                localProgress,
+                localProgressAt,
+                priorProgress,
+                prior?.progressClock() ?: 0L,
+                remote.progress(),
+                remote.progressClock(),
+                remote.progressModifiedAt != null,
+            )
+            val bookmark = mergeField(
+                bookmark,
+                localBookmarkAt,
+                prior?.bookmark,
+                prior?.bookmarkClock() ?: 0L,
+                remote.bookmark,
+                remote.bookmarkClock(),
+                remote.bookmarkModifiedAt != null,
+            )
+            if (!progress.changed && !bookmark.changed) return null
+
+            // Only the transport revision advances past the server's whole-record revision.
+            // Neither field clock inherits a synthetic revision from an earlier composition.
+            val actualTime = maxOf(progress.at, bookmark.at, remote.editTime())
+            return remote.copy(
+                read = progress.value.first,
+                lastPageRead = progress.value.second,
+                bookmark = bookmark.value,
+                progressModifiedAt = progress.at,
+                bookmarkModifiedAt = bookmark.at,
+                lastModifiedAt = actualTime / 1000L,
+                version = maxOf(actualTime, increment(remote.version)),
+            )
+        }
+
+        data class FieldEdit<T>(val value: T, val at: Long, val changed: Boolean)
+
+        fun <T : Any> mergeField(
+            local: T,
+            localAt: Long,
+            prior: T?,
+            priorAt: Long,
+            remote: T,
+            remoteAt: Long,
+            remoteHasFieldClock: Boolean,
+        ): FieldEdit<T> {
+            val touched = localAt > 0L && (local != prior || localAt > priorAt)
+            val remoteUnchanged = prior != null && remote == prior && (!remoteHasFieldClock || remoteAt <= priorAt)
+            return if (touched && (localAt > remoteAt || remoteUnchanged) && (local != remote || localAt > remoteAt)) {
+                FieldEdit(local, localAt, true)
+            } else {
+                FieldEdit(remote, remoteAt, false)
+            }
+        }
+
+        fun BackupCategory.sameLocalCategory(other: BackupCategory) =
+            name == other.name && order == other.order && flags == other.flags
+
+        fun BackupCategory.identity() = if (uid == 0L) "name:$name" else "uid:$uid"
+
+        fun BackupCategory.wireOrder() = if (uid == 0L) {
+            ByteBuffer.wrap(digest(name)).long or Long.MIN_VALUE
+        } else {
+            uid
+        }
+
+        fun BackupChapter.editTime(): Long = if (progressModifiedAt == null && bookmarkModifiedAt == null) {
+            editTime(lastModifiedAt, version)
+        } else {
+            maxOf(editTime(lastModifiedAt, 0L), progressModifiedAt ?: 0L, bookmarkModifiedAt ?: 0L)
+        }
+        fun BackupCategory.editTime() = editTime(lastModifiedAt, version)
+        fun editTime(at: Long, version: Long): Long {
+            val time = when {
+                at <= 0 -> 0
+                at >= EARLIEST_MILLISECOND_REVISION -> at
+                else -> at * 1000
+            }
+            return if (version >= EARLIEST_MILLISECOND_REVISION) maxOf(time, version) else time
+        }
+
+        // SyncYomi compares version before modified-at. A real authoring timestamp used as the
+        // version keeps older offline changes from winning merely because they upload later.
+        fun versionOf(at: Long, fallback: Long) = if (at > 0) at else fallback.coerceAtLeast(0)
+
+        fun lowerThan(value: Long) = if (value == Long.MIN_VALUE) value else value - 1
+        fun increment(value: Long) = if (value == Long.MAX_VALUE) value else value + 1
+
+        fun acknowledgeWork(
+            base: BackupManga?,
+            remote: BackupManga,
+            actual: BackupManga,
+            nativeCategories: CategoryIndex,
+            remoteCategories: CategoryIndex,
+        ): BackupManga {
+            val serverCategories = nativeCategories.localOrders(remoteCategories.identities(remote.categories))
+            val metadata = when {
+                actual.sameMetadata(remote, nativeCategories, remoteCategories) -> actual
+                base != null -> base
+                else -> remote.copy(lastModifiedAt = 0, categories = serverCategories)
+            }
+            val baseChapters = base?.chapters.orEmpty().associateBy { it.url }
+            val remoteChapters = remote.chapters.associateBy { it.url }
+            val actualChapters = actual.chapters.associateBy { it.url }
+            val chapters = (baseChapters.keys + remoteChapters.keys).mapNotNull { url ->
+                val sent = baseChapters[url]
+                val received = remoteChapters[url]
+                val restored = actualChapters[url]
+                when {
+                    received == null && restored == null -> null
+                    received == null -> sent
+                    restored != null && restored.sameContent(received) -> restored.withWireClocks(received)
+                    sent != null -> sent.withWireClocks(received)
+                    else -> received.copy(lastModifiedAt = 0)
+                }
+            }
+            val history = base?.history.orEmpty().associateBy { it.url }.toMutableMap()
+            val actualHistory = actual.history.associateBy { it.url }
+            remote.history.filter { it == actualHistory[it.url] }.forEach { history[it.url] = it }
+            return metadata.copy(
+                version = remote.version,
+                userModifiedAt = remote.syncUserModifiedAt(),
+                chapters = chapters,
+                history = history.values.toList(),
+                tracking = remote.tracking,
+                sourceUrl = safeSourceUrl(metadata.sourceUrl, remote.sourceUrl),
+            )
+        }
+
+        fun acknowledgeCategories(
+            sent: List<BackupCategory>,
+            remote: List<BackupCategory>,
+            actual: List<BackupCategory>,
+        ): List<BackupCategory> {
+            val remoteIndex = CategoryIndex(remote)
+            val actualById = actual.associateBy { it.id }
+            val preflight = sent.associateBy { it.id }
+            val restored = actual.mapNotNull { category ->
+                val original = preflight[category.id]
+                val incoming = remoteIndex.match(category)
+                when {
+                    incoming == null -> original
+                    category.name == incoming.name && category.flags == incoming.flags &&
+                        category.order == (incoming.syncOrder ?: category.order) ->
+                        category.copy(uid = incoming.uid, version = incoming.version, syncOrder = null)
+                    original != null -> original.copy(uid = incoming.uid, version = incoming.version)
+                    else -> category.copy(uid = incoming.uid, version = incoming.version, syncOrder = null)
+                }
+            }
+            return (
+                restored + sent.filter {
+                    it.id !in actualById && remoteIndex.match(it) != null
+                }
+                ).sortedBy { it.order }
+        }
+
+        fun safeSourceUrl(vararg urls: String?) = urls.firstNotNullOfOrNull { it?.let(::publicMangaSourceUrl) }
+
+        fun <T> DataInputStream.readRecord(serializer: KSerializer<T>): T {
+            val length = readInt()
+            check(length in 0..MAX_RECORD_BYTES) { "Invalid manga sync checkpoint record" }
+            val bytes = ByteArray(length)
+            readFully(bytes)
+            return ProtoBuf.decodeFromByteArray(serializer, bytes)
+        }
+
+        fun <T> DataOutputStream.writeRecord(serializer: KSerializer<T>, value: T) {
+            val bytes = ProtoBuf.encodeToByteArray(serializer, value)
+            check(bytes.size <= MAX_RECORD_BYTES) { "Manga sync checkpoint record is too large" }
+            writeInt(bytes.size)
+            write(bytes)
+        }
+
+        fun digest(vararg parts: String): ByteArray {
+            val hash = MessageDigest.getInstance("SHA-256")
+            parts.forEach { part ->
+                val bytes = part.encodeToByteArray()
+                hash.update(ByteBuffer.allocate(Int.SIZE_BYTES).putInt(bytes.size).array())
+                hash.update(bytes)
+            }
+            return hash.digest()
+        }
+    }
+}
