+updateWork:
+UPDATE manga SET
+    remote_title = :title,
+    remote_author = :author,
+    remote_artist = :artist,
+    remote_description = :description,
+    remote_genre = :genre,
+    remote_status = :status,
+    remote_cover = :cover,
+    remote_update_strategy = :updateStrategy,
+    remote_memo = :memo,
+    user_favorite_at = :favoriteAt,
+    user_notes = :notes,
+    user_reader_flags = :readerFlags,
+    user_chapter_flags = :chapterFlags,
+    state_cover_last_modified = :coverLastModified,
+    state_initialized = :initialized
