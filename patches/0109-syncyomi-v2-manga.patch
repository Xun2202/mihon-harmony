+    fun save(state: State) {
+        val directory = Files.createDirectories(checkNotNull(file.parentFile).toPath())
+        val staged = directory.resolve("${file.name}.new")
+        try {
+            DataOutputStream(GZIPOutputStream(Files.newOutputStream(staged))).use { output ->
+                output.writeInt(FORMAT)
+                output.writeLong(state.cursor)
+                output.writeBoolean(state.fullRequested)
+                output.writeLong(state.lastFullAt)
+                val backup = state.snapshot.libraryOnly()
+                output.writeRecord(Backup.serializer(), backup.copy(backupManga = emptyList()))
+                output.writeInt(backup.backupManga.size)
+                backup.backupManga.forEach { output.writeRecord(BackupManga.serializer(), it) }
+            }
