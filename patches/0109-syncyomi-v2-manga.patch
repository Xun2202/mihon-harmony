+            val progress = if (incomingProgress) remote.progress() else requireNotNull(before).progress()
+            val bookmark = if (incomingBookmark) remote.bookmark else requireNotNull(before).bookmark
+            val chapter = details.copy(read = progress.first, lastPageRead = progress.second, bookmark = bookmark)
