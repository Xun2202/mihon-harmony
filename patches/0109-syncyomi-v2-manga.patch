+
+    private suspend fun getWork(entry: BackupManga): Manga? = database.mangaQueries
+        .getMangaByUrlAndSource(entry.source, entry.url, MangaMapper::mapManga).awaitAsOneOrNull()
+
+    private suspend fun backupWorks(works: List<Manga>): List<BackupManga> {
+        val keys = works.associate { (it.source to it.url) to it.id }
+        val ids = works.map { it.id }.chunked(500)
+        val modified = ids.flatMap { database.manga_syncQueries.workStamps(it).awaitAsList() }
+            .associate { it.manga_id to it.modified_at }
+        val chapterModified = ids.flatMap { database.manga_syncQueries.chapterStamps(it).awaitAsList() }
+            .associateBy { it.manga_id to it.remote_url }
