+    }
+
+    suspend fun deletions(): Deletions = database.transactionWithResult {
+        Deletions(
+            chapters = database.manga_syncQueries.chapterDeletions().awaitAsList().associate {
+                "${it.source_id}|${it.manga_url}\u001f${it.chapter_url}" to it.deleted_at
