+                        scanlator = chapter.scanlator,
+                        number = chapter.chapterNumber,
+                        dateUpload = chapter.dateUpload,
+                        sourceOrder = chapter.sourceOrder,
+                        memo = chapter.memo,
+                        read = chapter.read,
+                        bookmark = chapter.bookmark,
+                        page = chapter.lastPageRead,
+                        chapterId = row.id,
+                    )
+                    if (before != null && (before.name != chapter.name || before.scanlator != chapter.scanlator) &&
+                        hasDownloaded(beforeManga, before)
+                    ) {
+                        renames +=
+                            Triple(
+                                manga,
+                                before.copy(id = row.id, mangaId = manga.id),
+                                chapter.copy(id = row.id, mangaId = manga.id),
+                            )
+                    }
+                }
+                row.id
+            }
+            val progressAt = if (incomingProgress) entry.progressModifiedAt else present?.progressModifiedAt
+            val bookmarkAt = if (incomingBookmark) entry.bookmarkModifiedAt else present?.bookmarkModifiedAt
+            val remoteTime = syncMillis(entry.lastModifiedAt, entry.version)
+            val localTime = present?.lastModifiedAt ?: 0
+            val time = maxOf(
+                progressAt ?: if (incomingProgress) remoteTime else localTime,
+                bookmarkAt ?: if (incomingBookmark) remoteTime else localTime,
+            )
+            if (present == null || time != present.lastModifiedAt || progressAt != present.progressModifiedAt ||
+                bookmarkAt != present.bookmarkModifiedAt
+            ) {
+                database.manga_syncQueries.restoreChapterStamp(chapterId, time, progressAt, bookmarkAt)
+            }
+            database.manga_syncQueries.clearChapterDeletion(manga.source, manga.url, entry.url)
+        }
+    }
+
+    private fun hasDownloaded(manga: Manga, chapter: Chapter): Boolean = downloadManager.isChapterDownloaded(
+        chapterName = chapter.name,
+        chapterScanlator = chapter.scanlator,
+        chapterUrl = chapter.url,
+        mangaTitle = manga.title,
+        sourceId = manga.source,
+    )
+
+    private suspend fun applyHistory(mangaId: Long, entry: BackupManga, current: BackupManga?, sent: BackupManga?) {
+        if (entry.history.isEmpty()) return
+        val chapters = database.chapterQueries.getChaptersByMangaId(mangaId, applyScanlatorFilter = 0)
+            .awaitAsList().associate { it.remote_url to it.id }
+        val localHistory = current?.history.orEmpty().associateBy { it.url }
+        val capturedHistory = sent?.history.orEmpty().associateBy { it.url }
+        entry.history.forEach { backup ->
+            val chapterId = chapters[backup.url] ?: return@forEach
+            val local = localHistory[backup.url]
+            if (local != null && local != capturedHistory[backup.url] && local.lastRead >= backup.lastRead) {
+                return@forEach
+            }
+            val item = backup.getHistoryImpl()
+            database.manga_syncQueries.restoreHistory(mangaId, chapterId, item.readAt, item.readDuration)
+        }
+    }
+
+    private suspend fun applyTracking(
+        mangaId: Long,
+        incoming: BackupManga,
+        current: BackupManga?,
+        sent: BackupManga?,
+        prior: BackupManga?,
+    ) {
+        val existing = current?.tracking.orEmpty().associateBy { it.syncId }
+        val uploaded = sent?.tracking.orEmpty().associateBy { it.syncId }
+        val remoteIds = incoming.tracking.mapTo(mutableSetOf()) { it.syncId }
+        prior?.tracking.orEmpty().forEach {
+            if (it.syncId !in remoteIds && existing[it.syncId] == it && uploaded[it.syncId] == it) {
+                database.manga_trackQueries.delete(mangaId, it.syncId.toLong())
+            }
+        }
+        incoming.tracking.forEach { entry ->
+            val old = existing[entry.syncId]
+            requireUnchanged(old, uploaded[entry.syncId], entry, sent != null)
+            if (old == entry) return@forEach
+            val track = entry.getTrackImpl()
+            database.manga_trackQueries.upsert(
+                mangaId, track.trackerId, track.remoteId, track.remoteUrl, track.libraryId, track.title,
+                track.lastChapterRead, track.totalChapters, track.status, track.score, track.startDate,
+                track.finishDate, track.private,
+            )
+        }
+    }
+
+    private suspend fun applyScanlators(
+        mangaId: Long,
+        incoming: BackupManga,
+        current: BackupManga?,
+        sent: BackupManga?,
+    ) {
+        val local = current?.excludedScanlators.orEmpty().toSet()
+        val remote = incoming.excludedScanlators.toSet()
+        requireUnchanged(local, sent?.excludedScanlators?.toSet(), remote, sent != null)
+        val removed = local - remote
+        if (removed.isNotEmpty()) database.excluded_scanlatorQueries.remove(mangaId, removed)
+        (remote - local).forEach { database.excluded_scanlatorQueries.insert(mangaId, it) }
+    }
+
+    private data class Categories(val idsByWireOrder: Map<Long, Long>, val rows: List<BackupCategory>)
+
+    private suspend fun applyCategories(
+        remote: List<BackupCategory>,
+        captured: Backup,
+        baseline: Backup?,
+        current: List<BackupCategory>,
+    ): Categories {
+        val sentById = captured.backupCategories.associateBy { it.id }
+        val previousById = baseline?.backupCategories.orEmpty().associateBy { it.id }
+        val knownIds = (previousById + sentById).values.filter { it.uid != 0L }.associate { it.uid to it.id }
+        val currentById = current.associateBy { it.id }
+        val currentByName = current.associateBy { it.name }
+        val remoteUids = remote.map { it.uid }.toSet()
+        val remoteNames = remote.map { it.name }.toSet()
+        val capturedMemberships = captured.backupManga.flatMap { work -> work.categories.map { it to work.key() } }
+            .groupBy({ it.first }, { it.second }).mapValues { it.value.toSet() }
+        val removed = current.filter { row ->
+            val prior = previousById[row.id]
+            prior != null && prior.uid !in remoteUids && row.name !in remoteNames &&
+                row.body() == prior.body() && row.body() == sentById[row.id]?.body() &&
+                database.manga_syncQueries.assignedWorks(row.id).awaitAsList().all {
+                    (it.source_id to it.remote_url) in capturedMemberships[row.order].orEmpty()
+                }
+        }.mapTo(mutableSetOf()) { it.id }
+        removed.forEach { database.categoryQueries.delete(it) }
+        val sentByName = captured.backupCategories.associateBy { it.name }
+        val matched = linkedMapOf<Long, Pair<BackupCategory, BackupCategory>>()
+        for (incoming in remote) {
+            val knownId = knownIds[incoming.uid] ?: sentByName[incoming.name]?.id
+            val found = knownId?.let(currentById::get) ?: currentByName[incoming.name]
+            if (found == null &&
+                knownId in sentById
+            ) {
+                throw SyncYomiFailure(SyncYomiProblem.STALE)
+            }
+            val local = if (found == null) {
+                val id = database.manga_syncQueries.insertCategory(incoming.name, incoming.flags).awaitAsOne()
+                val order = database.categoryQueries.getCategory(id).awaitAsOne().order
+                incoming.copy(id = id, order = order, syncOrder = null)
+            } else {
+                requireUnchanged(
+                    found.name to found.flags,
+                    sentById[found.id]?.let { it.name to it.flags },
+                    incoming.name to incoming.flags,
+                    true,
+                )
+                if (found.name != incoming.name) database.categoryQueries.updateName(incoming.name, found.id)
+                if (found.flags != incoming.flags) database.categoryQueries.updateFlags(incoming.flags, found.id)
+                incoming.copy(id = found.id, order = found.order, syncOrder = null)
+            }
+            check(matched.put(local.id, incoming to local) == null) { "SyncYomi sent duplicate category identities" }
+        }
+        val localOnly = current.filter { it.id !in removed && it.id !in matched }.map { row ->
+            val known = sentById[row.id] ?: previousById[row.id]
+            if (known == null) row else row.copy(uid = known.uid, version = known.version)
+        }
+        val result = arrangeMangaSyncCategories(matched.values, localOnly)
+        val reorder = result.rows.filter { matched[it.id]?.second?.order?.let { before -> before != it.order } == true }
+        reorder.forEachIndexed { i, category ->
+            val observed = currentById[category.id]
+            requireUnchanged(
+                observed?.order,
+                sentById[category.id]?.order,
+                category.order,
+                observed != null,
+            )
+            database.categoryQueries.updateOrder(-i - 2L, category.id)
+        }
+        reorder.forEach { database.categoryQueries.updateOrder(it.order, it.id) }
+        result.rows.forEach { row ->
+            val incoming = matched[row.id]?.first ?: return@forEach
+            val modified = syncMillis(incoming.lastModifiedAt, incoming.version)
+            if (modified !=
+                currentById[row.id]?.lastModifiedAt
+            ) {
+                database.manga_syncQueries.restoreCategoryStamp(row.id, modified)
+            }
+        }
+        return Categories(result.idsByWireOrder, result.rows)
+    }
+
+    private fun BackupCategory.body() = Triple(name, order, flags)
+
+    private fun BackupManga.details() = getMangaImpl().copy(nextUpdate = null)
+
+    private fun <T> requireUnchanged(current: T?, sent: T?, remote: T?, compare: Boolean) {
+        if (compare && current != sent &&
+            current != remote
+        ) {
+            throw SyncYomiFailure(SyncYomiProblem.STALE)
+        }
+    }
+}
+
+private fun BackupManga.key() = source to url
+
+private fun Chapter.metadata() = copy(
+    dateFetch = Chapter.create().dateFetch,
+    read = false,
+    lastPageRead = 0,
+    bookmark = false,
+)
+
+private fun Chapter.progress() = read to lastPageRead
+
+/** A change made after the request stays pending if the response did not change that field. */
+internal fun <T> incomingChapterFieldWins(current: T?, captured: T?, incoming: T, guard: Boolean): Boolean {
+    if (!guard || current == captured) return true
+    if (current == incoming || captured == incoming) return false
+    throw SyncYomiFailure(SyncYomiProblem.STALE)
+}
+
+internal fun syncMillis(timestamp: Long, version: Long): Long = when {
+    timestamp >= 100_000_000_000L -> timestamp
+    timestamp > 0 -> (timestamp * 1_000).let { ms -> version.takeIf { it in ms..(ms + 999) } ?: ms }
+    version >= 100_000_000_000L -> version
+    else -> 0L
+}
