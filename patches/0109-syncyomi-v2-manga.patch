+package eu.kanade.tachiyomi.data.sync
+
+import android.content.Context
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import okio.ByteString.Companion.encodeUtf8
+import tachiyomi.domain.source.service.SourceManager
+
+@Inject
+@SingleIn(AppScope::class)
+class MangaSyncService(
+    private val context: Context,
+    private val settings: MangaSyncSettings,
+    private val library: MangaSyncLibrary,
+    private val sourceManager: SourceManager,
+) {
+    private val mutex = Mutex()
+    private var transportAccount: String? = null
+    private var cachedTransport: MangaSyncTransport? = null
+
+    suspend fun sync(host: String, key: String, deviceId: String) = mutex.withLock {
+        fun currentConnection() = settings.isCurrentConnection(host, key, deviceId)
+        if (!currentConnection()) return@withLock
+        val account = listOf(host, key, deviceId).joinToString("\u0000").encodeUtf8().sha256().hex()
+        val transport =
+            cachedTransport.takeIf { account == transportAccount } ?: MangaSyncTransport(host, key, deviceId).also {
+                transportAccount = account
+                cachedTransport = it
+            }
+        val inspection = transport.inspect()
+        if (!inspection.supportsV2) throw SyncYomiFailure(SyncYomiProblem.UNSUPPORTED)
+        val checkpoint = MangaSyncCheckpoint(context, host, key, deviceId)
+        val saved = checkpoint.load()
+        val rewound = saved != null && saved.cursor > inspection.cursor
+        val state = if (rewound) saved.copy(fullRequested = true) else saved
+        val local = library.snapshot(state?.snapshot).withMangaSourceUrls(sourceManager, state?.snapshot)
+        val deletions = if (state != null && !rewound) library.deletions() else null
+        val plan = checkpoint.plan(
+            local = local,
+            old = state,
+            now = System.currentTimeMillis(),
+            existingRemote = inspection.backup,
+            explicitlyDeletedChapters = deletions?.chapters.orEmpty(),
+            explicitlyDeletedCategoryIds = deletions?.categoryIds.orEmpty(),
+        )
+        if (!currentConnection()) return@withLock
+        transport.deleteChapters(plan.deletedChapters)
+        if (!currentConnection()) return@withLock
+        val merged = transport.merge(plan.upload, state?.cursor ?: 0L, plan.full, plan.deletedCategoryUids)
+        if (!currentConnection()) return@withLock
+        val applied = merged.backup?.let { remote -> library.apply(remote, plan.local, state?.snapshot) }
+        // A failed or cancelled restore must receive the same changes again on retry.
+        checkpoint.save(plan.acknowledge(merged.cursor, merged.fullRequested, merged.backup, applied))
+    }
+}
