+
+@Composable
+internal fun syncYomiPreferences(): Preference.PreferenceGroup {
+    val context = LocalContext.current
+    val settings = remember(context) { context.appGraph.mangaSyncSettings }
+    val revision by settings.revision.collectAsState()
+    val connection = remember(revision) { settings.summary() }
+    val lastIssue by settings.lastIssue.collectAsState()
+    val lastSuccessAt by settings.lastSuccessAt.collectAsState()
+    val work = if (connection.configured) {
+        val infos by remember(context, revision) {
+            context.workManager.getWorkInfosByTagFlow(MangaSyncWorker.configurationTag(revision))
+        }.collectAsStateWithLifecycle(initialValue = emptyList())
+        infos
+    } else {
+        emptyList()
+    }
+    val running = work.any { it.state == WorkInfo.State.RUNNING }
+    val manualPending = work.any { MangaSyncWorker.TAG_MANUAL in it.tags && !it.state.isFinished }
+    val pending = work.any { MangaSyncWorker.TAG_PERIODIC !in it.tags && !it.state.isFinished }
+
+    var showDialog by remember { mutableStateOf(false) }
+    if (showDialog) {
+        SyncYomiConnectionDialog(
+            connection = connection,
+            onSave = settings::setConnection,
+            onRemove = settings::clearConnection,
+            onDismiss = { showDialog = false },
+        )
+    }
+
+    val issue = lastIssue
+    val status = when {
+        running -> stringResource(MR.strings.syncyomi_running)
+        issue != null -> issue.message()
+        pending -> stringResource(MR.strings.syncyomi_pending)
+        lastSuccessAt > 0 -> null
+        else -> stringResource(MR.strings.syncyomi_ready)
+    }
+    val lastSuccess = if (lastSuccessAt > 0) {
+        stringResource(MR.strings.syncyomi_last_success, relativeTimeSpanString(lastSuccessAt))
+    } else {
+        null
+    }
+
+    return Preference.PreferenceGroup(
+        title = stringResource(MR.strings.syncyomi_title),
+        preferenceItems = buildList {
+            add(
+                Preference.PreferenceItem.TextPreference(
+                    title = stringResource(MR.strings.syncyomi_connection),
+                    subtitle = connection.host.ifBlank { stringResource(MR.strings.syncyomi_connection_unset) },
+                    onClick = { showDialog = true },
+                ),
+            )
+            add(
+                Preference.PreferenceItem.TextPreference(
+                    title = stringResource(MR.strings.syncyomi_sync_now),
+                    visible = connection.configured,
+                    onClick = if (!running && !manualPending) {
+                        { MangaSyncWorker.startNow(context, connection.revision) }
+                    } else {
+                        null
+                    },
+                ),
+            )
+            if (connection.configured && status != null) add(Preference.PreferenceItem.InfoPreference(status))
+            if (connection.configured && lastSuccess != null) add(Preference.PreferenceItem.InfoPreference(lastSuccess))
+            add(
+                Preference.PreferenceItem.ListPreference(
+                    preference = settings.periodicHours,
+                    entries = mapOf(
+                        0 to stringResource(MR.strings.off),
+                        1 to stringResource(MR.strings.syncyomi_interval_hour),
+                        6 to stringResource(MR.strings.update_6hour),
+                        12 to stringResource(MR.strings.update_12hour),
+                        24 to stringResource(MR.strings.update_24hour),
+                    ),
+                    title = stringResource(MR.strings.syncyomi_interval),
+                    visible = connection.configured,
+                ),
+            )
+            add(
+                Preference.PreferenceItem.SwitchPreference(
+                    preference = settings.syncOnChange,
+                    title = stringResource(MR.strings.syncyomi_change_sync),
+                    visible = connection.configured,
+                ),
+            )
+        },
+    )
+}
+
+@Composable
+private fun SyncYomiConnectionDialog(
+    connection: MangaSyncSettings.Summary,
+    onSave: (host: String, key: String) -> Boolean,
+    onRemove: () -> Unit,
+    onDismiss: () -> Unit,
+) {
+    val host = remember { TextFieldState(connection.host) }
+    val apiKey = remember { TextFieldState() }
+    var error by remember { mutableStateOf<ConnectionError?>(null) }
+
+    AlertDialog(
+        onDismissRequest = onDismiss,
+        title = { Text(stringResource(MR.strings.syncyomi_connection)) },
+        text = {
+            Column(
+                modifier = Modifier.verticalScroll(rememberScrollState()),
+                verticalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                OutlinedTextField(
+                    state = host,
+                    modifier = Modifier.fillMaxWidth(),
+                    label = { Text(stringResource(MR.strings.syncyomi_endpoint)) },
+                    lineLimits = TextFieldLineLimits.SingleLine,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Uri, imeAction = ImeAction.Next),
+                    isError = error == ConnectionError.Address,
+                    supportingText = {
+                        val message = if (error == ConnectionError.Address) {
+                            MR.strings.syncyomi_error_address
+                        } else {
+                            MR.strings.syncyomi_connection_help
+                        }
+                        Text(stringResource(message))
+                    },
+                )
+                OutlinedSecureTextField(
+                    state = apiKey,
+                    modifier = Modifier.fillMaxWidth(),
+                    label = { Text(stringResource(MR.strings.syncyomi_api_key)) },
+                    textObfuscationMode = TextObfuscationMode.Hidden,
+                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Password, imeAction = ImeAction.Done),
+                    isError = error == ConnectionError.MissingKey || error == ConnectionError.InvalidKey,
+                    supportingText = {
+                        val message = when {
+                            error == ConnectionError.MissingKey -> MR.strings.syncyomi_key_required
+                            error == ConnectionError.InvalidKey -> MR.strings.syncyomi_invalid_key
+                            connection.keyConfigured -> MR.strings.syncyomi_keep_key
+                            else -> null
+                        }
+                        if (message != null) Text(stringResource(message))
+                    },
+                )
+            }
+        },
+        confirmButton = {
+            TextButton(
+                enabled = host.text.isNotBlank(),
+                onClick = {
+                    val address = normalizeSyncYomiHost(host.text.toString())?.toString()
+                    val key = apiKey.text.toString().trim()
+                    val keepsCurrentKey = connection.keyConfigured && address == connection.host
+                    error = when {
+                        address == null -> ConnectionError.Address
+                        key.isEmpty() && !keepsCurrentKey -> ConnectionError.MissingKey
+                        !onSave(address, key) -> ConnectionError.InvalidKey
+                        else -> null
+                    }
+                    if (error == null) onDismiss()
+                },
+            ) {
+                Text(stringResource(MR.strings.action_save))
+            }
+        },
+        dismissButton = {
+            Row {
+                if (connection.configured) {
+                    TextButton(onClick = {
+                        onRemove()
+                        onDismiss()
+                    }) {
+                        Text(stringResource(MR.strings.syncyomi_remove_connection))
+                    }
+                }
+                TextButton(onClick = onDismiss) {
+                    Text(stringResource(MR.strings.action_cancel))
+                }
+            }
+        },
+    )
+}
+
+private enum class ConnectionError { Address, MissingKey, InvalidKey }
+
+@Composable
+private fun MangaSyncIssue.message(): String = when (error) {
+    MangaSyncError.ADDRESS -> stringResource(MR.strings.syncyomi_error_address)
+    MangaSyncError.CLEARTEXT -> stringResource(MR.strings.syncyomi_error_cleartext)
+    MangaSyncError.AUTH -> stringResource(MR.strings.syncyomi_error_auth)
+    MangaSyncError.RESPONSE -> stringResource(MR.strings.syncyomi_error_response)
+    MangaSyncError.HTTP -> stringResource(MR.strings.syncyomi_error_http, httpStatus)
+    MangaSyncError.OTHER_LIBRARY -> stringResource(MR.strings.syncyomi_error_other_library)
+    MangaSyncError.UNSUPPORTED -> stringResource(MR.strings.syncyomi_error_unsupported)
+    MangaSyncError.STALE -> stringResource(MR.strings.syncyomi_error_stale)
+    MangaSyncError.CERTIFICATE -> stringResource(MR.strings.syncyomi_error_certificate)
+    MangaSyncError.NETWORK -> stringResource(MR.strings.syncyomi_error_network)
+    MangaSyncError.GENERAL -> stringResource(MR.strings.syncyomi_error_general)
+}
