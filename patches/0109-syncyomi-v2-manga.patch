+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound) AND (new.user_read IS NOT old.user_read OR new.user_bookmark IS NOT old.user_bookmark OR new.user_last_page_read IS NOT old.user_last_page_read)
