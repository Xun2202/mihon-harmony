+    VALUES (old.id, (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)))
+    ON CONFLICT(category_id) DO UPDATE SET deleted_at = excluded.deleted_at;
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
+
+CREATE TRIGGER manga_sync_membership_insert
+AFTER INSERT ON manga_category
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound) AND (EXISTS (SELECT 1 FROM manga WHERE id = new.manga_id))
+BEGIN
+    INSERT INTO manga_sync_work_stamp(manga_id, modified_at)
+    SELECT id, (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)) FROM manga WHERE id = new.manga_id
+    ON CONFLICT(manga_id) DO UPDATE SET modified_at = excluded.modified_at;
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
+
+CREATE TRIGGER manga_sync_membership_delete
+AFTER DELETE ON manga_category
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound) AND (EXISTS (SELECT 1 FROM manga WHERE id = old.manga_id))
+BEGIN
+    INSERT INTO manga_sync_work_stamp(manga_id, modified_at)
+    SELECT id, (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)) FROM manga WHERE id = old.manga_id
+    ON CONFLICT(manga_id) DO UPDATE SET modified_at = excluded.modified_at;
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
+
+CREATE TRIGGER manga_sync_history_created
+AFTER INSERT ON history
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound) AND (new.read_at IS NOT NULL)
+BEGIN
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
+
+CREATE TRIGGER manga_sync_history_edited
+AFTER UPDATE OF read_at, read_duration ON history
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound) AND (new.read_at IS NOT old.read_at OR new.read_duration IS NOT old.read_duration)
+BEGIN
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
+
+CREATE TRIGGER manga_sync_history_removed
+AFTER DELETE ON history
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound) AND (old.read_at IS NOT NULL AND EXISTS (SELECT 1 FROM chapter WHERE id = old.chapter_id))
+BEGIN
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
+
+CREATE TRIGGER manga_sync_scanlator_created
+AFTER INSERT ON excluded_scanlator
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound)
+BEGIN
+    INSERT INTO manga_sync_work_stamp(manga_id, modified_at)
+    VALUES (new.manga_id, (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)))
+    ON CONFLICT(manga_id) DO UPDATE SET modified_at = excluded.modified_at;
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
+
+CREATE TRIGGER manga_sync_scanlator_removed
+AFTER DELETE ON excluded_scanlator
+WHEN NOT EXISTS (SELECT 1 FROM manga_sync_inbound) AND (EXISTS (SELECT 1 FROM manga WHERE id = old.manga_id))
+BEGIN
+    INSERT INTO manga_sync_work_stamp(manga_id, modified_at)
+    SELECT id, (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)) FROM manga WHERE id = old.manga_id
+    ON CONFLICT(manga_id) DO UPDATE SET modified_at = excluded.modified_at;
+    UPDATE manga_sync_revision SET revision = revision + 1 WHERE id = 1;
+END;
