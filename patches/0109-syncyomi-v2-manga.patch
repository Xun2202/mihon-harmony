+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.tachiyomi.data.backup.models.Backup
+import eu.kanade.tachiyomi.network.await
+import kotlinx.serialization.SerializationException
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.intOrNull
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody
+import okhttp3.RequestBody.Companion.toRequestBody
+import okhttp3.Response
+import okio.Buffer
+import okio.BufferedSink
+import okio.GzipSink
+import okio.GzipSource
+import okio.buffer
+import java.io.IOException
+import java.net.InetAddress
+import java.net.Proxy
+import java.util.concurrent.TimeUnit
+
+internal enum class SyncYomiProblem { ADDRESS, CLEARTEXT, AUTH, RESPONSE, HTTP, OTHER_LIBRARY, UNSUPPORTED, STALE }
+
+internal class SyncYomiFailure(val problem: SyncYomiProblem, val status: Int = 0) : IOException(problem.name) {
+    val isTransient get() = problem == SyncYomiProblem.STALE ||
+        (problem == SyncYomiProblem.HTTP && (status == 408 || status == 429 || status in 500..599))
+}
+
+internal fun normalizeSyncYomiHost(host: String): HttpUrl? = host.trim().trimEnd('/').toHttpUrlOrNull()?.takeIf {
+    it.username.isEmpty() && it.password.isEmpty() && it.query == null && it.fragment == null
+}
+
+internal class MangaSyncTransport(host: String, key: String, private val device: String) {
+    private val base = normalizeSyncYomiHost(host) ?: throw SyncYomiFailure(SyncYomiProblem.ADDRESS)
+    private val token = key.trim().takeIf { it.isNotEmpty() && it.all { character -> character in '!'..'~' } }
+        ?: throw SyncYomiFailure(SyncYomiProblem.AUTH)
+    private val client = OkHttpClient.Builder()
+        .followRedirects(false)
+        .followSslRedirects(false)
+        .retryOnConnectionFailure(false)
+        .connectTimeout(30, TimeUnit.SECONDS)
+        .readTimeout(120, TimeUnit.SECONDS)
+        .writeTimeout(120, TimeUnit.SECONDS)
+        .apply {
+            if (!base.isHttps) {
+                proxy(Proxy.NO_PROXY)
+                addNetworkInterceptor { chain ->
+                    val ip = chain.connection()?.socket()?.inetAddress
+                    if (ip == null || !ip.allowsCleartextSync()) throw SyncYomiFailure(SyncYomiProblem.CLEARTEXT)
+                    chain.proceed(chain.request())
+                }
+            }
+        }
+        .build()
+
+    private data class Rendered(val cursor: Long, val etag: String, val content: SyncYomiWire.Content)
+
+    data class Inspection(val backup: Backup, val cursor: Long, val supportsV2: Boolean)
+
+    data class Merged(val backup: Backup?, val cursor: Long, val fullRequested: Boolean)
+
+    private var rawEtag: String? = null
+    private var rendered: Rendered? = null
+    private var supportsV2 = false
+    private var inspectedCursor: Long? = null
+
+    suspend fun inspect(): Inspection {
+        inspectedCursor = null
+        supportsV2 = send(request("v2/capabilities")).use { response ->
+            if (response.code == 404) return@use false
+            response.requireOk()
+            val capabilities = parseObject(response.body.string())
+            if ((capabilities["version"] as? JsonPrimitive)?.intOrNull != 2) {
+                throw SyncYomiFailure(SyncYomiProblem.UNSUPPORTED)
+            }
+            true
+        }
+        if (!supportsV2) return Inspection(Backup(), 0, supportsV2 = false)
+        val snapshot = refresh()
+        val cursor = snapshot?.cursor ?: 0
+        inspectedCursor = cursor
+        return Inspection(snapshot?.content?.backup ?: Backup(), cursor, supportsV2 = true)
+    }
+
+    private suspend fun refresh(): Rendered? {
+        // Read v1 first. The rendered endpoint can promote a legacy payload, and the two can
+        // hold different libraries while the v1 endpoint still serves its original raw bytes.
+        val rawRender = verifyRaw()
+        val previous = rendered?.let { rawRender ?: it }
+        val request = request("v2/snapshot")
+        previous?.cursor?.takeIf { it > 0 }?.let { request.header(CURSOR, it.toString()) }
+        return send(request).use { response ->
+            when (response.code) {
+                304 -> {
+                    if (previous == null || previous.cursor == 0L ||
+                        response.cursor() != previous.cursor || response.etag() != previous.etag
+                    ) {
+                        throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+                    }
+                    previous
+                }
+                404 -> {
+                    if (rawEtag != null) throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+                    null
+                }
+                else -> {
+                    response.requireOk()
+                    Rendered(response.cursor(), response.etag(), readBackup(response.body.bytes()))
+                }
+            }
+        }.also { rendered = it }
+    }
+
+    private suspend fun verifyRaw(): Rendered? {
+        val request = request("content")
+        rawEtag?.let { request.header("If-None-Match", it) }
+        return send(request).use { response ->
+            when (response.code) {
+                304 -> {
+                    if (rawEtag == null) throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+                    null
+                }
+                404 -> {
+                    rawEtag = null
+                    null
+                }
+                else -> {
+                    response.requireOk()
+                    val etag = response.etag()
+                    val bytes = response.body.bytes().gunzipIfNeeded()
+                    val seq = if (etag.startsWith("seq=")) {
+                        etag.removePrefix("seq=").toLongOrNull()?.takeIf { it >= 0 }
+                    } else {
+                        null
+                    }
+                    val knownRender = if (seq == null) {
+                        verifyBackup(bytes)
+                        null
+                    } else {
+                        // With a seq ETag the raw endpoint is already serving the canonical render.
+                        // Ask the snapshot endpoint to confirm the cursor before reusing these bytes.
+                        Rendered(seq, etag, readBackup(bytes))
+                    }
+                    rawEtag = etag
+                    knownRender
+                }
+            }
+        }
+    }
+
+    suspend fun merge(
+        backup: Backup,
+        cursor: Long,
+        full: Boolean,
+        deletedCategoryUids: Set<Long> = emptySet(),
+    ): Merged {
+        requireV2()
+        val current = refresh()
+        requireCurrentPlan(current?.cursor ?: 0)
+        val body = object : RequestBody() {
+            private val extras = rendered?.content?.extras ?: SyncYomiWire.Extras()
+            override fun contentType() = BINARY
+            override fun writeTo(sink: BufferedSink) {
+                GzipSink(sink).buffer().use { SyncYomiWire.writeTo(backup, it, extras) }
+            }
+        }
+        val request = request("v2/merge")
+            .header(CURSOR, cursor.toString())
+            .header("X-Sync-Full", full.toString())
+            .header("Content-Encoding", "gzip")
+            .post(body)
+        if (deletedCategoryUids.isNotEmpty()) {
+            request.header("X-Sync-Deleted-Categories", deletedCategoryUids.joinToString(","))
+        }
+        return send(request).use { response ->
+            response.requireOk()
+            val nextCursor = response.cursor()
+            val changed = response.requiredBoolean("X-Sync-Changed")
+            val fullRequested = response.header("X-Sync-Full-Requested")?.let {
+                it.toBooleanStrictOrNull() ?: throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+            } ?: false
+            if (nextCursor < cursor && !fullRequested) throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+            val bytes = response.body.bytes()
+            val remote = if (changed) {
+                val content = readBackup(bytes)
+                if (full || cursor == 0L) rendered = Rendered(nextCursor, response.etag(), content)
+                content.backup
+            } else {
+                verifyBackup(bytes)
+                null
+            }
+            Merged(remote, nextCursor, fullRequested)
+        }
+    }
+
+    suspend fun deleteChapters(keys: Set<String>) {
+        if (keys.isEmpty()) return
+        requireV2()
+        requireCurrentPlan(refresh()?.cursor ?: 0)
+        val values = JsonArray(keys.map(::JsonPrimitive))
+        val body = JsonObject(mapOf("deletedChapters" to values)).toString().toRequestBody(JSON_TYPE)
+        send(request("v2/deletions").post(body)).use { response ->
+            response.requireOk()
+            val ack = parseObject(response.body.string())["acknowledged"] as? JsonPrimitive
+            if (ack?.intOrNull != keys.size) throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+        }
+    }
+
+    private fun requireV2() {
+        if (!supportsV2) throw SyncYomiFailure(SyncYomiProblem.UNSUPPORTED)
+    }
+
+    private fun requireCurrentPlan(cursor: Long) {
+        // v2 has no If-Match for merges. Replan if a peer changed the state used to
+        // compose reading progress and bookmarks, or a chapter deletion advanced the cursor.
+        if (cursor != inspectedCursor) throw SyncYomiFailure(SyncYomiProblem.STALE)
+    }
+
+    private fun request(path: String): Request.Builder = Request.Builder()
+        .url(base.newBuilder().addPathSegments("api/sync/$path").build())
+        .header("X-API-Token", token)
+        .header("X-Device-ID", device)
+
+    private suspend fun send(builder: Request.Builder): Response = client.newCall(builder.build()).await()
+
+    private fun Response.requireOk() {
+        if (code == 401 || code == 403) throw SyncYomiFailure(SyncYomiProblem.AUTH, code)
+        if (!isSuccessful) throw SyncYomiFailure(SyncYomiProblem.HTTP, code)
+        if (code != 200) throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+    }
+
+    private fun Response.etag(): String = header("ETag")?.takeIf { it.isNotBlank() }
+        ?: throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+
+    private fun Response.cursor(): Long = header(CURSOR)?.toLongOrNull()?.takeIf { it >= 0 }
+        ?: throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+
+    private fun Response.requiredBoolean(name: String): Boolean = header(name)?.toBooleanStrictOrNull()
+        ?: throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+
+    private fun parseObject(value: String): JsonObject = try {
+        Json.parseToJsonElement(value) as? JsonObject ?: throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+    } catch (_: SerializationException) {
+        throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+    }
+
+    private fun readBackup(bytes: ByteArray): SyncYomiWire.Content = checkBackup { SyncYomiWire.read(bytes) }
+
+    private fun verifyBackup(bytes: ByteArray) = checkBackup { SyncYomiWire.verifyManga(bytes) }
+
+    private fun ByteArray.gunzipIfNeeded(): ByteArray {
+        if (size < 2 || this[0] != 0x1f.toByte() || this[1] != 0x8b.toByte()) return this
+        return try {
+            GzipSource(Buffer().write(this)).buffer().use { it.readByteArray() }
+        } catch (_: IOException) {
+            throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+        }
+    }
+
+    private inline fun <T> checkBackup(block: () -> T): T = try {
+        block()
+    } catch (_: SyncYomiWire.OtherLibrary) {
+        throw SyncYomiFailure(SyncYomiProblem.OTHER_LIBRARY)
+    } catch (_: SerializationException) {
+        throw SyncYomiFailure(SyncYomiProblem.RESPONSE)
+    }
+
+    companion object {
+        private const val CURSOR = "X-Sync-Cursor"
+        private val BINARY = "application/octet-stream".toMediaType()
+        private val JSON_TYPE = "application/json; charset=utf-8".toMediaType()
+    }
+}
+
+private fun InetAddress.allowsCleartextSync(): Boolean {
+    val bytes = address
+    val tailnet = bytes.size == 4 && bytes[0].toInt() == 100 && bytes[1].toInt() and 0xc0 == 0x40
+    val uniqueLocal = bytes.size == 16 && bytes[0].toInt() and 0xfe == 0xfc
+    return isLoopbackAddress || isSiteLocalAddress || tailnet || uniqueLocal
+}
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/sync/SyncYomiWire.kt b/app/src/main/java/eu/kanade/tachiyomi/data/sync/SyncYomiWire.kt
new file mode 100644
index 000000000..8b340b545
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/data/sync/SyncYomiWire.kt
@@ -0,0 +1,333 @@
+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.tachiyomi.data.backup.models.Backup
+import eu.kanade.tachiyomi.data.backup.models.BackupCategory
+import eu.kanade.tachiyomi.data.backup.models.BackupChapter
+import eu.kanade.tachiyomi.data.backup.models.BackupHistory
+import eu.kanade.tachiyomi.data.backup.models.BackupManga
+import eu.kanade.tachiyomi.data.backup.models.BackupSource
+import eu.kanade.tachiyomi.data.backup.models.BackupTracking
+import kotlinx.serialization.KSerializer
+import kotlinx.serialization.SerializationException
+import kotlinx.serialization.protobuf.ProtoBuf
+import kotlinx.serialization.protobuf.ProtoNumber
+import okio.Buffer
+import okio.BufferedSink
+import okio.ByteString
+
+internal object SyncYomiWire {
+    private const val ROOT_MANGA = 1
+    private const val ROOT_CATEGORY = 2
+    private const val ROOT_SOURCE = 101
+    private const val MANGA_CHAPTER = 16
+    private const val MANGA_TRACK = 18
+    private const val MANGA_HISTORY = 104
+    private const val ANIKKU_V2_TAG = 511
+    private const val ANIKKU_V2_SIGNATURE = 0x414e4b32L // ANK2
+    private const val VARINT = 0
+    private const val LENGTH_DELIMITED = 2
+
+    class OtherLibrary : SerializationException("SyncYomi key contains video backup records")
+
+    data class WorkKey(val source: Long, val url: String)
+
+    data class Extras(
+        val works: Map<WorkKey, WorkExtras> = emptyMap(),
+        val categories: Map<Long, ByteString> = emptyMap(),
+        val legacyCategories: Map<String, ByteString> = emptyMap(),
+        val sources: Map<Long, ByteString> = emptyMap(),
+    )
+
+    data class WorkExtras(
+        val work: ByteString,
+        val chapters: Map<String, ByteString>,
+        val history: Map<String, ByteString>,
+        val tracks: Map<Int, ByteString>,
+    )
+
+    data class Content(val backup: Backup, val extras: Extras)
+
+    fun verifyManga(bytes: ByteArray) {
+        for (field in Fields(bytes)) verifyRoot(field)
+    }
+
+    private fun verifyRoot(field: Field) {
+        // The pre-Anikku backup root used 3/4/103. Current native Anikku uses 500–506.
+        // The canonical server may retain either as unknown fields next to manga records.
+        if (field.number == 3 || field.number == 4 || field.number == 103 ||
+            field.number in 500..506 || field.isAnikkuV2Signature()
+        ) {
+            throw OtherLibrary()
+        }
+        if (field.number == ROOT_MANGA) {
+            for (work in field.fields()) {
+                if (work.number in 500..507 || work.isAnikkuV2Signature()) throw OtherLibrary()
+                if (work.number == MANGA_CHAPTER) {
+                    // A pre-signature Anikku merge used these private fields for video duration,
+                    // filler markers, episode descriptions, and preview art.
+                    if (work.fields().asSequence().any {
+                            it.number == 15 || it.number == 16 || it.number in 501..503
+                        }
+                    ) {
+                        throw OtherLibrary()
+                    }
+                }
+            }
+        }
+    }
+
+    fun decode(bytes: ByteArray): Backup = read(bytes).backup
+
+    fun read(bytes: ByteArray): Content {
+        val works = mutableListOf<BackupManga>()
+        val categories = mutableListOf<BackupCategory>()
+        val sources = mutableListOf<BackupSource>()
+        val workExtras = mutableMapOf<WorkKey, WorkExtras>()
+        val categoryExtras = mutableMapOf<Long, ByteString>()
+        val legacyCategoryExtras = mutableMapOf<String, ByteString>()
+        val sourceExtras = mutableMapOf<Long, ByteString>()
+        for (field in Fields(bytes)) {
+            verifyRoot(field)
+            when (field.number) {
+                ROOT_MANGA -> {
+                    val work = field.decode(mangaSchema)
+                    works += work
+                    field.workExtras(work)?.let { workExtras[WorkKey(work.source, work.url)] = it }
+                }
+                ROOT_CATEGORY -> {
+                    val category = field.decode(categorySchema)
+                    categories += category
+                    val extra = field.unknownFields(categorySchema)
+                    if (extra.size != 0) {
+                        if (category.uid !=
+                            0L
+                        ) {
+                            categoryExtras[category.uid] = extra
+                        } else {
+                            legacyCategoryExtras[category.name] = extra
+                        }
+                    }
+                }
+                ROOT_SOURCE -> {
+                    val source = field.decode(sourceSchema)
+                    sources += source
+                    val extra = field.unknownFields(sourceSchema)
+                    if (extra.size != 0) sourceExtras[source.sourceId] = extra
+                }
+            }
+        }
+        return Content(
+            Backup(backupManga = works, backupCategories = categories, backupSources = sources),
+            Extras(workExtras, categoryExtras, legacyCategoryExtras, sourceExtras),
+        )
+    }
+
+    fun writeTo(backup: Backup, sink: BufferedSink, extras: Extras = Extras()) {
+        // Stream each work independently. SyncYomi sees all repeated root records as one backup.
+        for (work in backup.backupManga) {
+            val other = extras.works[WorkKey(work.source, work.url)]
+            val encoded = Buffer()
+            encoded.write(
+                ProtoBuf.encodeToByteArray(
+                    BackupManga.serializer(),
+                    work.copy(chapters = emptyList(), history = emptyList(), tracking = emptyList()),
+                ),
+            )
+            if (other != null) encoded.write(other.work)
+            for (chapter in work.chapters) {
+                encoded.writeRecord(
+                    MANGA_CHAPTER,
+                    BackupChapter.serializer(),
+                    chapter,
+                    other?.chapters?.get(chapter.url),
+                )
+            }
+            for (history in work.history) {
+                encoded.writeRecord(
+                    MANGA_HISTORY,
+                    BackupHistory.serializer(),
+                    history,
+                    other?.history?.get(history.url),
+                )
+            }
+            for (track in work.tracking) {
+                encoded.writeRecord(MANGA_TRACK, BackupTracking.serializer(), track, other?.tracks?.get(track.syncId))
+            }
+            sink.writeMessageHeader(ROOT_MANGA, encoded.size)
+            sink.writeAll(encoded)
+        }
+        for (category in backup.backupCategories) {
+            val other = extras.categories[category.uid] ?: extras.legacyCategories[category.name]
+            sink.writeRecord(ROOT_CATEGORY, BackupCategory.serializer(), category, other)
+        }
+        for (source in backup.backupSources) {
+            sink.writeRecord(ROOT_SOURCE, BackupSource.serializer(), source, extras.sources[source.sourceId])
+        }
+        // Preferences, extension stores, and unknown root sections belong to other clients.
+        // Omitting them leaves every corresponding server item untouched.
+    }
+
+    private fun <T> BufferedSink.writeRecord(number: Int, serializer: KSerializer<T>, record: T, extra: ByteString?) {
+        val encoded = ProtoBuf.encodeToByteArray(serializer, record)
+        writeMessageHeader(number, encoded.size.toLong() + (extra?.size ?: 0))
+        write(encoded)
+        if (extra != null) write(extra)
+    }
+
+    private fun Field.workExtras(work: BackupManga): WorkExtras? {
+        val workFields = fields().asSequence().groupBy { it.number }
+        fun <K> childExtras(number: Int, keys: List<K>, schema: Schema<*>): Map<K, ByteString> =
+            keys.zip(workFields[number].orEmpty()).mapNotNull { (key, child) ->
+                child.unknownFields(schema).takeIf { it.size != 0 }?.let { key to it }
+            }.toMap()
+
+        val extra = unknownFields(mangaSchema)
+        val chapters = childExtras(MANGA_CHAPTER, work.chapters.map { it.url }, chapterSchema)
+        val history = childExtras(MANGA_HISTORY, work.history.map { it.url }, historySchema)
+        val tracks = childExtras(MANGA_TRACK, work.tracking.map { it.syncId }, trackSchema)
+        return WorkExtras(extra, chapters, history, tracks).takeIf {
+            extra.size != 0 || chapters.isNotEmpty() || history.isNotEmpty() || tracks.isNotEmpty()
+        }
+    }
+
+    // Go omits proto3 zero values. Kotlin's file-backup serializers require some of those
+    // scalars to appear, so add their defaults before decoding with the native model.
+    private class Schema<T>(
+        val serializer: KSerializer<T>,
+        val varints: Set<Int> = emptySet(),
+        val strings: Set<Int> = emptySet(),
+        val children: Map<Int, Schema<*>> = emptyMap(),
+    ) {
+        val known: Set<Int> = serializer.descriptor.let { descriptor ->
+            (0 until descriptor.elementsCount).map { index ->
+                descriptor.getElementAnnotations(index).filterIsInstance<ProtoNumber>().single().number
+            }.toSet()
+        }
+    }
+
+    private val chapterSchema = Schema(BackupChapter.serializer(), strings = setOf(1, 2))
+    private val historySchema = Schema(BackupHistory.serializer(), varints = setOf(2), strings = setOf(1))
+    private val trackSchema = Schema(BackupTracking.serializer(), varints = setOf(1, 2))
+    private val mangaSchema = Schema(
+        BackupManga.serializer(),
+        varints = setOf(1),
+        strings = setOf(2),
+        children = mapOf(MANGA_CHAPTER to chapterSchema, MANGA_TRACK to trackSchema, MANGA_HISTORY to historySchema),
+    )
+    private val categorySchema = Schema(BackupCategory.serializer(), strings = setOf(1))
+    private val sourceSchema = Schema(BackupSource.serializer(), varints = setOf(2))
+
+    private class Field(
+        private val bytes: ByteArray,
+        val number: Int,
+        private val type: Int,
+        private val varint: Long?,
+        private val encodedValue: Int,
+        private val payload: Int,
+        private val end: Int,
+    ) {
+        fun isAnikkuV2Signature(): Boolean = number == ANIKKU_V2_TAG && varint == ANIKKU_V2_SIGNATURE
+
+        fun fields(): Fields {
+            if (type != LENGTH_DELIMITED) invalidProtobuf()
+            return Fields(bytes, payload, end)
+        }
+
+        fun <T> decode(schema: Schema<T>): T = ProtoBuf.decodeFromByteArray(
+            schema.serializer,
+            normalized(schema).readByteArray(),
+        )
+
+        fun unknownFields(schema: Schema<*>): ByteString = Buffer().apply {
+            for (field in fields()) {
+                if (field.number !in schema.known) field.writeTo(this)
+            }
+        }.readByteString()
+
+        private fun writeTo(output: BufferedSink) {
+            output.writeVarint((number.toLong() shl 3) or type.toLong())
+            output.write(bytes, encodedValue, end - encodedValue)
+        }
+
+        private fun normalized(schema: Schema<*>): Buffer {
+            val message = Buffer()
+            val missingVarints = schema.varints.toMutableSet()
+            val missingStrings = schema.strings.toMutableSet()
+            for (field in fields()) {
+                missingVarints.remove(field.number)
+                missingStrings.remove(field.number)
+                val childSchema = schema.children[field.number]
+                when {
+                    childSchema != null -> {
+                        val child = field.normalized(childSchema)
+                        message.writeMessageHeader(field.number, child.size)
+                        message.writeAll(child)
+                    }
+                    field.number in schema.known -> field.writeTo(message)
+                }
+            }
+            for (number in missingVarints) {
+                message.writeVarint(number.toLong() shl 3)
+                message.writeVarint(0)
+            }
+            for (number in missingStrings) message.writeMessageHeader(number, 0)
+            return message
+        }
+    }
+
+    private class Fields(
+        private val bytes: ByteArray,
+        private var position: Int = 0,
+        private val end: Int = bytes.size,
+    ) : Iterator<Field> {
+        override fun hasNext(): Boolean = position < end
+
+        override fun next(): Field {
+            val tag = readVarint()
+            if (tag !in 8..0xffffffffL) invalidProtobuf()
+            val number = (tag ushr 3).toInt()
+            val type = (tag and 7).toInt()
+            val encodedValue = position
+            val varint = if (type == VARINT) readVarint() else null
+            val length = when (type) {
+                VARINT -> 0L
+                1 -> 8L
+                LENGTH_DELIMITED -> readVarint()
+                5 -> 4L
+                else -> invalidProtobuf()
+            }
+            if (length !in 0..(end - position).toLong()) invalidProtobuf()
+            val payload = position
+            position += length.toInt()
+            return Field(bytes, number, type, varint, encodedValue, payload, position)
+        }
+
+        private fun readVarint(): Long {
+            var result = 0L
+            for (shift in 0..63 step 7) {
+                if (position >= end) invalidProtobuf()
+                val byte = bytes[position++].toInt() and 0xff
+                if (shift == 63 && byte > 1) invalidProtobuf()
+                result = result or ((byte and 0x7f).toLong() shl shift)
+                if (byte < 0x80) return result
+            }
+            invalidProtobuf()
+        }
+    }
+
+    private fun invalidProtobuf(): Nothing = throw SerializationException("Malformed SyncYomi protobuf")
+
+    private fun BufferedSink.writeMessageHeader(number: Int, length: Long) {
+        writeVarint((number.toLong() shl 3) or LENGTH_DELIMITED.toLong())
+        writeVarint(length)
+    }
+
+    private fun BufferedSink.writeVarint(value: Long) {
+        var remaining = value
+        while (remaining and 0x7fL.inv() != 0L) {
+            writeByte((remaining.toInt() and 0x7f) or 0x80)
+            remaining = remaining ushr 7
+        }
+        writeByte(remaining.toInt())
+    }
+}
