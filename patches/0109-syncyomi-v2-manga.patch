@@ -0,0 +1,127 @@
+package eu.kanade.tachiyomi.data.sync
+
+import android.content.Context
+import androidx.core.content.edit
+import dev.zacsweers.metro.AppScope
+import dev.zacsweers.metro.Inject
+import dev.zacsweers.metro.SingleIn
+import tachiyomi.core.common.preference.AndroidPreferenceStore
+import java.util.UUID
+
+@Inject
+@SingleIn(AppScope::class)
+class MangaSyncSettings(context: Context) {
+    // The ordinary backup only reads the app and source preference stores.
+    private val preferences = context.getSharedPreferences("syncyomi_connection", Context.MODE_PRIVATE)
+    private val store = AndroidPreferenceStore(preferences)
+    private val server = store.getString(KEY_HOST)
+    private val secret = store.getString(KEY_API_KEY)
+    private val deviceId = store.getString(KEY_DEVICE_ID)
+    private val lastSyncRevision = store.getLong(KEY_LAST_SYNC_REVISION)
+
+    val revision = store.getLong(KEY_REVISION)
+    val periodicHours = store.getInt("periodic_hours")
+    val syncOnChange = store.getBoolean("sync_on_change")
+    val lastSuccessAt = store.getLong(KEY_LAST_SUCCESS)
+    internal val lastIssue = store.getObjectFromString<MangaSyncIssue?>(
+        KEY_ISSUE,
+        null,
+        { issue -> issue?.let { "${it.error.name}:${it.httpStatus}" }.orEmpty() },
+        { value ->
+            MangaSyncError.entries.firstOrNull { it.name == value.substringBefore(':') }?.let {
+                MangaSyncIssue(it, value.substringAfter(':', "").toIntOrNull() ?: 0)
+            }
+        },
+    )
+
+    @Synchronized
+    internal fun summary() = Summary(server.get(), secret.get().isNotEmpty(), revision.get())
+
+    @Synchronized
+    internal fun setConnection(host: String, newKey: String): Boolean {
+        val address = normalizeSyncYomiHost(host)?.toString() ?: return false
+        val offeredKey = newKey.trim()
+        if (offeredKey.any { it !in '!'..'~' }) return false
+        val key = if (offeredKey.isBlank() && address == server.get()) secret.get() else offeredKey
+        if (key.isEmpty()) return false
+        if (address != server.get() || key != secret.get()) writeConnection(address, key)
+        return true
+    }
+
+    @Synchronized
+    internal fun clearConnection() = writeConnection("", "")
+
+    private fun writeConnection(host: String, key: String) {
+        preferences.edit {
+            putString(KEY_HOST, host)
+            putString(KEY_API_KEY, key)
+            putLong(KEY_REVISION, revision.get() + 1)
+            remove(KEY_LAST_SUCCESS)
+            remove(KEY_LAST_SYNC_REVISION)
+            remove(KEY_ISSUE)
+        }
+    }
+
+    @Synchronized
+    internal fun connection(expectedRevision: Long): Connection? {
+        val state = summary()
+        if (!state.configured || state.revision != expectedRevision) return null
+        val id = deviceId.get().ifEmpty { UUID.randomUUID().toString().also(deviceId::set) }
+        return Connection(state.host, secret.get(), id)
+    }
+
+    @Synchronized
+    internal fun isCurrentConnection(host: String, apiKey: String, deviceId: String): Boolean {
+        return server.get() == host && secret.get() == apiKey && this.deviceId.get() == deviceId
+    }
+
+    @Synchronized
+    internal fun hasPendingChanges(expectedRevision: Long, localRevision: Long): Boolean {
+        return revision.get() == expectedRevision && lastSyncRevision.get() != localRevision
+    }
+
+    @Synchronized
+    internal fun recordSuccess(expectedRevision: Long, localRevision: Long) {
+        if (revision.get() != expectedRevision) return
+        preferences.edit {
+            putLong(KEY_LAST_SUCCESS, System.currentTimeMillis())
+            putLong(KEY_LAST_SYNC_REVISION, localRevision)
+            remove(KEY_ISSUE)
+        }
+    }
+
+    @Synchronized
+    internal fun recordIssue(expectedRevision: Long, issue: MangaSyncIssue) {
+        if (revision.get() == expectedRevision) lastIssue.set(issue)
+    }
+
+    internal data class Summary(val host: String, val keyConfigured: Boolean, val revision: Long) {
+        val configured get() = host.isNotBlank() && keyConfigured
+    }
+
+    internal class Connection(val host: String, val apiKey: String, val deviceId: String)
+}
+
+internal data class MangaSyncIssue(val error: MangaSyncError, val httpStatus: Int = 0)
+
+internal enum class MangaSyncError {
+    ADDRESS,
+    CLEARTEXT,
+    AUTH,
+    RESPONSE,
+    HTTP,
+    OTHER_LIBRARY,
+    UNSUPPORTED,
+    STALE,
+    CERTIFICATE,
+    NETWORK,
+    GENERAL,
+}
+
+private const val KEY_HOST = "host"
+private const val KEY_API_KEY = "api_key"
+private const val KEY_DEVICE_ID = "device_id"
+private const val KEY_REVISION = "revision"
+private const val KEY_LAST_SYNC_REVISION = "last_sync_revision"
+private const val KEY_LAST_SUCCESS = "last_success"
+private const val KEY_ISSUE = "issue"
