+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.tachiyomi.data.backup.models.BackupCategory
+
+internal data class MangaSyncLibraryCategories(val idsByWireOrder: Map<Long, Long>, val rows: List<BackupCategory>)
+
+internal fun arrangeMangaSyncCategories(
+    matched: Collection<Pair<BackupCategory, BackupCategory>>,
+    localOnly: List<BackupCategory>,
+): MangaSyncLibraryCategories {
+    val occupiedOrders = localOnly.mapTo(mutableSetOf()) { it.order }
+    val sorted = matched.map { (wire, local) ->
+        val requested = wire.syncOrder?.takeIf { it in 0..Int.MAX_VALUE.toLong() }
+            ?: wire.order.takeIf { it in 0..Int.MAX_VALUE.toLong() && (wire.uid == 0L || it != wire.uid) }
+            ?: local.order
+        local to requested
+    }.sortedWith(compareBy({ it.second }, { it.first.name }, { it.first.id }))
+    var next = 0L
+    val ordered = sorted.map { (local, requested) ->
+        var order = maxOf(requested, next)
+        while (order in occupiedOrders) order++
+        next = order + 1
+        local.copy(order = order, syncOrder = null)
+    }
+    val memberships = matched.associate { (wire, local) -> wire.order to local.id }
+    return MangaSyncLibraryCategories(memberships, (ordered + localOnly).sortedBy { it.order })
+}
