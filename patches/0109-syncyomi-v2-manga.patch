+
+    @Test
+    fun `source links retain public identifiers and exclude credential and file URLs`() {
+        assertEquals("https://reader.example/book?id=12", publicMangaSourceUrl("https://reader.example/book?id=12"))
+        assertNull(publicMangaSourceUrl("https://reader.example/book?id=12&token=test"))
