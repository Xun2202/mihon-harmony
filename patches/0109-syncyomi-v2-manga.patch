+    fun load(): State? {
+        val source = try {
+            Files.newInputStream(file.toPath())
+        } catch (_: NoSuchFileException) {
+            return null
+        }
+        return source.use {
+            DataInputStream(GZIPInputStream(it)).use { input ->
+                check(input.readInt() == FORMAT) { "Invalid manga sync checkpoint format" }
+                val cursor = input.readLong()
+                val fullRequested = input.readBoolean()
+                val lastFullAt = input.readLong()
+                val header = input.readRecord(Backup.serializer())
+                val count = input.readInt()
+                check(count >= 0) { "Invalid manga sync checkpoint count" }
+                val manga = ArrayList<BackupManga>()
+                repeat(count) { manga += input.readRecord(BackupManga.serializer()) }
+                check(input.read() == -1) { "Invalid manga sync checkpoint length" }
+                State(cursor, fullRequested, lastFullAt, header.copy(backupManga = manga))
+            }
+        }
+    }
