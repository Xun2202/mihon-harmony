+            val row = existing[url] ?: return@mapNotNull null
+            if (actual != priorChapter.toChapterImpl() ||
+                actual != sentByUrl[url]?.toChapterImpl()
+            ) {
+                return@mapNotNull null
+            }
+            val history = currentHistory[url]
+            if (history != capturedHistory[url] || history != previousHistory[url]) return@mapNotNull null
+            if (downloadManager.getQueuedDownloadOrNull(row.id) != null ||
+                hasDownloaded(beforeManga, actual)
+            ) {
+                return@mapNotNull null
+            }
+            if (downloadManager.isChapterDownloadedOnDisk(
+                    chapterName = actual.name,
+                    chapterScanlator = actual.scanlator,
+                    chapterUrl = actual.url,
+                    mangaTitle = beforeManga.title,
+                    source = sourceManager.getOrStub(beforeManga.source),
+                )
+            ) {
+                return@mapNotNull null
+            }
+            row.id
+        }
+        if (toDelete.isNotEmpty()) database.chapterQueries.removeChaptersWithIds(toDelete)
+
+        incoming.chapters.forEach { entry ->
+            val row = existing[entry.url]
+            val present = currentByUrl[entry.url]
+            val captured = sentByUrl[entry.url]?.toChapterImpl()
+            val before = present?.toChapterImpl()
+            val remote = entry.toChapterImpl()
+            if (before == null && captured != null) throw SyncYomiFailure(SyncYomiProblem.STALE)
+            val touched = before != null && (before.read || before.bookmark || before.lastPageRead != 0)
+            val guard = sent != null || touched
+            val incomingMetadata =
+                incomingChapterFieldWins(before?.metadata(), captured?.metadata(), remote.metadata(), guard)
+            val incomingProgress =
+                incomingChapterFieldWins(before?.progress(), captured?.progress(), remote.progress(), guard)
+            val incomingBookmark =
+                incomingChapterFieldWins(before?.bookmark, captured?.bookmark, remote.bookmark, guard)
