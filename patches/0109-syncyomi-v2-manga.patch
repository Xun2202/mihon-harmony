+INSERT INTO history(manga_id, chapter_id, read_at, read_duration)
+VALUES (:mangaId, :chapterId, :readAt, :duration)
+ON CONFLICT(chapter_id) DO UPDATE SET read_at = excluded.read_at, read_duration = excluded.read_duration
+WHERE coalesce(history.read_at, 0) <= coalesce(excluded.read_at, 0);
