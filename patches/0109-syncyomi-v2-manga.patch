+    suspend fun snapshot(known: Backup? = null): Backup = database.transactionWithResult {
+        val tracked = database.manga_syncQueries.eligibleWorks(MangaMapper::mapManga).awaitAsList()
+            .associateByTo(linkedMapOf()) { it.source to it.url }
+        val removed = database.manga_syncQueries.unfavorites().awaitAsList()
+            .associate { (it.source_id to it.manga_url) to it.modified_at }
