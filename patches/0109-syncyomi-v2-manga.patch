+        CASE WHEN new.user_read IS NOT old.user_read OR new.user_last_page_read IS NOT old.user_last_page_read THEN (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)) END,
