+        (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)),
+        CASE WHEN new.user_read OR new.user_last_page_read != 0 THEN (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)) ELSE 0 END,
+        CASE WHEN new.user_bookmark THEN (CAST(strftime('%s', 'now') AS INTEGER) * 1000 + CAST(substr(strftime('%f', 'now'), 4, 3) AS INTEGER)) ELSE 0 END,
+        new.user_read OR new.user_bookmark OR new.user_last_page_read != 0
+    );
+    DELETE FROM manga_sync_chapter_deleted
