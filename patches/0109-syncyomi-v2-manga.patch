+
+    /** Only the remote entries are returned. Other locally changed items stay pending in the checkpoint. */
+    suspend fun apply(remote: Backup, captured: Backup, baseline: Backup? = null): Backup {
+        val mangasToRename = mutableListOf<Pair<Manga, String>>()
+        val chaptersToRename = mutableListOf<Triple<Manga, Chapter, Chapter>>()
+        val applied = database.transactionWithResult {
+            database.manga_syncQueries.startInbound()
+            val capturedWorks = captured.backupManga.associateBy(BackupManga::key)
+            val priorWorks = baseline?.backupManga.orEmpty().associateBy(BackupManga::key)
+            val rows = remote.backupManga.associate { it.key() to getWork(it) }
+            val currentWorks = backupWorks(rows.values.filterNotNull()).associateBy(BackupManga::key)
+            val unfavorited = database.manga_syncQueries.unfavorites().awaitAsList()
+                .associate { (it.source_id to it.manga_url) to it.modified_at }
+            val currentCategories = backupCategories()
+            val categories = applyCategories(remote.backupCategories, captured, baseline, currentCategories)
+            val capturedCategoryIds = captured.backupCategories.associate { it.order to it.id }
+            val currentCategoryIds = currentCategories.associate { it.order to it.id }
+
+            val updated = remote.backupManga.map { incoming ->
+                currentCoroutineContext().ensureActive()
+                val key = incoming.key()
+                val before = rows[key]
+                val sent = capturedWorks[key]
+                val current = currentWorks[key] ?: sent?.takeIf {
+                    !it.favorite && it.lastModifiedAt == unfavorited[key]
+                }
+                val prior = priorWorks[key]
+                val knownLocally = sent != null || before?.favorite == true || (current?.lastModifiedAt ?: 0) > 0
+                requireUnchanged(current?.details(), sent?.details(), incoming.details(), knownLocally)
+
