@@ -0,0 +1,70 @@
+package eu.kanade.tachiyomi.data.sync
+
+import eu.kanade.domain.manga.model.toSManga
+import eu.kanade.tachiyomi.data.backup.models.Backup
+import eu.kanade.tachiyomi.source.online.HttpSource
+import kotlinx.coroutines.CancellationException
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import tachiyomi.domain.source.service.SourceManager
+import java.net.URI
+import java.net.URISyntaxException
+import java.util.Locale
+
+/** Use the same extension API as the detail screen's Open in WebView action. */
+internal suspend fun Backup.withMangaSourceUrls(sourceManager: SourceManager, previous: Backup?): Backup {
+    val sources = mutableMapOf<Long, HttpSource?>()
+    val previousLinks = previous?.backupManga.orEmpty().associateBy { it.source to it.url }
+    val works = backupManga.map { work ->
+        if (work.source !in sources) sources[work.source] = sourceManager.get(work.source) as? HttpSource
+        val source = sources[work.source]
+        val detailUrl = try {
+            source?.getMangaUrl(work.getMangaImpl().toSManga())?.let(::publicMangaSourceUrl)
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            null
+        } catch (_: LinkageError) {
+            null
+        }
+        val link = detailUrl ?: publicMangaSourceUrl(work.url)
+            ?: previousLinks[work.source to work.url]?.sourceUrl?.let(::publicMangaSourceUrl)
+        if (link == work.sourceUrl) work else work.copy(sourceUrl = link)
+    }
+    return copy(backupManga = works)
+}
+
+private val identityParameters = setOf("id", "gid", "manga", "manga_id", "comic", "comicid", "bookid", "slug")
+private val identityValue = Regex("[A-Za-z0-9_-]{1,80}")
+private val privateSegments = setOf(
+    "access_token", "api", "api_key", "auth", "authorization", "credentials", "jwt", "key",
+    "manifest", "session", "sessionid", "sig", "signature", "token",
+)
+private val fileTypes =
+    setOf("apk", "avif", "cbz", "cbr", "gif", "jpeg", "jpg", "m3u8", "mp4", "pdf", "png", "webp", "zip")
+
+internal fun publicMangaSourceUrl(value: String): String? {
+    val uri = try {
+        URI(value)
+    } catch (_: URISyntaxException) {
+        return null
+    }
+    if (uri.rawAuthority.isNullOrEmpty() || uri.rawUserInfo != null || uri.rawFragment != null) return null
+    val url = value.toHttpUrlOrNull() ?: return null
+    if (url.username.isNotEmpty() || url.password.isNotEmpty()) return null
+    if (url.pathSegments.any { part ->
+            val segment = part.lowercase(Locale.ROOT)
+            segment.any { it.isISOControl() || it in "\\;?@#/" } ||
+                segment.substringBefore('=') in privateSegments || segment.substringAfterLast('.', "") in fileTypes
+        }
+    ) {
+        return null
+    }
+    for (name in url.queryParameterNames) {
+        if (name.lowercase(Locale.ROOT) !in identityParameters ||
+            url.queryParameterValues(name).any { it == null || !identityValue.matches(it) }
+        ) {
+            return null
+        }
+    }
+    return url.toString()
+}
