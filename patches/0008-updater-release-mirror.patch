@@ -42,6 +41,41 @@ class ReleaseServiceImpl(
         )
     }
 
+    /**
+     * Lists the recent releases of the fork repository.
+     *
+     * The fork's CI mirrors the GitHub "list releases" response to the `repo` branch of
+     * the release repository. raw.githubusercontent.com is a plain CDN without the
+     * anonymous api.github.com quota of 60 requests per hour per IP, which phones behind
+     * carrier NAT or a shared proxy exhaust within minutes (HTTP 403). The API stays as
+     * the fallback for when the mirror is unreachable or has not been written yet.
+     */
+    private suspend fun listReleases(repository: String): List<GithubRelease> {
+        val mirrorClient = networkService.client.newBuilder()
+            .connectTimeout(MIRROR_TIMEOUT_SECONDS, TimeUnit.SECONDS)
+            .readTimeout(MIRROR_TIMEOUT_SECONDS, TimeUnit.SECONDS)
+            .callTimeout(MIRROR_TIMEOUT_SECONDS, TimeUnit.SECONDS)
+            .build()
+        return try {
+            with(json) {
+                mirrorClient
+                    .newCall(GET("https://raw.githubusercontent.com/$repository/repo/releases.json"))
+                    .awaitSuccess()
+                    .parseAs<List<GithubRelease>>()
+            }
+        } catch (e: CancellationException) {
+            throw e
+        } catch (e: Exception) {
+            logcat(LogPriority.WARN, e) { "Release mirror unavailable, falling back to the GitHub API" }
+            with(json) {
+                networkService.client
+                    .newCall(GET("https://api.github.com/repos/$repository/releases?per_page=30"))
+                    .awaitSuccess()
+                    .parseAs<List<GithubRelease>>()
+            }
+        }
+    }
+
     private fun getDownloadLink(release: GithubRelease, isFoss: Boolean): String? {
