@@ -0,0 +1,32 @@
+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.input.nestedscroll.NestedScrollSource
+import androidx.compose.ui.unit.Velocity
+import kotlinx.coroutines.runBlocking
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class NavigationChromeConnectionTest {
+    @Test
+    fun `observing navigation changes never consumes content drag or fling`() = runBlocking {
+        val state = BrowsingNavigationBarState(NavigationChromeScrollTracker(24f, 8f)) { true }
+        val connection = state.nestedScrollConnection
+        assertEquals(Offset.Zero, connection.onPostScroll(Offset(0f, -40f), Offset.Zero, NestedScrollSource.UserInput))
+        assertFalse(state.visible)
+        assertEquals(Velocity.Zero, connection.onPreFling(Velocity(0f, -3000f)))
+        assertEquals(Velocity.Zero, connection.onPostFling(Velocity(0f, -3000f), Velocity.Zero))
+        assertFalse(state.visible)
+        assertEquals(Offset.Zero, connection.onPostScroll(Offset(0f, 8f), Offset.Zero, NestedScrollSource.UserInput))
+        assertTrue(state.visible)
+    }
+
+    @Test
+    fun `disabled automatic hiding leaves navigation available`() {
+        val state = BrowsingNavigationBarState(NavigationChromeScrollTracker(24f, 8f)) { false }
+        state.nestedScrollConnection.onPostScroll(Offset(0f, -500f), Offset.Zero, NestedScrollSource.UserInput)
+        assertTrue(state.visible)
+    }
+}
