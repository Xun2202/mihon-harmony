From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xun2202 <98207886+Xun2202@users.noreply.github.com>
Date: Tue, 6 Oct 2026 16:52:30 +0000
Subject: [PATCH] updater: delete the installed update APK at startup

The in-app updater downloads update.apk into the external cache directory
and hands it to the system installer, but nothing ever removed the file, so
the last installer stayed there until the next update overwrote it. Delete
it at startup once the version it holds is installed (or when it cannot be
read). Same change as Anikku Harmony patch 0011.
---
 app/src/main/java/eu/kanade/tachiyomi/App.kt  |  9 +++++++++
 .../data/updater/AppUpdateDownloadJob.kt      | 19 +++++++++++++++++++
 2 files changed, 28 insertions(+)

diff --git a/app/src/main/java/eu/kanade/tachiyomi/App.kt b/app/src/main/java/eu/kanade/tachiyomi/App.kt
index d76f579..605dbcd 100644
--- a/app/src/main/java/eu/kanade/tachiyomi/App.kt
+++ b/app/src/main/java/eu/kanade/tachiyomi/App.kt
@@ -35,6 +35,7 @@ import eu.kanade.tachiyomi.data.coil.MangaCoverKeyer
 import eu.kanade.tachiyomi.data.coil.MangaKeyer
 import eu.kanade.tachiyomi.data.coil.TachiyomiImageDecoder
 import eu.kanade.tachiyomi.data.notification.Notifications
+import eu.kanade.tachiyomi.data.updater.AppUpdateDownloadJob
 import eu.kanade.tachiyomi.di.AppModule
 import eu.kanade.tachiyomi.di.PreferenceModule
 import eu.kanade.tachiyomi.network.NetworkHelper
@@ -49,6 +50,7 @@ import eu.kanade.tachiyomi.util.system.notify
 import kotlinx.coroutines.Dispatchers
 import kotlinx.coroutines.flow.launchIn
 import kotlinx.coroutines.flow.onEach
+import kotlinx.coroutines.launch
 import logcat.AndroidLogcatLogger
 import logcat.LogPriority
 import logcat.LogcatLogger
@@ -157,6 +159,13 @@ class App : Application(), DefaultLifecycleObserver, SingletonImageLoader.Factor
         // Updates widget update
         WidgetManager(Injekt.get(), Injekt.get()).apply { init(scope) }
 
+        // Harmony -->
+        // The in-app updater leaves the installed APK in the cache directory; drop it once it is installed.
+        scope.launch(Dispatchers.IO) {
+            AppUpdateDownloadJob.deleteInstalledApk(this@App)
+        }
+        // Harmony <--
+
         if (!LogcatLogger.isInstalled) {
             val minLogPriority = when {
                 networkPreferences.verboseLogging.get() -> LogPriority.VERBOSE
diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/updater/AppUpdateDownloadJob.kt b/app/src/main/java/eu/kanade/tachiyomi/data/updater/AppUpdateDownloadJob.kt
index ee19e89..5fedd0a 100644
--- a/app/src/main/java/eu/kanade/tachiyomi/data/updater/AppUpdateDownloadJob.kt
+++ b/app/src/main/java/eu/kanade/tachiyomi/data/updater/AppUpdateDownloadJob.kt
@@ -3,6 +3,7 @@ package eu.kanade.tachiyomi.data.updater
 import android.content.Context
 import android.content.pm.ServiceInfo
 import android.os.Build
+import androidx.core.content.pm.PackageInfoCompat
 import androidx.work.Constraints
 import androidx.work.CoroutineWorker
 import androidx.work.ExistingWorkPolicy
@@ -11,6 +12,7 @@ import androidx.work.NetworkType
 import androidx.work.OneTimeWorkRequestBuilder
 import androidx.work.WorkerParameters
 import androidx.work.workDataOf
+import eu.kanade.tachiyomi.BuildConfig
 import eu.kanade.tachiyomi.data.notification.Notifications
 import eu.kanade.tachiyomi.network.GET
 import eu.kanade.tachiyomi.network.NetworkHelper
@@ -110,6 +112,23 @@ class AppUpdateDownloadJob(private val context: Context, workerParams: WorkerPar
 
         fun updateApk(context: Context): File = File(context.externalCacheDir, "update.apk")
 
+        // Harmony -->
+        /**
+         * Deletes the downloaded APK once it is installed (or turned out unreadable). Nothing else removes
+         * it: the system installer does not touch the file, so it would otherwise sit in the cache
+         * directory until the next update overwrote it.
+         */
+        fun deleteInstalledApk(context: Context) {
+            val apkFile = updateApk(context)
+            if (!apkFile.exists()) return
+            val downloadedVersionCode = context.packageManager.getPackageArchiveInfo(apkFile.absolutePath, 0)
+                ?.let { PackageInfoCompat.getLongVersionCode(it) }
+            if (downloadedVersionCode == null || downloadedVersionCode <= BuildConfig.VERSION_CODE) {
+                apkFile.delete()
+            }
+        }
+        // Harmony <--
+
         fun start(context: Context, url: String) {
             val constraints = Constraints(
                 requiredNetworkType = NetworkType.CONNECTED,
