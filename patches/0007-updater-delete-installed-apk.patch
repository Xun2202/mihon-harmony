index 0000000..3144c83
--- /dev/null
+++ b/app/src/main/java/eu/kanade/tachiyomi/data/updater/AppUpdateApkCleaner.kt
@@ -0,0 +1,28 @@
+package eu.kanade.tachiyomi.data.updater
+
+import android.content.Context
+import androidx.core.content.pm.PackageInfoCompat
+import eu.kanade.tachiyomi.BuildConfig
+import java.io.File
+
+/**
+ * Harmony: the in-app updater (NewUpdateScreenModel) downloads `update.apk` into the external cache
+ * directory and hands it to the system installer. The installer does not touch the file and the app
+ * only deletes it when the download fails, so the last installer would otherwise sit in the cache
+ * directory until the next update overwrote it.
+ */
+object AppUpdateApkCleaner {
+
+    fun updateApk(context: Context): File = File(context.externalCacheDir, "update.apk")
+
+    /** Deletes the downloaded APK once it is installed (or turned out unreadable). */
+    fun deleteInstalledApk(context: Context) {
+        val apkFile = updateApk(context)
+        if (!apkFile.exists()) return
+        val downloadedVersionCode = context.packageManager.getPackageArchiveInfo(apkFile.absolutePath, 0)
+            ?.let { PackageInfoCompat.getLongVersionCode(it) }
+        if (downloadedVersionCode == null || downloadedVersionCode <= BuildConfig.VERSION_CODE) {
+            apkFile.delete()
+        }
+    }
+}
