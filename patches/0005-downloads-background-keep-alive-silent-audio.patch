+++ b/app/src/main/java/eu/kanade/tachiyomi/util/system/BackgroundKeepAlive.kt
@@ -0,0 +1,124 @@
+package eu.kanade.tachiyomi.util.system
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import android.os.PowerManager
+import androidx.core.content.getSystemService
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.currentCoroutineContext
+import logcat.LogPriority
+import tachiyomi.core.common.util.system.logcat
+
+/**
+ * Keeps the app process running while a long background job (download queue, library update) is active.
+ *
+ * HarmonyOS 卓易通 suspends an Android app's process a few seconds after it leaves the foreground even
+ * when the app holds a dataSync foreground service, a wake lock and a battery-optimisation exemption
+ * (verified with Animeko on the same device). Downloads then stall until the user reopens the app, and
+ * the idle foreground service keeps draining Android 15's 6-hour dataSync budget. Audio output is the one
+ * activity the host keeps running, so while at least one job holds the keep-alive a silent PCM buffer is
+ * looped by the audio HAL ([AudioTrack.MODE_STATIC]: written once, no CPU) and a partial wake lock is
+ * held. Audio focus is deliberately not requested, so other apps' playback is neither ducked nor paused.
+ */
+object BackgroundKeepAlive {
+
+    private val lock = Any()
+    private var holders = 0
+    private var track: AudioTrack? = null
+    private var wakeLock: PowerManager.WakeLock? = null
+
+    /** Holds the keep-alive until the calling coroutine's [Job] completes, fails or is cancelled. */
+    suspend fun acquireForCurrentJob(context: Context) {
+        val token = acquire(context)
+        val job = currentCoroutineContext()[Job]
+        if (job == null) {
+            token.release()
+            return
+        }
+        job.invokeOnCompletion { token.release() }
+    }
+
+    fun acquire(context: Context): Token {
+        synchronized(lock) {
+            holders++
+            if (holders == 1) start(context.applicationContext)
+        }
+        return Token()
+    }
+
+    class Token internal constructor() {
+        private var released = false
+
+        fun release() {
+            synchronized(lock) {
+                if (released) return
+                released = true
+                holders--
+                if (holders == 0) stop()
+            }
+        }
+    }
+
+    private fun start(context: Context) {
+        try {
+            wakeLock = context.getSystemService<PowerManager>()
+                ?.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "$WAKE_LOCK_TAG:jobs")
+                ?.apply { acquire(WAKE_LOCK_TIMEOUT_MS) }
+        } catch (e: Exception) {
+            logcat(LogPriority.WARN, e) { "Failed to acquire keep-alive wake lock" }
+        }
+        try {
+            val minBuffer = AudioTrack.getMinBufferSize(SAMPLE_RATE, CHANNEL, ENCODING)
+            val bufferSize = maxOf(minBuffer, SAMPLE_RATE * BYTES_PER_FRAME) // >= 1 second of silence
+            val newTrack = AudioTrack.Builder()
+                .setAudioAttributes(
+                    AudioAttributes.Builder()
+                        .setUsage(AudioAttributes.USAGE_MEDIA)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_MUSIC)
+                        .build(),
+                )
+                .setAudioFormat(
+                    AudioFormat.Builder()
+                        .setSampleRate(SAMPLE_RATE)
+                        .setEncoding(ENCODING)
+                        .setChannelMask(CHANNEL)
+                        .build(),
+                )
+                .setBufferSizeInBytes(bufferSize)
+                .setTransferMode(AudioTrack.MODE_STATIC)
+                .build()
+            val silence = ByteArray(bufferSize)
+            newTrack.write(silence, 0, silence.size)
+            newTrack.setLoopPoints(0, bufferSize / BYTES_PER_FRAME, -1)
+            newTrack.play()
+            track = newTrack
+            logcat { "Background keep-alive started (silent audio + wake lock)" }
+        } catch (e: Exception) {
+            logcat(LogPriority.WARN, e) { "Failed to start silent audio keep-alive" }
+        }
+    }
+
+    private fun stop() {
+        track?.let { current ->
+            track = null
+            runCatching {
+                current.stop()
+                current.release()
+            }
+        }
+        wakeLock?.let { current ->
+            wakeLock = null
+            runCatching { if (current.isHeld) current.release() }
+        }
+        logcat { "Background keep-alive stopped" }
+    }
+
+    private const val WAKE_LOCK_TAG = "mihon:BackgroundKeepAlive"
+    private const val WAKE_LOCK_TIMEOUT_MS = 12 * 60 * 60 * 1000L
+    private const val SAMPLE_RATE = 8000
+    private const val CHANNEL = AudioFormat.CHANNEL_OUT_MONO
+    private const val ENCODING = AudioFormat.ENCODING_PCM_16BIT
+    private const val BYTES_PER_FRAME = 2
+}
