+package tachiyomi.presentation.core.components
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Test
+
+class NavigationChromeDetailContinueTargetTest {
+    @Test
+    fun `most recent available history wins without invoking first unread fallback`() {
+        val target = swipeContinueTarget(listOf(1L, 2L, 3L), { it }, listOf(2L, 1L)) {
+            error("History target must preserve its progress instead of choosing first unread")
+        }
+        assertEquals(2L, target)
+    }
+
+    @Test
+    fun `removed history chapter falls back to existing continue target`() {
+        var fallbackCalls = 0
+        val target = swipeContinueTarget(listOf(1L, 2L), { it }, listOf(9L)) {
+            fallbackCalls++
+            1L
+        }
+        assertEquals(1L, target)
+        assertEquals(1, fallbackCalls)
+    }
+
+    @Test
+    fun `no history uses the existing first unread target`() {
+        assertEquals(3L, swipeContinueTarget(listOf(1L, 2L, 3L), { it }, emptyList()) { 3L })
+        assertNull(swipeContinueTarget(emptyList<Long>(), { it }, emptyList()) { null })
+    }
+
+    @Test
+    fun `an older available history remains usable when newest history was deleted`() {
+        assertEquals(2L, swipeContinueTarget(listOf(1L, 2L), { it }, listOf(9L, 2L, 1L)) { 1L })
+    }
+}
