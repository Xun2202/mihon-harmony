+package eu.kanade.tachiyomi.ui.browse.source.browse
+
+import eu.kanade.tachiyomi.source.model.Filter
+import eu.kanade.tachiyomi.source.model.FilterList
+
+/** Extension filters are mutable. Keep sheet edits separate from the applied paging query. */
+internal fun FilterList.copyStateTo(destination: FilterList): FilterList {
+    fun copyState(originals: List<Filter<*>>, targets: List<Filter<*>>) {
+        originals.zip(targets).forEach { (original, target) ->
+            if (original.javaClass != target.javaClass || original.name != target.name) return@forEach
+            if (original is Filter.Group<*> && target is Filter.Group<*>) {
+                copyState(original.state.filterIsInstance<Filter<*>>(), target.state.filterIsInstance<Filter<*>>())
+            } else {
+                @Suppress("UNCHECKED_CAST")
+                (target as Filter<Any?>).state = (original.state as? List<*>)?.toList() ?: original.state
+            }
+        }
+    }
+    copyState(this, destination)
+    return destination
+}
