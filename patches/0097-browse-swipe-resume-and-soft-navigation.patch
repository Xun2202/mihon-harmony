+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.gestures.awaitEachGesture
+import androidx.compose.foundation.gestures.awaitFirstDown
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.composed
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.unit.dp
+import kotlin.math.abs
+
+/** Only the content owns this gesture; the horizontally scrolling filter row stays independent. */
+fun Modifier.sourceBrowseModeSwipe(
+    enabled: Boolean,
+    onSwipe: (forward: Boolean) -> Unit,
+): Modifier = composed {
+    val currentOnSwipe = rememberUpdatedState(onSwipe)
+    pointerInput(enabled) {
+        if (!enabled) return@pointerInput
+        awaitEachGesture {
+            val down = awaitFirstDown(requireUnconsumed = false)
+            val gestureWidth = size.width
+            val commitDistance = minOf(gestureWidth * 0.2f, 96.dp.toPx()).coerceAtLeast(48.dp.toPx())
+            var horizontal = false
+            while (true) {
+                val event = awaitPointerEvent()
+                if (size.width != gestureWidth || event.changes.size != 1) break
+                val change = event.changes.first()
+                if (change.id != down.id || change.isConsumed) break
+                val delta = change.position - down.position
+                if (!horizontal) {
+                    // Do not take over a held item or a predominantly vertical/diagonal scroll.
+                    if (change.uptimeMillis - down.uptimeMillis >= viewConfiguration.longPressTimeoutMillis) break
+                    if (delta.getDistance() <= viewConfiguration.touchSlop) {
+                        if (!change.pressed) break
+                        continue
+                    }
+                    if (abs(delta.x) <= abs(delta.y) * 1.25f) break
+                    horizontal = true
+                }
+                change.consume()
+                if (!change.pressed) {
+                    if (abs(delta.x) >= commitDistance) currentOnSwipe.value(delta.x < 0f)
+                    break
+                }
+            }
+        }
+    }
+}
+
+/** Ordered, bounded navigation, including sources without latest or filters. */
+enum class SourceBrowseMode {
+    Popular,
+    Latest,
+    Filtered,
+    ;
+
+    fun adjacent(forward: Boolean, supportsLatest: Boolean, supportsFilters: Boolean): SourceBrowseMode? {
+        val modes = entries.filter {
+            (it != Latest || supportsLatest) && (it != Filtered || supportsFilters)
+        }
+        val index = modes.indexOf(this)
+        if (index < 0) return null
+        return modes.getOrNull(index + if (forward) 1 else -1)
+    }
+}
