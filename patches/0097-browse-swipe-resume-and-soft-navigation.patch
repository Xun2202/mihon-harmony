+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34], qualifiers = "mdpi")
+class NavigationChromeDetailContinueSwipeTest {
+    @Test
+    fun `only a committed left swipe invokes continue after release`() = runComposeUiTest {
+        var continues = 0
+        setContent {
+            Box(Modifier.requiredSize(320.dp, 500.dp).detailContinueSwipe(true) { continues++ }.testTag("detail"))
+        }
+        onNodeWithTag("detail").performTouchInput {
+            down(Offset(250f, 250f))
+            moveBy(Offset(-150f, 0f))
+        }
+        runOnIdle { assertEquals(0, continues) }
+        onNodeWithTag("detail").performTouchInput { up() }
+        runOnIdle { assertEquals(1, continues) }
+        onNodeWithTag("detail").performTouchInput { swipeRight(durationMillis = 180) }
+        onNodeWithTag("detail").performTouchInput {
+            down(Offset(250f, 250f))
+            moveBy(Offset(-24f, 0f))
+            up()
+            down(Offset(250f, 250f))
+            moveBy(Offset(-150f, 0f))
+            cancel()
+        }
+        runOnIdle { assertEquals(1, continues) }
+    }
+
+    @Test
+    fun `physical screen edges stay available to system back`() = runComposeUiTest {
+        var continues = 0
+        setContent {
+            Box(Modifier.requiredSize(320.dp, 500.dp).detailContinueSwipe(true) { continues++ }.testTag("detail"))
+        }
+        onNodeWithTag("detail").performTouchInput {
+            swipe(start = Offset(310f, 250f), end = Offset(100f, 250f), durationMillis = 180)
+            swipe(start = Offset(10f, 250f), end = Offset(220f, 250f), durationMillis = 180)
+        }
+        runOnIdle { assertEquals(0, continues) }
+    }
+
+    @Test
+    fun `horizontal tag and related rows own their swipe even at an end`() = runComposeUiTest {
+        var continues = 0
+        var horizontalPosition = { 0 }
+        setContent {
+            val scroll = rememberScrollState()
+            horizontalPosition = { scroll.value }
+            Box(Modifier.requiredSize(320.dp, 500.dp).detailContinueSwipe(true) { continues++ }.testTag("detail")) {
+                Box(Modifier.fillMaxSize().horizontalScroll(scroll)) {
+                    Box(Modifier.requiredSize(1000.dp, 500.dp))
+                }
+            }
+        }
+        repeat(6) {
+            onNodeWithTag("detail").performTouchInput {
+                swipe(start = Offset(250f, 250f), end = Offset(70f, 250f), durationMillis = 180)
+            }
+        }
+        runOnIdle {
+            assertTrue(horizontalPosition() > 0)
+            assertEquals(0, continues)
+        }
+    }
+
+    @Test
+    fun `configured chapter row drag takes precedence over detail shortcut`() = runComposeUiTest {
+        var continues = 0
+        var chapterDrag = 0f
+        setContent {
+            Box(Modifier.requiredSize(320.dp, 500.dp).detailContinueSwipe(true) { continues++ }.testTag("detail")) {
+                Box(
+                    Modifier.fillMaxSize().draggable(
+                        state = rememberDraggableState { chapterDrag += it },
+                        orientation = Orientation.Horizontal,
+                    ),
+                )
+            }
+        }
+        onNodeWithTag("detail").performTouchInput {
+            swipe(start = Offset(250f, 250f), end = Offset(70f, 250f), durationMillis = 180)
+        }
+        runOnIdle {
+            assertTrue(chapterDrag < 0f)
+            assertEquals(0, continues)
+        }
+    }
+
+    @Test
+    fun `vertical or diagonal scroll never opens reader`() = runComposeUiTest {
+        var continues = 0
+        var verticalPosition = { 0 }
+        setContent {
+            val scroll = rememberScrollState()
+            verticalPosition = { scroll.value }
+            Box(Modifier.requiredSize(320.dp, 500.dp).detailContinueSwipe(true) { continues++ }.testTag("detail")) {
+                Box(Modifier.fillMaxSize().verticalScroll(scroll)) {
+                    Box(Modifier.requiredSize(320.dp, 1500.dp))
+                }
+            }
+        }
+        onNodeWithTag("detail").performTouchInput {
+            swipe(start = Offset(220f, 400f), end = Offset(220f, 150f), durationMillis = 180)
+            swipe(start = Offset(250f, 400f), end = Offset(100f, 180f), durationMillis = 180)
+        }
+        runOnIdle {
+            assertTrue(verticalPosition() > 0)
+            assertEquals(0, continues)
+        }
+    }
+
+    @Test
+    fun `long press and disabled dialogs or selection do not invoke continue`() = runComposeUiTest {
+        var continues = 0
+        var longPresses = 0
+        val enabled = mutableStateOf(true)
+        setContent {
+            Box(Modifier.requiredSize(320.dp, 500.dp).detailContinueSwipe(enabled.value) { continues++ }.testTag("detail")) {
+                Box(Modifier.fillMaxSize().combinedClickable(onClick = {}, onLongClick = { longPresses++ }))
+            }
+        }
+        onNodeWithTag("detail").performTouchInput {
+            down(Offset(250f, 250f))
+            advanceEventTime(700)
+        }
+        mainClock.advanceTimeBy(700)
+        onNodeWithTag("detail").performTouchInput {
+            moveBy(Offset(-150f, 0f))
+            up()
+        }
+        runOnIdle {
+            assertEquals(1, longPresses)
+            assertEquals(0, continues)
+            enabled.value = false
+        }
+        onNodeWithTag("detail").performTouchInput {
+            swipe(start = Offset(250f, 250f), end = Offset(70f, 250f), durationMillis = 180)
+        }
+        runOnIdle { assertEquals(0, continues) }
+    }
+}
