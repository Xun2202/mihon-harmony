+package tachiyomi.presentation.core.components
+
+/** History IDs are ordered from most recently read to oldest; removed chapters are ignored. */
+fun <T : Any> swipeContinueTarget(
+    available: List<T>,
+    itemId: (T) -> Long,
+    historyMostRecentFirst: List<Long>,
+    fallback: () -> T?,
+): T? {
+    val availableById = available.associateBy(itemId)
+    return historyMostRecentFirst.firstNotNullOfOrNull(availableById::get) ?: fallback()
+}
