+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.gestures.awaitEachGesture
+import androidx.compose.foundation.gestures.awaitFirstDown
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.systemGestures
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.composed
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.platform.LocalLayoutDirection
+import androidx.compose.ui.unit.dp
+import kotlin.math.abs
+
+/** A left swipe in the detail content invokes its existing continue action after release. */
+fun Modifier.detailContinueSwipe(
+    enabled: Boolean,
+    onContinue: () -> Unit,
+): Modifier = composed {
+    val currentOnContinue = rememberUpdatedState(onContinue)
+    val density = LocalDensity.current
+    val layoutDirection = LocalLayoutDirection.current
+    val gestures = WindowInsets.systemGestures
+    val leftEdge = maxOf(with(density) { 32.dp.toPx() }, gestures.getLeft(density, layoutDirection).toFloat())
+    val rightEdge = maxOf(with(density) { 32.dp.toPx() }, gestures.getRight(density, layoutDirection).toFloat())
+    pointerInput(enabled, leftEdge, rightEdge) {
+        if (!enabled) return@pointerInput
+        awaitEachGesture {
+            val down = awaitFirstDown(requireUnconsumed = false)
+            val gestureWidth = size.width
+            val commitDistance = minOf(gestureWidth * 0.2f, 96.dp.toPx()).coerceAtLeast(56.dp.toPx())
+            // Leave both physical screen edges to Android's back gesture, including right-edge back.
+            if (down.position.x <= leftEdge || down.position.x >= size.width - rightEdge) return@awaitEachGesture
+            var horizontal = false
+            while (true) {
+                // The main pass reaches children first: row swipe actions and horizontal lists win.
+                val event = awaitPointerEvent()
+                if (size.width != gestureWidth || event.changes.size != 1) break
+                val change = event.changes.first()
+                if (change.id != down.id || change.isConsumed) break
+                val delta = change.position - down.position
+                if (!horizontal) {
+                    if (change.uptimeMillis - down.uptimeMillis >= viewConfiguration.longPressTimeoutMillis) break
+                    if (delta.getDistance() <= viewConfiguration.touchSlop) {
+                        if (!change.pressed) break
+                        continue
+                    }
+                    if (delta.x >= 0f || abs(delta.x) <= abs(delta.y) * 1.25f) break
+                    horizontal = true
+                }
+                change.consume()
+                if (!change.pressed) {
+                    if (delta.x <= -commitDistance) currentOnContinue.value()
+                    break
+                }
+            }
+        }
+    }
+}
