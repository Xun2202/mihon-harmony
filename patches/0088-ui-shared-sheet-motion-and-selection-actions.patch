+@Config(sdk = [34])
+class NavigationChromeSelectionBarTest {
+    @Test
+    fun `selection actions begin immediately and use compact controls`() = runComposeUiTest {
+        val visible = mutableStateOf(false)
+        var height = 0
+        var button = 0.dp
+        var padding = 0.dp
+        setContent {
+            val config = Configuration(LocalConfiguration.current).apply {
+                screenWidthDp = 400
+                screenHeightDp = 600
+            }
+            CompositionLocalProvider(LocalConfiguration provides config, LocalDensity provides Density(1f)) {
+                button = selectionActionButtonSize()
+                padding = selectionActionBarVerticalPadding()
+                Column(Modifier.requiredSize(400.dp, 160.dp)) {
+                    SelectionActionBar(visible.value, Modifier.onGloballyPositioned { height = it.size.height }) {
+                        Box(Modifier.height(48.dp))
+                    }
+                }
+            }
+        }
+        mainClock.autoAdvance = false
+        runOnIdle {
+            assertEquals(40.dp, button)
+            assertEquals(4.dp, padding)
+            visible.value = true
+        }
+        mainClock.advanceTimeByFrame()
+        waitForIdle()
+        mainClock.advanceTimeBy(64)
+        runOnIdle { assertTrue(height in 1..47, "entry should already be visible: $height") }
+        mainClock.advanceTimeBy(500)
+        runOnIdle { assertEquals(48, height) }
+    }
