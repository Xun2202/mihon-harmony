@@ -0,0 +1,53 @@
+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.BoxWithConstraints
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.pager.HorizontalPager
+import androidx.compose.foundation.pager.PagerState
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.clipToBounds
+import androidx.compose.ui.layout.layout
+import androidx.compose.ui.unit.constrainHeight
+import kotlin.math.ceil
+import kotlin.math.floor
+import kotlin.math.roundToInt
+
+/** Measure page content against the available window, then interpolate its viewport with the swipe. */
+@Composable
+fun AdaptiveHeightPager(
+    state: PagerState,
+    modifier: Modifier = Modifier,
+    content: @Composable (Int) -> Unit,
+) {
+    BoxWithConstraints(modifier.fillMaxWidth()) {
+        // Layout-only cache: pages and the viewport read/write it in the same measure pass.
+        val heights = remember(constraints.maxWidth, constraints.maxHeight) { mutableMapOf<Int, Int>() }
+        HorizontalPager(
+            state = state,
+            verticalAlignment = Alignment.Top,
+            flingBehavior = rememberFrameTimeProtectedPagerFlingBehavior(state),
+            modifier = Modifier.settlePagerOnWidthChange(state).clipToBounds().layout { measurable, constraints ->
+                val page = measurable.measure(constraints.copy(minHeight = 0))
+                val position = (state.currentPage + state.currentPageOffsetFraction).coerceIn(0f, (state.pageCount - 1).coerceAtLeast(0).toFloat())
+                val before = floor(position).toInt()
+                val after = ceil(position).toInt()
+                val h0 = heights[before] ?: heights[after] ?: page.height
+                val h1 = heights[after] ?: h0
+                val height = constraints.constrainHeight((h0 + (h1 - h0) * (position - before)).roundToInt())
+                layout(page.width, height) { page.placeRelative(0, 0) }
+            },
+        ) { page ->
+            Box(
+                Modifier.fillMaxWidth().layout { measurable, constraints ->
+                    val item = measurable.measure(constraints.copy(minHeight = 0))
+                    heights[page] = item.height
+                    layout(item.width, item.height) { item.placeRelative(0, 0) }
+                },
+            ) { content(page) }
+        }
+    }
+}
