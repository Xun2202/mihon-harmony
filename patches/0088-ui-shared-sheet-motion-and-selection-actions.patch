+import androidx.compose.ui.test.performTouchInput
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.unit.Density
+import androidx.compose.ui.unit.dp
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromeSheetMotionTest {
+    @Test
+    fun `phone dismissal waits for the same motion that drives its scrim`() = assertLifecycle(false)
+
+    @Test
+    fun `centered dismissal also waits for its fade instead of removing the window immediately`() = assertLifecycle(true)
+
+    private fun assertLifecycle(tablet: Boolean) = runComposeUiTest {
+        val state = AdaptiveSheetState()
+        var dismissed = 0
+        mainClock.autoAdvance = false
+        setContent {
+            CompositionLocalProvider(LocalDensity provides Density(1f)) {
+                Box(Modifier.requiredSize(400.dp, 600.dp)) {
+                    AdaptiveSheet(tablet, true, { dismissed++ }, contentWindowInsets = WindowInsets(0), state = state) {
+                        Box(Modifier.fillMaxWidth().height(240.dp))
+                    }
+                }
+            }
+        }
+        mainClock.advanceTimeByFrame()
+        waitForIdle()
+        mainClock.advanceTimeBy(96)
+        runOnIdle {
+            assertTrue(state.visibleFraction in 0.01f..0.99f, "enter=${state.visibleFraction}")
+            assertEquals(0, dismissed)
+        }
+        mainClock.advanceTimeBy(500)
+        runOnIdle {
+            assertEquals(1f, state.visibleFraction, 0.01f)
+            state.dismiss()
+        }
+        mainClock.advanceTimeByFrame()
+        waitForIdle()
+        mainClock.advanceTimeBy(96)
+        runOnIdle {
+            assertTrue(state.visibleFraction in 0.01f..0.99f, "exit=${state.visibleFraction}")
+            assertEquals(0, dismissed)
+        }
+        mainClock.advanceTimeBy(500)
+        runOnIdle {
+            assertEquals(0f, state.visibleFraction, 0.01f)
+            assertEquals(1, dismissed)
+            state.dismiss()
+        }
+        mainClock.advanceTimeBy(500)
+        runOnIdle { assertEquals(1, dismissed) }
+    }
+
+    @Test
+    fun `content drag closes after a modest distance even without release velocity`() = assertContentDrag(80f, false, true)
+
+    @Test
+    fun `content short fast flick closes using velocity`() = assertContentDrag(40f, true, true)
+
+    @Test
+    fun `content small slow movement restores the sheet`() = assertContentDrag(24f, false, false)
+
+    private fun assertContentDrag(distance: Float, fast: Boolean, closes: Boolean) = runComposeUiTest {
+        val state = AdaptiveSheetState()
+        var dismissed = 0
+        setContent {
+            CompositionLocalProvider(LocalDensity provides Density(1f)) {
+                Box(Modifier.requiredSize(400.dp, 600.dp)) {
+                    AdaptiveSheet(false, true, { dismissed++ }, contentWindowInsets = WindowInsets(0), state = state) {
+                        Column(
+                            Modifier.fillMaxWidth().testTag("body")
+                                .verticalScroll(rememberScrollState(), flingBehavior = rememberFrameTimeProtectedFlingBehavior()),
+                        ) { Box(Modifier.fillMaxWidth().height(1400.dp)) }
+                    }
+                }
+            }
+        }
+        waitForIdle()
+        onNodeWithTag("body").performTouchInput {
+            down(center)
+            if (fast) {
+                repeat(4) { moveBy(Offset(0f, distance / 4), delayMillis = 16) }
+            } else {
+                moveBy(Offset(0f, distance))
+                advanceEventTime(250)
+            }
+            up()
+        }
+        waitForIdle()
+        runOnIdle {
+            assertEquals(if (closes) 1 else 0, dismissed, "distance=$distance fast=$fast fraction=${state.visibleFraction}")
+            assertEquals(if (closes) 0f else 1f, state.visibleFraction, 0.01f)
+        }
+    }
+}
