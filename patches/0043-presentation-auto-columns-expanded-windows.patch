+package tachiyomi.presentation.core.components
+
+/**
+ * Minimum cell width for an automatic column count.
+ *
+ * Narrower than [mediumBreakpointDp] uses 112 dp. Narrower than [expandedBreakpointDp] uses
+ * 140 dp. That breakpoint and wider uses 176 dp. The defaults are the app window-size
+ * breakpoints (600 dp and 840 dp). Lane count is [autoColumnCount].
+ */
+fun autoColumnMinDp(
+    windowWidthDp: Int,
+    mediumBreakpointDp: Int = 600,
+    expandedBreakpointDp: Int = 840,
+): Int {
+    return when {
+        windowWidthDp < mediumBreakpointDp -> 112
+        windowWidthDp < expandedBreakpointDp -> 140
+        else -> 176
+    }
+}
+
+/**
+ * Columns that fit [windowWidthDp] at [autoColumnMinDp].
+ *
+ * [horizontalPaddingDp] is removed before the count, and [spacingDp] is the gap counted on
+ * both sides of the division, same as [staggeredLaneCountAdaptive].
+ */
+fun autoColumnCount(
+    windowWidthDp: Int,
+    horizontalPaddingDp: Int = 16,
+    spacingDp: Int = 4,
+    mediumBreakpointDp: Int = 600,
+    expandedBreakpointDp: Int = 840,
+): Int {
+    val min = autoColumnMinDp(windowWidthDp, mediumBreakpointDp, expandedBreakpointDp)
+    val available = windowWidthDp - horizontalPaddingDp
+    return staggeredLaneCountAdaptive(available, spacingDp, min)
+}
+
+/**
+ * [lanes], unless that is more than fit at [minSize].
+ *
+ * A shaped shelf may stay on fewer, wider columns. It cannot go past the automatic tier.
+ */
+fun capLaneCountToMinWidth(lanes: Int, availableSize: Int, spacing: Int, minSize: Int): Int {
+    return minOf(lanes, staggeredLaneCountAdaptive(availableSize, spacing, minSize))
+}
