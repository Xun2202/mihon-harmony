+package eu.kanade.tachiyomi.data.download
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+
+class NavigationChromeDownloadSilentWaveTest {
+    @TempDir
+    lateinit var directory: File
+
+    @Test
+    fun `system playback loop is a complete standard PCM wave containing only silence`() {
+        val file = File(directory, "silence.wav").apply { writeText("stale incomplete file") }
+        val data = DownloadSilentWave.write(file).readBytes()
+        assertEquals("RIFF", data.copyOfRange(0, 4).toString(Charsets.US_ASCII))
+        assertEquals("WAVEfmt ", data.copyOfRange(8, 16).toString(Charsets.US_ASCII))
+        val header = ByteBuffer.wrap(data).order(ByteOrder.LITTLE_ENDIAN)
+        assertEquals(data.size - 8, header.getInt(4))
+        assertEquals(1, header.getShort(20).toInt())
+        assertEquals(1, header.getShort(22).toInt())
+        assertEquals(8000, header.getInt(24))
+        assertEquals(16, header.getShort(34).toInt())
+        assertEquals(30, header.getInt(40) / header.getInt(28))
+        assertEquals(header.getInt(40) + 44, data.size)
+        assertTrue(data.drop(44).all { it == 0.toByte() })
+    }
+}
