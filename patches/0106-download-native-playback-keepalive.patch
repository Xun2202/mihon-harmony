+package eu.kanade.tachiyomi.data.download
+
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+
+/** A local PCM loop for the system player, with no network or encoded-media dependency. */
+internal object DownloadSilentWave {
+    const val RATE = 8000
+    const val DURATION_SECONDS = 30
+
+    fun write(file: File): File {
+        val dataBytes = RATE * 2 * DURATION_SECONDS
+        val header = ByteBuffer.allocate(44).order(ByteOrder.LITTLE_ENDIAN)
+            .put("RIFF".toByteArray(Charsets.US_ASCII)).putInt(36 + dataBytes)
+            .put("WAVEfmt ".toByteArray(Charsets.US_ASCII)).putInt(16)
+            .putShort(1).putShort(1).putInt(RATE).putInt(RATE * 2)
+            .putShort(2).putShort(16)
+            .put("data".toByteArray(Charsets.US_ASCII)).putInt(dataBytes).array()
+        file.outputStream().use { output ->
+            output.write(header)
+            val second = ByteArray(RATE * 2)
+            repeat(DURATION_SECONDS) { output.write(second) }
+        }
+        return file
+    }
+}
