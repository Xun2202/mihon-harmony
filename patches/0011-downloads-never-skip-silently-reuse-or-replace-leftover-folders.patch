+            val reasons = buildList {
+                if (result.alreadyDownloaded > 0) {
+                    add(context.stringResource(MR.strings.harmony_download_skipped_downloaded, result.alreadyDownloaded))
+                }
+                if (result.alreadyQueued > 0) {
+                    add(context.stringResource(MR.strings.harmony_download_skipped_queued, result.alreadyQueued))
+                }
+                if (result.sourceUnavailable > 0) {
+                    add(context.stringResource(MR.strings.harmony_download_skipped_no_source, result.sourceUnavailable))
+                }
+            }
+            snackbarHostState.showSnackbar(
+                message = context.stringResource(MR.strings.harmony_download_skipped, reasons.joinToString(" · ")),
+                withDismissAction = true,
+            )
+        }
     }
 
