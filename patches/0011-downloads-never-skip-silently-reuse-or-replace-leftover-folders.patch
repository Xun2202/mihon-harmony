+            // Harmony: the chapter may already be on disk without the cache knowing
+            // (finalisation interrupted by a process kill, stale cache). Reuse a complete
+            // copy, remove an incomplete one; never skip silently.
+            if (reuseOrRemoveExistingChapter(download, mangaDir, chapterDirname, pageList.size)) {
