+                    ?: throw IOException("Failed to create '$chapterDirname$TMP_DIR_SUFFIX'")
+            }
+
             download.status = Download.State.DOWNLOADING
 
             // Start downloading images, consider we can have downloaded images already
@@ -645,17 +679,83 @@ class Downloader(
         }
 
         // Ensure that the chapter folder has all the pages
-        val downloadedImagesCount = tmpDir.listFiles().orEmpty().count {
-            val fileName = it.name.orEmpty()
-            when {
-                fileName in listOf(COMIC_INFO_FILE, NOMEDIA_FILE) -> false
-                fileName.endsWith(".tmp") -> false
-                // Only count the first split page and not the others
-                fileName.contains("__") && !fileName.endsWith("__001.jpg") -> false
-                else -> true
+        val downloadedImagesCount = tmpDir.listFiles().orEmpty().count { isCountedPageFile(it.name.orEmpty()) }
+        return downloadedImagesCount == downloadPageCount
+    }
+
+    /**
+     * Whether a file inside a chapter folder counts as one downloaded page.
+     */
+    private fun isCountedPageFile(fileName: String): Boolean = when {
+        fileName in listOf(COMIC_INFO_FILE, NOMEDIA_FILE) -> false
+        fileName.endsWith(".tmp") -> false
+        // Only count the first split page and not the others
+        fileName.contains("__") && !fileName.endsWith("__001.jpg") -> false
+        else -> true
+    }
+
+    /**
+     * Harmony: handles a chapter folder / archive that already exists on disk although the
+     * download cache did not list the chapter as downloaded.
+     *
+     * @return true when the existing copy holds every page and has been registered as
+     * downloaded; false when there was nothing on disk or the leftover was removed so the
+     * download can start from scratch.
+     */
+    private suspend fun reuseOrRemoveExistingChapter(
+        download: Download,
+        mangaDir: UniFile,
+        chapterDirname: String,
+        pageCount: Int,
+    ): Boolean {
+        val existing = provider
+            .getValidChapterDirNames(download.chapter.name, download.chapter.scanlator, download.chapter.url)
+            .firstNotNullOfOrNull { mangaDir.findFile(it) }
+            ?: return false
+        val name = existing.name ?: return false
+
+        val imageCount = countChapterImages(existing)
+        if (imageCount >= pageCount) {
+            logcat(LogPriority.INFO) {
+                "'${download.chapter.name}' already on disk as '$name' ($imageCount pages); registering it as downloaded"
+            }
+            if (existing.isDirectory) {
+                DiskUtil.createNoMediaFile(existing, context)
             }
+            cache.addChapter(name.removeSuffix(".cbz"), mangaDir, download.manga)
+            // Whatever an earlier attempt left in the temporary directories is no longer needed.
+            mangaDir.findFile(chapterDirname + TMP_DIR_SUFFIX)?.delete()
+            File(context.cacheDir, "harmony_download_tmp/${download.manga.id}/$chapterDirname$TMP_DIR_SUFFIX")
+                .deleteRecursively()
+            return true
         }
-        return downloadedImagesCount == downloadPageCount
+
+        logcat(LogPriority.WARN) {
+            "Removing incomplete leftover '$name' of '${download.chapter.name}' ($imageCount/$pageCount pages)"
+        }
+        if (!existing.delete()) {
+            throw IOException(context.stringResource(MR.strings.harmony_download_leftover_delete_failed, name))
+        }
+        return false
+    }
+
+    /**
+     * Counts the page images inside a chapter folder or CBZ archive; 0 when it cannot be read.
+     */
+    private fun countChapterImages(file: UniFile): Int = try {
+        if (file.isDirectory) {
+            file.listFiles().orEmpty().count { isCountedPageFile(it.name.orEmpty()) }
+        } else {
+            file.archiveReader(context).use { reader ->
+                reader.useEntries { entries ->
+                    entries.count { it.isFile && isCountedPageFile(it.name.substringAfterLast('/')) }
+                }
+            }
+        }
+    } catch (e: Exception) {
+        if (e is CancellationException) throw e
+        logcat(LogPriority.WARN, e) { "Could not inspect existing chapter '${file.name}'" }
+        0
     }
 
