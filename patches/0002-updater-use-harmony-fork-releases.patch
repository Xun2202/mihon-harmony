From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xun2202 <98207886+Xun2202@users.noreply.github.com>
Date: Mon, 12 Oct 2026 06:38:33 +0000
Subject: [PATCH] updater: check this fork's GitHub releases for
 -harmony-preview builds

The stock updater asks api.github.com for mihonapp/mihon's latest release
and only understands v0.1.2 / r1234 version strings, so a build versioned
0.21.0-harmony.1 either crashes the parser or is offered the official APK,
which cannot be installed over an APK signed with a different key.

- AppUpdateChecker: GITHUB_REPO is Xun2202/mihon-harmony; RELEASE_TAG is
  derived from VERSION_NAME as v<ver>-harmony-preview.<N> for the nightly
  build type (upstream renamed "preview" to "nightly" in v0.21.0; the
  package suffix is still .debug) and v<ver>-harmony.<N> otherwise.
- ReleaseServiceImpl: list /releases?per_page=30 and pick the newest tag
  containing "-harmony-preview." for nightly builds, or "-harmony." without
  "preview" for release builds. ABI-based APK selection is unchanged, so
  release assets must keep the -arm64-v8a / -universal name fragments.
- GetApplicationRelease: compare (major, minor, patch, harmony) tuples
  parsed from "(\d+)\.(\d+)\.(\d+)-harmony(?:-preview)?\.(\d+)"; fall back to
  the upstream logic only when parsing fails, with toIntOrNull() so an
  unexpected tag cannot crash the app.

Rebased from the v0.20.4 series (0002): same change, only the
isPreview -> isNightly renames differ.
---
 .../data/updater/AppUpdateChecker.kt          | 28 +++++++-----
 .../data/release/ReleaseServiceImpl.kt        | 16 +++++--
 .../interactor/GetApplicationRelease.kt       | 45 +++++++++++++++----
 3 files changed, 67 insertions(+), 22 deletions(-)

diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/updater/AppUpdateChecker.kt b/app/src/main/java/eu/kanade/tachiyomi/data/updater/AppUpdateChecker.kt
index 0a7a36b..a28695d 100644
--- a/app/src/main/java/eu/kanade/tachiyomi/data/updater/AppUpdateChecker.kt
+++ b/app/src/main/java/eu/kanade/tachiyomi/data/updater/AppUpdateChecker.kt
@@ -36,19 +36,27 @@ class AppUpdateChecker(
     }
 }
 
-val GITHUB_REPO: String by lazy {
-    if (isNightlyBuildType) {
-        "mihonapp/mihon-preview"
-    } else {
-        "mihonapp/mihon"
-    }
-}
+/**
+ * Mihon Harmony fork: both the stable and the preview channel are published as
+ * GitHub releases of the fork repository. The channel is told apart by the tag
+ * suffix (`-harmony.N` vs `-harmony-preview.N`); the preview channel is what the
+ * `nightly` build type (package `app.mihon.debug`) installs.
+ */
+const val GITHUB_REPO: String = "Xun2202/mihon-harmony"
+
+private val HARMONY_VERSION_REGEX = Regex("""^(\d+\.\d+\.\d+)-harmony\.(\d+)""")
 
 val RELEASE_TAG: String by lazy {
-    if (isNightlyBuildType) {
-        "r${BuildConfig.COMMIT_COUNT}"
-    } else {
+    val match = HARMONY_VERSION_REGEX.find(BuildConfig.VERSION_NAME)
+    if (match == null) {
         "v${BuildConfig.VERSION_NAME}"
+    } else {
+        val (base, patch) = match.destructured
+        if (isNightlyBuildType) {
+            "v$base-harmony-preview.$patch"
+        } else {
+            "v$base-harmony.$patch"
+        }
     }
 }
 
diff --git a/data/src/main/java/tachiyomi/data/release/ReleaseServiceImpl.kt b/data/src/main/java/tachiyomi/data/release/ReleaseServiceImpl.kt
index af54e86..4df0e71 100644
--- a/data/src/main/java/tachiyomi/data/release/ReleaseServiceImpl.kt
+++ b/data/src/main/java/tachiyomi/data/release/ReleaseServiceImpl.kt
@@ -25,15 +25,22 @@ class ReleaseServiceImpl(
 ) : ReleaseService {
 
     override suspend fun latest(arguments: GetApplicationRelease.Arguments): Release? {
-        val release = withContext(Dispatchers.IO) {
+        // Mihon Harmony fork: stable and preview builds share one repository, so
+        // list recent releases and pick the newest one that belongs to our channel.
+        val releases = withContext(Dispatchers.IO) {
             with(json) {
                 networkService.client
-                    .newCall(GET("https://api.github.com/repos/${arguments.repository}/releases/latest"))
+                    .newCall(GET("https://api.github.com/repos/${arguments.repository}/releases?per_page=30"))
                     .awaitSuccess()
-                    .parseAs<GithubRelease>()
+                    .parseAs<List<GithubRelease>>()
             }
         }
 
+        val release = releases.firstOrNull { candidate ->
+            val isPreviewTag = PREVIEW_TAG_MARKER in candidate.version
+            if (arguments.isNightly) isPreviewTag else !isPreviewTag && STABLE_TAG_MARKER in candidate.version
+        } ?: return null
+
         val downloadLink = getDownloadLink(release = release, isFoss = arguments.isFoss) ?: return null
 
         return Release(
@@ -62,6 +69,9 @@ class ReleaseServiceImpl(
         private const val FOSS = "foss"
         private val BUILD_TYPES = listOf(FOSS, "arm64-v8a", "armeabi-v7a", "x86_64", "x86")
 
+        private const val PREVIEW_TAG_MARKER = "-harmony-preview."
+        private const val STABLE_TAG_MARKER = "-harmony."
+
         /**
          * Regular expression that matches a mention to a valid GitHub username, like it's
          * done in GitHub Flavored Markdown. It follows these constraints:
diff --git a/domain/src/main/java/tachiyomi/domain/release/interactor/GetApplicationRelease.kt b/domain/src/main/java/tachiyomi/domain/release/interactor/GetApplicationRelease.kt
index 98237f0..1bcbe13 100644
--- a/domain/src/main/java/tachiyomi/domain/release/interactor/GetApplicationRelease.kt
+++ b/domain/src/main/java/tachiyomi/domain/release/interactor/GetApplicationRelease.kt
@@ -30,28 +30,51 @@ class GetApplicationRelease(
         versionName: String,
         versionTag: String,
     ): Boolean {
+        // Mihon Harmony fork: versions look like "0.21.0-harmony.1" (versionName,
+        // optionally followed by "-<commitCount>" in nightly builds) and release tags
+        // look like "v0.21.0-harmony.1" or "v0.21.0-harmony-preview.1".
+        val newHarmony = parseHarmonyVersion(versionTag)
+        val oldHarmony = parseHarmonyVersion(versionName)
+        if (newHarmony != null && oldHarmony != null) {
+            return compareVersions(newHarmony, oldHarmony) > 0
+        }
+
+        // Fallback to the upstream Mihon logic.
         // Removes prefixes like "r" or "v"
         val newVersion = versionTag.replace("[^\\d.]".toRegex(), "")
         return if (isNightly) {
             // Nightly builds: based on releases in "mihonapp/mihon-preview" repo
             // tagged as something like "r1234"
-            newVersion.toInt() > commitCount
+            newVersion.toIntOrNull()?.let { it > commitCount } ?: false
         } else {
             // Release builds: based on releases in "mihonapp/mihon" repo
             // tagged as something like "v0.1.2"
             val oldVersion = versionName.replace("[^\\d.]".toRegex(), "")
 
-            val newSemVer = newVersion.split(".").map { it.toInt() }
-            val oldSemVer = oldVersion.split(".").map { it.toInt() }
+            val newSemVer = newVersion.split(".").mapNotNull { it.toIntOrNull() }
+            val oldSemVer = oldVersion.split(".").mapNotNull { it.toIntOrNull() }
+
+            compareVersions(newSemVer, oldSemVer) > 0
+        }
+    }
 
-            oldSemVer.mapIndexed { index, i ->
-                if (newSemVer[index] > i) {
-                    return true
-                }
-            }
+    /**
+     * Returns `[major, minor, patch, harmonyPatch]` or null when the string is not
+     * a Mihon Harmony version.
+     */
+    private fun parseHarmonyVersion(value: String): List<Int>? {
+        val match = HARMONY_VERSION_REGEX.find(value) ?: return null
+        return match.groupValues.drop(1).map { it.toInt() }
+    }
 
-            false
+    private fun compareVersions(a: List<Int>, b: List<Int>): Int {
+        val size = maxOf(a.size, b.size)
+        for (index in 0 until size) {
+            val x = a.getOrElse(index) { 0 }
+            val y = b.getOrElse(index) { 0 }
+            if (x != y) return x.compareTo(y)
         }
+        return 0
     }
 
     data class Arguments(
@@ -68,4 +91,8 @@ class GetApplicationRelease(
         data object NoNewUpdate : Result
         data object OsTooOld : Result
     }
+
+    private companion object {
+        val HARMONY_VERSION_REGEX = Regex("""(\d+)\.(\d+)\.(\d+)-harmony(?:-preview)?\.(\d+)""")
+    }
 }
