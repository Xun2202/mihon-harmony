+/**
+ * Header prefetch for the window [firstVisibleIndex, lastVisibleIndex] plus [PREFETCH_AHEAD] rows.
+ * At most [PREFETCH_MAX_IN_FLIGHT] requests run. Enqueueing waits while a panorama grid is scrolling.
+ * A row more than one such window behind the viewport is cancelled. An id is finished only once a
+ * ratio was stored, so a paging append does not start over at index 0. A header miss or a failed
+ * fetch is tried at most once more. The pump reads the window ids, so a paging snapshot that fills
+ * placeholders wakes it.
+ */
+@Composable
+private fun PrefetchPanoramaCoverShapesBounds(
+    itemCount: Int,
+    mangaAt: (Int) -> Manga?,
+    firstVisibleIndex: () -> Int,
+    lastVisibleIndex: () -> Int,
+) {
+    val context = LocalContext.current
+    val currentMangaAt by rememberUpdatedState(mangaAt)
+    val currentCount by rememberUpdatedState(itemCount)
+    val currentFirst by rememberUpdatedState(firstVisibleIndex)
+    val currentLast by rememberUpdatedState(lastVisibleIndex)
+    // Bumped from composition when paging fills placeholders without moving the window.
+    val compositionTick = remember { mutableIntStateOf(0) }
+    SideEffect { compositionTick.intValue++ }
+    // Bumped when a request finishes, so the pump can start the next one.
+    val finishedTick = remember { mutableIntStateOf(0) }
+    LaunchedEffect(context) {
+        val loader = context.imageLoader
+        val inFlight = LinkedHashMap<Long, PrefetchInFlight>()
+        val finished = HashSet<Long>()
+        val attempts = HashMap<Long, Int>()
+        fun complete(mangaId: Long, stored: Boolean, attempted: Boolean) {
+            launch {
+                if (inFlight.remove(mangaId) == null) return@launch
+                if (stored) {
+                    finished.add(mangaId)
+                } else if (attempted) {
+                    val used = (attempts[mangaId] ?: 0) + 1
+                    attempts[mangaId] = used
+                    if (used >= PREFETCH_MAX_ATTEMPTS) finished.add(mangaId)
+                }
+                finishedTick.intValue++
+            }
+        }
+        try {
+            snapshotFlow {
+                val count = currentCount.coerceAtLeast(0)
+                val first = currentFirst().coerceIn(0, count)
+                val last = currentLast().coerceIn(first, count)
+                val end = minOf(count, last + PREFETCH_AHEAD + 1)
+                val ids = ArrayList<Long>(end - first)
+                for (index in first until end) {
+                    // Reads the paging snapshot, so a placeholder that becomes a row wakes this flow.
+                    ids.add(currentMangaAt(index)?.id ?: Long.MIN_VALUE)
+                }
+                PrefetchWindow(
+                    first = first,
+                    last = last,
+                    count = count,
+                    scrolling = PanoramaCoverShapes.anyGridScrolling,
+                    tick = compositionTick.intValue + finishedTick.intValue,
+                    ids = ids,
+                )
+            }.collect { window ->
+                val span = max(window.last - window.first + 1, PREFETCH_AHEAD)
+                val behind = window.first - span
+                val stale = inFlight.entries.filter { it.value.index < behind }
+                for ((id, slot) in stale) {
+                    inFlight.remove(id)
+                    slot.disposable.dispose()
+                }
+                if (window.scrolling) return@collect
+                val end = minOf(window.count, window.last + PREFETCH_AHEAD + 1)
+                var index = window.first
+                while (index < end && inFlight.size < PREFETCH_MAX_IN_FLIGHT) {
+                    val manga = currentMangaAt(index)
+                    val at = index
+                    index++
+                    if (manga == null || manga.thumbnailUrl.isNullOrEmpty()) continue
+                    val mangaId = manga.id
+                    if (mangaId in inFlight || mangaId in finished) continue
+                    if (PanoramaCoverShapes.get(mangaId) != null) {
+                        finished.add(mangaId)
+                        continue
+                    }
+                    inFlight[mangaId] = PrefetchInFlight(
+                        index = at,
+                        disposable = loader.enqueue(
+                            ImageRequest.Builder(context)
+                                .data(manga.asMangaCover())
+                                .memoryCachePolicy(CachePolicy.DISABLED)
+                                .allowHardware(false)
+                                .decoderCoroutineContext(Dispatchers.IO)
+                                .decoderFactory(PanoramaCoverBoundsDecoder.Factory(mangaId))
+                                .listener(
+                                    onSuccess = { _, _ ->
+                                        val stored = PanoramaCoverShapes.get(mangaId) != null
+                                        complete(mangaId, stored = stored, attempted = true)
+                                    },
+                                    onError = { _, _ ->
+                                        complete(mangaId, stored = false, attempted = true)
+                                    },
+                                    onCancel = { complete(mangaId, stored = false, attempted = false) },
+                                )
+                                .build(),
+                        ),
+                    )
+                }
+            }
+        } finally {
+            inFlight.values.forEach { it.disposable.dispose() }
+            inFlight.clear()
+        }
+    }
+}
+
+private class PrefetchInFlight(
+    val index: Int,
+    val disposable: Disposable,
+)
+
+private data class PrefetchWindow(
+    val first: Int,
+    val last: Int,
+    val count: Int,
+    val scrolling: Boolean,
+    val tick: Int,
+    val ids: List<Long>,
+)
+
+/**
+ * Coil inserts [ImageRequest.Builder.decoderFactory] at the front of the decoder list, ahead of
+ * [eu.kanade.tachiyomi.data.coil.ImageDecoder] and [coil3.decode.BitmapFactoryDecoder]. [decode]
+ * always returns an image, so those decoders never run for this request and the loader's 3-wide
+ * decoder dispatcher is not used ([decoderCoroutineContext] is [Dispatchers.IO]).
+ * A header BitmapFactory cannot read (AVIF, JXL) is left unknown; the visible load learns it.
+ */
+private class PanoramaCoverBoundsDecoder(
+    private val source: ImageSource,
+    private val mangaId: Long,
+) : Decoder {
+
+    override suspend fun decode(): DecodeResult {
+        val ratio = try {
+            headerRatio(source)
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            null
+        }
+        if (ratio != null) {
+            // Stored before the request listener runs. The layout epoch is still posted to the owner.
+            PanoramaCoverShapes.put(mangaId, ratio)
+        }
+        // isSampled so this 1x1 image can never satisfy a memory-cache lookup for a real cover.
+        return DecodeResult(image = boundsPlaceholder.value, isSampled = true)
+    }
+
+    class Factory(
+        private val mangaId: Long,
+    ) : Decoder.Factory {
+        override fun create(
+            result: SourceFetchResult,
+            options: Options,
+            imageLoader: ImageLoader,
+        ): Decoder = PanoramaCoverBoundsDecoder(result.source, mangaId)
+    }
+}
+
+private fun headerRatio(imageSource: ImageSource): Float? {
+    val options = BitmapFactory.Options()
+    options.inJustDecodeBounds = true
+    // file() copies a non-file source to a temp file. decodeStream on the okio stream cannot
+    // mark/reset, so BitmapFactory would report no bounds.
+    val file = imageSource.file()
+    BitmapFactory.decodeFile(file.toString(), options)
+    val width = options.outWidth
+    val height = options.outHeight
+    if (width <= 0 || height <= 0) return null
+    val ratio = height.toFloat() / width.toFloat()
+    if (ratio <= 0f || ratio.isNaN() || ratio.isInfinite()) return null
+    return ratio
+}
+
+private val boundsPlaceholder = lazy { ColorImage(width = 1, height = 1) }
+
 private const val SETTLE_DELAY_MILLIS = 300L
 private const val PREFETCH_SIZE_PX = 128
+private const val PREFETCH_AHEAD = 30
+private const val PREFETCH_MAX_IN_FLIGHT = 2
+
+/** First try plus one retry. A permanent miss stops; a single network miss does not. */
+private const val PREFETCH_MAX_ATTEMPTS = 2
 // Harmony <--
