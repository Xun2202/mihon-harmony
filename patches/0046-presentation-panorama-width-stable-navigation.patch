@@ -0,0 +1,75 @@
+package tachiyomi.presentation.core.components
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+
+class PanoramaAutoColumnsTest {
+    @Test
+    fun `wide covers keep two columns until the available width fits three readable lanes`() {
+        val expected = listOf(
+            220 to 1,
+            320 to 2,
+            360 to 2,
+            420 to 2,
+            459 to 2,
+            600 to 2,
+            664 to 2,
+            720 to 3,
+            840 to 3,
+            939 to 3,
+            1200 to 4,
+        )
+        var previous = 0
+        for ((width, lanes) in expected) {
+            val actual = shapedLanes(width, 800, 2f / 3f)
+            assertEquals(lanes, actual, "width=$width")
+            assertTrue(actual >= previous, "adding width must not remove a lane at $width dp")
+            previous = actual
+        }
+    }
+
+    @Test
+    fun `tall covers keep three columns on ordinary compact widths`() {
+        assertEquals(2, shapedLanes(320, 800, 1.5f))
+        for (width in listOf(360, 420, 459)) {
+            assertEquals(3, shapedLanes(width, 800, 1.5f), "width=$width")
+        }
+    }
+
+    @Test
+    fun `changing grid height or boundedness does not change columns`() {
+        for (width in listOf(459, 664, 939)) {
+            for (shape in listOf(1.5f, 2f / 3f)) {
+                val expected = shapedLanes(width, 800, shape)
+                assertEquals(expected, shapedLanes(width, 100, shape), "short height width=$width shape=$shape")
+                assertEquals(
+                    expected,
+                    shapedLanes(width, 9_999, shape, heightBounded = false),
+                    "unbounded height width=$width shape=$shape",
+                )
+            }
+        }
+    }
+
+    @Test
+    fun `density scaling preserves counts and narrow lanes are rejected`() {
+        for (width in listOf(320, 459, 664, 939, 1200)) {
+            for (shape in listOf(1.5f, 2f / 3f)) {
+                val expected = shapedLanes(width, 800, shape)
+                assertEquals(
+                    expected,
+                    panoramaShapedLaneCount(width * 2, 100, 32, 8, shape, 2f, heightBounded = true),
+                    "width=$width shape=$shape",
+                )
+            }
+        }
+        // 220 - 16 dp padding leaves 204 dp: two lanes would be 100 dp, below the 104 dp floor.
+        assertEquals(1, shapedLanes(220, 800, 2f / 3f))
+        assertEquals(1, shapedLanes(220, 800, 1.5f))
+    }
+
+    private fun shapedLanes(width: Int, height: Int, shape: Float, heightBounded: Boolean = true): Int {
+        return panoramaShapedLaneCount(width, height, 16, 4, shape, 1f, heightBounded)
+    }
+}
