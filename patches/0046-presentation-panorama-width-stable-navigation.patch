-     * smaller count, and a column narrower than 104 dp is not a candidate.
-     * [minLane] wider than that 104 dp floor caps the count, so the lane stays at least that wide.
+     * for a wide one. Count follows available width and readable cover dimensions, so changing
+     * viewport height as navigation bars appear or hide does not change the number of lanes.
+     * A lane stays at least 104 dp wide; wide covers use at least two lanes when both can fit.
+     * [minLane] may raise that floor and cap the count for a roomier shelf.
      */
     data class Shaped(
         val heightOverWidth: Float,
@@ -811,7 +807,7 @@ private fun LazyLayoutMeasureScope.measureMasonry(
