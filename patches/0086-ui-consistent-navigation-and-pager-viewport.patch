+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.MutatePriority
+import androidx.compose.foundation.pager.PagerState
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.layout.onSizeChanged
+import kotlin.math.abs
+
+/** End an old-width drag before aligning its nearest page; height-only changes preserve gestures. */
+@Composable
+fun Modifier.settlePagerOnWidthChange(state: PagerState): Modifier {
+    var width by remember(state) { mutableIntStateOf(0) }
+    val previous = remember(state) { intArrayOf(0) }
+    LaunchedEffect(state, width) {
+        if (width == 0) return@LaunchedEffect
+        val resized = previous[0] != 0 && previous[0] != width
+        val restoredPartialPage = previous[0] == 0 && abs(state.currentPageOffsetFraction) > 0.001f
+        previous[0] = width
+        if ((!resized && !restoredPartialPage) || state.pageCount == 0) return@LaunchedEffect
+        with(state) {
+            // UserInput outranks default scrollToPage. Cancel that mutation before snapping.
+            scroll(MutatePriority.PreventUserInput) {
+                val count = pageCount
+                if (count > 0) updateCurrentPage(currentPage.coerceIn(0, count - 1), 0f)
+            }
+        }
+    }
+    return onSizeChanged { width = it.width }
+}
