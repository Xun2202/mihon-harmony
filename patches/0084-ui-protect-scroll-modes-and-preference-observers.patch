+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.gestures.FlingBehavior
+import androidx.compose.foundation.gestures.ScrollScope
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.PaddingValues
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.layout.requiredSize
+import androidx.compose.foundation.lazy.grid.GridCells
+import androidx.compose.foundation.lazy.grid.rememberLazyGridState
+import androidx.compose.foundation.lazy.rememberLazyListState
+import androidx.compose.foundation.lazy.staggeredgrid.rememberLazyStaggeredGridState
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.runtime.MonotonicFrameClock
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.withFrameNanos
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.performTouchInput
+import androidx.compose.ui.test.runComposeUiTest
+import androidx.compose.ui.test.swipeDown
+import androidx.compose.ui.test.swipeUp
+import androidx.compose.ui.unit.dp
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.runBlocking
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertSame
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromeScrollModesTest {
+    @Test
+    fun `plain list supports filtering and viewport changes`() = assertAdaptiveScrolling(0)
+
+    @Test
+    fun `fast list supports filtering and viewport changes`() = assertAdaptiveScrolling(1)
+
+    @Test
+    fun `compact grid supports filtering and viewport changes`() = assertAdaptiveScrolling(2)
+
+    @Test
+    fun `timeline supports filtering and viewport changes`() = assertAdaptiveScrolling(3)
+
+    @Test
+    fun `scroll state supports short and empty filtered content`() = assertAdaptiveScrolling(4)
+
+    private fun assertAdaptiveScrolling(mode: Int) = runComposeUiTest {
+        val count = mutableIntStateOf(400)
+        val stride = mutableIntStateOf(1)
+        val width = mutableIntStateOf(320)
+        lateinit var offset: () -> Int
+        lateinit var moving: () -> Boolean
+        setContent {
+            val list = rememberLazyListState()
+            val grid = rememberLazyGridState()
+            val timeline = rememberLazyStaggeredGridState()
+            val scroll = rememberScrollState()
+            val columns = if (width.intValue > 400) 3 else 2
+            val modifier = Modifier.requiredSize(width.intValue.dp, 480.dp).testTag("scroll")
+            val item: @androidx.compose.runtime.Composable () -> Unit = { Box(Modifier.fillMaxWidth().height(72.dp)) }
+            offset = {
+                when (mode) {
+                    0, 1 -> list.firstVisibleItemIndex * 1000 + list.firstVisibleItemScrollOffset
+                    2 -> grid.firstVisibleItemIndex * 1000 + grid.firstVisibleItemScrollOffset
+                    3 -> timeline.firstVisibleItemIndex * 1000 + timeline.firstVisibleItemScrollOffset
+                    else -> scroll.value
+                }
+            }
+            moving = {
+                when (mode) {
+                    0, 1 -> list.isScrollInProgress
+                    2 -> grid.isScrollInProgress
+                    3 -> timeline.isScrollInProgress
+                    else -> scroll.isScrollInProgress
+                }
+            }
+            when (mode) {
+                0 -> ScrollbarLazyColumn(modifier = modifier, state = list) {
+                    items(count.intValue, key = { it * stride.intValue }) { item() }
+                }
+                1 -> FastScrollLazyColumn(modifier = modifier, state = list) {
+                    items(count.intValue, key = { it * stride.intValue }) { item() }
+                }
+                2 -> FastScrollLazyVerticalGrid(columns = GridCells.Fixed(columns), modifier = modifier, state = grid) {
+                    items(count.intValue, key = { it * stride.intValue }) { item() }
+                }
+                3 -> TimelineGrid(
+                    count = count.intValue,
+                    key = { it * stride.intValue },
+                    fullLine = { it % 21 == 0 },
+                    columns = columns,
+                    minColumnWidth = 120.dp,
+                    contentPadding = PaddingValues(0.dp),
+                    modifier = modifier,
+                    state = timeline,
+                ) { item() }
+                else -> Column(modifier.verticalScroll(scroll, flingBehavior = rememberFrameTimeProtectedFlingBehavior())) {
+                    repeat(count.intValue) { item() }
+                }
+            }
+        }
+        fun swipe(up: Boolean) {
+            onNodeWithTag("scroll").performTouchInput {
+                if (up) swipeUp(durationMillis = 180) else swipeDown(durationMillis = 180)
+            }
+            waitForIdle()
+            runOnIdle { assertFalse(moving(), "mode=$mode left scrolling") }
+        }
+        swipe(true)
+        runOnIdle {
+            assertTrue(offset() > 0, "mode=$mode did not move")
+            count.intValue = 160
+            stride.intValue = 2
+            width.intValue = 600
+        }
+        waitForIdle()
+        swipe(true)
+        var wide = 0
+        runOnIdle {
+            wide = offset()
+            assertTrue(wide > 0)
+        }
+        swipe(false)
+        runOnIdle { assertTrue(offset() < wide, "mode=$mode reverse fling did not move") }
+        runOnIdle { width.intValue = 320 }
+        waitForIdle()
+        swipe(true)
+        runOnIdle { count.intValue = 0 }
+        waitForIdle()
+        swipe(true)
+        runOnIdle {
+            assertEquals(0, offset())
+            count.intValue = 1
+        }
+        waitForIdle()
+        swipe(true)
+        runOnIdle {
+            assertEquals(0, offset())
+            count.intValue = 400
+            stride.intValue = 1
+        }
+        waitForIdle()
+        swipe(true)
+        runOnIdle { assertTrue(offset() > 0, "mode=$mode failed to resume after empty content") }
+    }
+
+    @Test
+    fun `generic fling guard repairs repeated stamps and forwards scope velocity and remaining velocity`() = runComposeUiTest {
+        lateinit var guarded: FlingBehavior
+        lateinit var seenScope: ScrollScope
+        val velocities = mutableListOf<Float>()
+        val times = mutableListOf<Long>()
+        val native = object : FlingBehavior {
+            override suspend fun ScrollScope.performFling(initialVelocity: Float): Float {
+                seenScope = this
+                velocities += initialVelocity
+                times += withFrameNanos { it }
+                times += withFrameNanos { it }
+                scrollBy(initialVelocity / 10f)
+                return initialVelocity / 2f
+            }
+        }
+        setContent { guarded = rememberFrameTimeProtectedFlingBehavior(native) }
+        runOnIdle {
+            val parent = object : MonotonicFrameClock {
+                override suspend fun <R> withFrameNanos(onFrame: (Long) -> R): R = onFrame(1_000_000_000L)
+            }
+            val consumed = mutableListOf<Float>()
+            val scroll = object : ScrollScope {
+                override fun scrollBy(pixels: Float): Float {
+                    consumed += pixels
+                    return pixels
+                }
+            }
+            runBlocking(parent) {
+                assertEquals(500f, with(guarded) { scroll.performFling(1000f) })
+                assertSame(scroll, seenScope)
+                assertSame(parent, currentCoroutineContext()[MonotonicFrameClock])
+                assertEquals(-200f, with(guarded) { scroll.performFling(-400f) })
+            }
+            assertEquals(listOf(1000f, -400f), velocities)
+            assertEquals(listOf(100f, -40f), consumed)
+            assertEquals(times[0], times[2], "each new fling must start from its native clock")
+            assertTrue(times[1] > times[0] && times[3] > times[2], "repeated stamps were not repaired")
+        }
+    }
+}
