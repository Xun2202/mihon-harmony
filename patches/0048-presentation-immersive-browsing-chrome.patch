+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.TopAppBarScrollBehavior
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.v2.runComposeUiTest
+import androidx.compose.ui.unit.dp
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.LEGACY)
+@Config(sdk = [34])
+class NavigationChromeLayoutTest {
+    @Test
+    fun `toolbar inset and body tabs collapse without leaving a strip and restore together`() = runComposeUiTest {
+        lateinit var behavior: TopAppBarScrollBehavior
+        setContent {
+            MaterialTheme {
+                behavior = rememberBrowsingTopAppBarScrollBehavior()
+                Scaffold(
+                    topBarScrollBehavior = behavior,
+                    // Deliberately nonzero: collapsed content must not inherit this top gap.
+                    contentWindowInsets = WindowInsets(0, 24, 0, 16),
+                    topBar = { Box(Modifier.height(80.dp)) },
+                ) { padding ->
+                    Column(Modifier.fillMaxSize().padding(top = padding.calculateTopPadding())) {
+                        BrowsingNavigationChrome { Box(Modifier.height(48.dp)) }
+                        Box(Modifier.fillMaxSize().testTag("content"))
+                    }
+                }
+            }
+        }
+        waitForIdle()
+        val expandedTop = onNodeWithTag("content").fetchSemanticsNode().boundsInRoot.top
+        assertTrue(expandedTop > 0f)
+        runOnIdle { behavior.state.heightOffset = behavior.state.heightOffsetLimit }
+        waitForIdle()
+        assertEquals(0f, onNodeWithTag("content").fetchSemanticsNode().boundsInRoot.top, 1f)
+        runOnIdle { behavior.state.heightOffset = 0f }
+        waitForIdle()
+        assertEquals(expandedTop, onNodeWithTag("content").fetchSemanticsNode().boundsInRoot.top, 1f)
+    }
+}
