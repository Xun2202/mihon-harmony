+        connection.onPostScroll(Offset(0f, -40f), Offset.Zero, NestedScrollSource.UserInput)
+        assertFalse(state.visible)
+        connection.onPreScroll(Offset(0f, 1f), NestedScrollSource.SideEffect)
+        assertFalse(state.visible)
+        connection.onPreScroll(Offset(5f, 0f), NestedScrollSource.UserInput)
+        assertFalse(state.visible)
+        assertEquals(Offset.Zero, connection.onPreScroll(Offset(0f, 1f), NestedScrollSource.UserInput))
+        connection.onPostScroll(Offset.Zero, Offset.Zero, NestedScrollSource.UserInput)
+        assertTrue(state.visible)
+    }
