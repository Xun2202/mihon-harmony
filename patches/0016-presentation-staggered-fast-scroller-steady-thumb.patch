@@ -606,22 +611,78 @@ private class StaggeredGridEstimate(
     val scrollRange: Float,
 )
 
-private fun estimateStaggeredGrid(state: LazyStaggeredGridState): StaggeredGridEstimate? {
-    val layoutInfo = state.layoutInfo
-    val visibleItems = layoutInfo.visibleItemsInfo
-    if (visibleItems.isEmpty() || layoutInfo.totalItemsCount == 0) return null
-
-    val laneCount = (visibleItems.maxOf { it.lane } + 1).coerceAtLeast(1)
-    val rowHeight = visibleItems.sumOf { it.size.height }.toFloat() / visibleItems.size +
-        layoutInfo.mainAxisItemSpacing
-    if (rowHeight <= 0f) return null
-
-    val firstChild = visibleItems.minBy { it.index }
-    val rowsBefore = firstChild.index / laneCount
-    val scrollOffset = rowsBefore * rowHeight - firstChild.offset.y + layoutInfo.beforeContentPadding
-    val totalRows = (layoutInfo.totalItemsCount + laneCount - 1) / laneCount
-    val scrollRange = totalRows * rowHeight + layoutInfo.beforeContentPadding + layoutInfo.afterContentPadding
-    return StaggeredGridEstimate(laneCount, rowHeight, scrollOffset, scrollRange)
+/**
+ * Heights seen so far, kept on the grid state so the average does not follow whichever mix of
+ * 3:2 and 2:3 cells happens to be on screen.
+ */
+private class StaggeredGridMeasurements {
+    val heights = HashMap<Int, Int>()
+    var heightSum = 0L
+    var laneCount = 1
+}
+
+@Composable
+private fun rememberStaggeredGridEstimate(state: LazyStaggeredGridState): State<StaggeredGridEstimate> {
+    val measurements = remember(state) { StaggeredGridMeasurements() }
+    return remember(state) {
+        derivedStateOf {
+            val layoutInfo = state.layoutInfo
+            val visibleItems = layoutInfo.visibleItemsInfo
+            // LazyStaggeredGridItemInfo does not expose the span; a full-line row (search bar,
+            // section header) is recognised by being wider than a lane cell.
+            val laneWidth = visibleItems.minOfOrNull { it.size.width } ?: 0
+            visibleItems.fastForEach { item ->
+                val lanes = item.lane + 1
+                if (lanes > measurements.laneCount) measurements.laneCount = lanes
+                if (laneWidth > 0 && item.size.width > laneWidth * 3 / 2) {
+                    measurements.heights.remove(item.index)?.let { measurements.heightSum -= it }
+                    return@fastForEach
+                }
+                val height = item.size.height
+                val previous = measurements.heights.put(item.index, height)
+                if (previous == null) {
+                    measurements.heightSum += height
+                } else if (previous != height) {
+                    measurements.heightSum += height - previous
+                }
+            }
+
+            val averageHeight = if (measurements.heights.isNotEmpty()) {
+                measurements.heightSum.toFloat() / measurements.heights.size
+            } else {
+                visibleItems.firstOrNull()?.size?.height?.toFloat() ?: 0f
+            }
+            val laneCount = measurements.laneCount.coerceAtLeast(1)
+            val rowSpacing = layoutInfo.mainAxisItemSpacing
+            val totalItemsCount = layoutInfo.totalItemsCount
+            val first = visibleItems.firstOrNull()
+            var beforeFirst = 0f
+            var beforeAll = 0f
+            for (index in 0 until totalItemsCount) {
+                if (first != null && index == first.index) beforeFirst = beforeAll
+                beforeAll += measurements.heights[index]?.toFloat() ?: averageHeight
+            }
+
+            // offset.y is relative to the content start (negative once the item has scrolled off
+            // the top); beforeContentPadding is applied only at placement, so a grid at rest
+            // reports scroll offset 0 and the padding belongs to the range only.
+            val scrollOffset = if (first == null) {
+                0f
+            } else {
+                beforeFirst / laneCount + rowSpacing * (first.index / laneCount) - first.offset.y
+            }
+            val scrollRange = beforeAll / laneCount +
+                rowSpacing * ceil(totalItemsCount.toFloat() / laneCount) +
+                layoutInfo.beforeContentPadding +
+                layoutInfo.afterContentPadding
+            StaggeredGridEstimate(
+                laneCount = laneCount,
+                rowHeight = averageHeight + rowSpacing,
+                scrollOffset = scrollOffset,
+                scrollRange = scrollRange,
+            )
+        }
+    }
 }
