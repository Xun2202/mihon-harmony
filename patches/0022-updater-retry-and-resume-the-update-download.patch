+package eu.kanade.tachiyomi.data.updater
+
+import com.sun.net.httpserver.HttpExchange
+import com.sun.net.httpserver.HttpServer
+import eu.kanade.tachiyomi.network.HttpException
+import io.kotest.assertions.throwables.shouldThrow
+import io.kotest.matchers.collections.shouldBeEmpty
+import io.kotest.matchers.shouldBe
+import kotlinx.coroutines.runBlocking
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import org.junit.jupiter.api.Test
+import java.io.File
+import java.net.InetSocketAddress
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+class AppUpdateApkDownloaderTest {
+
+    private val client = OkHttpClient.Builder()
+        .protocols(listOf(Protocol.HTTP_1_1))
+        .connectTimeout(5, TimeUnit.SECONDS)
+        .readTimeout(5, TimeUnit.SECONDS)
+        .callTimeout(15, TimeUnit.SECONDS)
+        .retryOnConnectionFailure(false)
+        .build()
+
+    @Test
+    fun `resumes after the connection drops halfway`() = runBlocking<Unit> {
+        val data = ByteArray(80_000) { (it * 31).toByte() }
+        val half = data.size / 2
+        val ranges = mutableListOf<String?>()
+        val hits = AtomicInteger()
+        val server = server { exchange ->
+            val attempt = hits.incrementAndGet()
+            if (attempt == 1) {
+                exchange.sendResponseHeaders(200, data.size.toLong())
+                exchange.responseBody.use { it.write(data, 0, half) }
+            } else {
+                val range = exchange.requestHeaders.getFirst("Range")
+                ranges += range
+                val start = range!!.removePrefix("bytes=").substringBefore('-').toInt()
+                val rest = data.size - start
+                exchange.responseHeaders.add("Content-Range", "bytes $start-${data.size - 1}/${data.size}")
+                exchange.sendResponseHeaders(206, rest.toLong())
+                exchange.responseBody.use { it.write(data, start, rest) }
+            }
+        }
+        val file = File.createTempFile("update", ".apk")
+        val delays = mutableListOf<Long>()
+        val progress = mutableListOf<Int>()
+        try {
+            downloader(delays).download(url(server), file) { progress += it }
+            ranges.single() shouldBe "bytes=$half-"
+            file.readBytes().contentEquals(data) shouldBe true
+            delays shouldBe listOf(2_000L)
+            hits.get() shouldBe 2
+            progress.zipWithNext().all { (previous, next) -> next >= previous } shouldBe true
+        } finally {
+            file.delete()
+            server.stop(0)
+        }
+    }
+
+    @Test
+    fun `starts over after 416`() = runBlocking<Unit> {
+        val data = ByteArray(4_096) { it.toByte() }
+        val ranges = mutableListOf<String?>()
+        val server = server { exchange ->
+            val range = exchange.requestHeaders.getFirst("Range")
+            ranges += range
+            if (range != null) {
+                exchange.sendResponseHeaders(416, -1)
+            } else {
+                exchange.sendResponseHeaders(200, data.size.toLong())
+                exchange.responseBody.use { it.write(data) }
+            }
+        }
+        val file = File.createTempFile("update", ".apk")
+        file.writeBytes(ByteArray(100) { 7 })
+        val delays = mutableListOf<Long>()
+        try {
+            downloader(delays).download(url(server), file)
+            ranges shouldBe listOf("bytes=100-", null)
+            file.readBytes().contentEquals(data) shouldBe true
+            delays shouldBe listOf(2_000L)
+        } finally {
+            file.delete()
+            server.stop(0)
+        }
+    }
+
+    @Test
+    fun `fails immediately on 404`() = runBlocking<Unit> {
+        val hits = AtomicInteger()
+        val server = server { exchange ->
+            hits.incrementAndGet()
+            exchange.sendResponseHeaders(404, -1)
+        }
+        val file = File.createTempFile("update", ".apk")
+        val delays = mutableListOf<Long>()
+        try {
+            val error = shouldThrow<HttpException> {
+                downloader(delays).download(url(server), file)
+            }
+            error.code shouldBe 404
+            hits.get() shouldBe 1
+            delays.shouldBeEmpty()
+            file.exists() shouldBe false
+        } finally {
+            file.delete()
+            server.stop(0)
+        }
+    }
+
+    private fun downloader(delays: MutableList<Long>) = AppUpdateApkDownloader(client) { millis ->
+        delays += millis
+    }
+
+    private fun url(server: HttpServer) = "http://127.0.0.1:${server.address.port}/apk"
+
+    private fun server(handler: (HttpExchange) -> Unit): HttpServer {
+        val http = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        http.createContext("/apk") { exchange ->
+            try {
+                handler(exchange)
+            } finally {
+                exchange.close()
+            }
+        }
+        http.executor = Executors.newCachedThreadPool { runnable ->
+            Thread(runnable, "apk-update-test").apply { isDaemon = true }
+        }
+        http.start()
+        return http
+    }
+}
