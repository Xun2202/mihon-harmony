+/**
+ * Downloads one update APK. The shared [eu.kanade.tachiyomi.network.NetworkHelper] client is not
+ * modified; pass a client built for this download.
+ */
+class AppUpdateApkDownloader(
+    private val client: OkHttpClient,
+    private val retryDelay: suspend (millis: Long) -> Unit = { delay(it) },
+) {
+
+    suspend fun download(
+        url: String,
+        apkFile: File,
+        onProgress: (percent: Int) -> Unit = {},
+    ) {
+        // Harmony: the first connection from mainland China to the GitHub release CDN often stalls
+        // or is reset after it connects. OkHttp does not retry that read inside one call.
+        var highWater = 0
+        fun report(bytesRead: Long, contentLength: Long) {
+            if (contentLength <= 0L) return
+            val percent = ((bytesRead * 100) / contentLength).toInt().coerceIn(0, 100)
+            if (percent > highWater) {
+                highWater = percent
+                onProgress(percent)
+            }
+        }
+
+        var lastError: Exception? = null
+        for (attempt in 1..MAX_ATTEMPTS) {
+            currentCoroutineContext().ensureActive()
+            try {
+                downloadOnce(url, apkFile, ::report)
+                return
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: HttpException) {
+                logcat(LogPriority.WARN, e) { "Update download attempt $attempt failed" }
+                lastError = e
+                if (e.code == HTTP_RANGE_NOT_SATISFIABLE) {
+                    apkFile.delete()
+                } else if (e.code !in 500..599) {
+                    apkFile.delete()
+                    throw e
+                }
+                if (attempt == MAX_ATTEMPTS) break
+                retryDelay(backoffMillis(attempt))
+            } catch (e: IOException) {
+                // A cancelled read surfaces as IOException("Canceled"); do not treat that as a failure.
+                currentCoroutineContext().ensureActive()
+                logcat(LogPriority.WARN, e) { "Update download attempt $attempt failed" }
+                lastError = e
+                if (attempt == MAX_ATTEMPTS) break
+                retryDelay(backoffMillis(attempt))
+            }
+        }
+        apkFile.delete()
+        throw lastError ?: IOException("Update download failed")
+    }
+
+    private suspend fun downloadOnce(
+        url: String,
+        apkFile: File,
+        onProgress: (bytesRead: Long, contentLength: Long) -> Unit,
+    ) {
+        val existingSize = if (apkFile.exists()) apkFile.length() else 0L
+        val listener = object : ProgressListener {
+            override fun update(bytesRead: Long, contentLength: Long, done: Boolean) {
+                onProgress(bytesRead, contentLength)
+            }
+        }
+        client.newCachelessCallWithProgress(GET(url), listener, existingSize).await().use { response ->
+            val code = response.code
+            if (code == HTTP_RANGE_NOT_SATISFIABLE || code !in 200..299) {
+                throw HttpException(code)
+            }
+            // 206 keeps the bytes already on disk; 200 replaces them.
+            writeToFile(apkFile, response, append = code == 206)
+        }
+    }
+
+    private fun writeToFile(apkFile: File, response: Response, append: Boolean) {
+        apkFile.parentFile?.mkdirs()
+        val fileStream = try {
+            FileOutputStream(apkFile, append)
+        } catch (e: IOException) {
+            throw StorageWriteException(e)
+        }
+        response.body.source().saveTo(StorageMarkingStream(fileStream))
+    }
+
+    private companion object {
+        const val MAX_ATTEMPTS = 4
+        const val HTTP_RANGE_NOT_SATISFIABLE = 416
+
+        fun backoffMillis(failedAttempt: Int): Long = 2_000L shl (failedAttempt - 1)
+    }
+}
+
+/** Disk write failed. Retried like any other [IOException], then reported separately from network errors. */
+internal class StorageWriteException(cause: IOException) : IOException(cause)
+
+private class StorageMarkingStream(private val out: OutputStream) : OutputStream() {
+    override fun write(b: Int) = guard { out.write(b) }
+
+    override fun write(b: ByteArray, off: Int, len: Int) = guard { out.write(b, off, len) }
+
+    override fun flush() = guard { out.flush() }
+
+    override fun close() = guard { out.close() }
+
+    private inline fun guard(block: () -> Unit) {
+        try {
+            block()
+        } catch (e: IOException) {
+            throw StorageWriteException(e)
+        }
+    }
+}
