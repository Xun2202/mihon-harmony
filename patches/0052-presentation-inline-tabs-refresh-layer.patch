+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.LEGACY)
+@Config(sdk = [34])
+class NavigationChromeRefreshTest {
+    @Test
+    fun `five compact items keep large counters within their own bounds at larger font size`() = runComposeUiTest {
+        val badges = Array(5) { Rect.Zero }
+        val icons = Array(5) { Rect.Zero }
+        val items = Array(5) { Rect.Zero }
+        var density = 1f
+        setContent {
+            density = LocalDensity.current.density
+            CompositionLocalProvider(LocalDensity provides Density(density, fontScale = 1.3f)) {
+                MaterialTheme {
+                    Box(Modifier.width(360.dp)) {
+                        BrowsingChromeOverlay(
+                            state = rememberBrowsingNavigationBarState(enabled = false, resetKey = Unit),
+                            atBottom = true,
+                            modifier = Modifier.testTag("bar"),
+                        ) {
+                            CompactNavigationBar(windowInsets = WindowInsets(0)) {
+                                repeat(5) { index ->
+                                    CompactNavigationBarItem(
+                                        modifier = Modifier.onGloballyPositioned {
+                                            val origin = it.positionInRoot()
+                                            items[index] =
+                                                Rect(
+                                                    origin.x,
+                                                    origin.y,
+                                                    origin.x + it.size.width,
+                                                    origin.y + it.size.height,
+                                                )
+                                        },
+                                        selected = index == 0,
+                                        onClick = {},
+                                        label = "Tab$index",
+                                        showLabel = true,
+                                        icon = {
+                                            Box(
+                                                Modifier.size(24.dp).onGloballyPositioned {
+                                                    val origin = it.positionInRoot()
+                                                    icons[index] =
+                                                        Rect(
+                                                            origin.x,
+                                                            origin.y,
+                                                            origin.x + it.size.width,
+                                                            origin.y + it.size.height,
+                                                        )
+                                                },
+                                            )
+                                        },
+                                        badge = {
+                                            Badge(
+                                                Modifier.onGloballyPositioned {
+                                                    val origin = it.positionInRoot()
+                                                    badges[index] =
+                                                        Rect(
+                                                            origin.x,
+                                                            origin.y,
+                                                            origin.x + it.size.width,
+                                                            origin.y + it.size.height,
+                                                        )
+                                                },
+                                            ) { Text("999") }
+                                        },
+                                    )
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        waitForIdle()
+        val bar = onNodeWithTag("bar").fetchSemanticsNode().boundsInRoot
+        assertEquals(56f * density, bar.height, 1f)
+        repeat(5) { index ->
+            val item = items[index]
+            val badge = badges[index]
+            assertTrue(badge.height > 0f && badge.top >= item.top && badge.bottom <= item.bottom)
+            assertTrue(badge.left >= item.left && badge.right <= item.right)
+            assertEquals(item.center.x, icons[index].center.x, 1f)
+            val label = onNodeWithText("Tab$index", useUnmergedTree = true).fetchSemanticsNode().boundsInRoot
+            assertEquals(icons[index].center.x, label.center.x, 1f)
+            assertTrue(badge.bottom <= icons[index].top + 6f * density, "Badge only overlaps the icon's upper corner")
+        }
+    }
+
+    @Test
+    fun `default refresh indicator clears toolbar even inside an inset container`() = runComposeUiTest {
+        var toolbarBottom = 0f
+        setContent {
+            MaterialTheme {
+                Scaffold(
+                    contentWindowInsets = WindowInsets(0),
+                    topBar = {
+                        Box(
+                            Modifier.fillMaxWidth().height(100.dp).onGloballyPositioned {
+                                toolbarBottom = it.positionInRoot().y + it.size.height
+                            },
+                        )
+                    },
+                ) {
+                    Box(Modifier.fillMaxSize().padding(top = 30.dp)) {
+                        PullRefresh(refreshing = true, enabled = true, onRefresh = {}) {
+                            Box(Modifier.fillMaxSize())
+                        }
+                    }
+                }
+            }
+        }
+        waitForIdle()
+        val indicator = onNode(hasProgressBarRangeInfo(ProgressBarRangeInfo.Indeterminate))
+            .fetchSemanticsNode().boundsInRoot
+        assertTrue(indicator.height > 0f && indicator.top >= toolbarBottom)
+    }
+
+    @Test
+    fun `explicit detail refresh inset is preserved`() = runComposeUiTest {
+        var minimumTop = 0f
+        setContent {
+            minimumTop = with(LocalDensity.current) { 180.dp.toPx() }
+            MaterialTheme {
+                PullRefresh(
+                    refreshing = true,
+                    enabled = true,
+                    onRefresh = {},
+                    indicatorPadding = PaddingValues(top = 180.dp),
+                ) { Box(Modifier.fillMaxSize()) }
+            }
+        }
+        waitForIdle()
+        val indicator = onNode(hasProgressBarRangeInfo(ProgressBarRangeInfo.Indeterminate))
+            .fetchSemanticsNode().boundsInRoot
+        assertTrue(indicator.height > 0f && indicator.top >= minimumTop)
+    }
+}
