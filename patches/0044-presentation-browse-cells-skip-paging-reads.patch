 }
 
+/** Band for a paging slot whose manga has not arrived yet. */
+internal fun committedCoverIsWide(mangaId: Long?): Boolean {
+    return if (mangaId == null) {
+        PanoramaCoverShapes.placeholderRatio <= RATIO_SWITCH_TO_PANORAMA
+    } else {
+        committedCoverIsWide(mangaId)
+    }
+}
