+    @Test
+    fun `getIndex uses a map built once per interval content`() {
+        val state = PanoramaMasonryState()
+        var keyCalls = 0
+        val content: PanoramaMasonryScope.() -> Unit = {
+            items(
+                count = 5,
+                key = { index ->
+                    keyCalls++
+                    if (index == 4) "k2" else "k$index"
+                },
+                height = { PanoramaCellHeight.Fixed(0.dp) },
+            ) {
+            }
+        }
+        val provider = state.itemProviderFor(content)
+        assertEquals(5, keyCalls)
+        assertEquals(0, provider.getIndex("k0"))
+        assertEquals(2, provider.getIndex("k2"))
+        assertEquals(-1, provider.getIndex("missing"))
+        assertEquals(5, keyCalls)
+        assertTrue(provider === state.itemProviderFor(content))
+        assertEquals(5, keyCalls)
+
+        val other: PanoramaMasonryScope.() -> Unit = {
+            items(
+                count = 1,
+                key = { "only" },
+                height = { PanoramaCellHeight.Fixed(0.dp) },
+            ) {
+            }
+        }
+        val rebuilt = state.itemProviderFor(other)
+        assertTrue(rebuilt !== provider)
+        assertEquals(0, rebuilt.getIndex("only"))
+        assertEquals(-1, rebuilt.getIndex("k0"))
+    }
