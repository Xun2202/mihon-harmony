+package eu.kanade.presentation.browse.components
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.SideEffect
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.derivedStateOf
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.snapshotFlow
+import androidx.paging.compose.LazyPagingItems
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.collect
+import tachiyomi.domain.manga.model.Manga
+
+internal const val BROWSE_SOURCE_COMFORTABLE = "browse_source_comfortable"
+internal const val BROWSE_SOURCE_COMPACT = "browse_source_compact"
+internal const val BROWSE_SOURCE_LIST = "browse_source_list"
+internal const val BROWSE_SOURCE_LOADING_TYPE = "browse_source_loading"
+
+/**
+ * Ids for the current paging snapshot. The lazy key and the panorama span read this array
+ * instead of calling [LazyPagingItems.peek] on every measure.
+ */
+@Composable
+internal fun rememberBrowseMangaKeys(mangaList: LazyPagingItems<StateFlow<Manga>>): Array<Any> {
+    val snapshot = mangaList.itemSnapshotList
+    return remember(snapshot) {
+        Array(snapshot.size) { index -> snapshot[index]?.value?.id ?: index }
+    }
+}
+
+/**
+ * The manga at [index], without subscribing the cell to the whole paging snapshot.
+ *
+ * [LazyPagingItems.peek] does not ask for the next page. [LazyPagingItems.get] does, and it also
+ * reads the snapshot state. The hint runs from [SideEffect], so a new page does not recompose
+ * this cell unless the row at [index] changed.
+ */
+@Composable
+internal fun presentedBrowseManga(
+    mangaList: LazyPagingItems<StateFlow<Manga>>,
+    index: Int,
+): Manga? {
+    val mangaFlow = remember(mangaList, index) {
+        derivedStateOf { mangaList.peek(index) }
+    }
+    // Harmony: get() is the prefetch hint. Reading it while composing subscribes the cell to every snapshot.
+    SideEffect {
+        if (index in 0 until mangaList.itemCount) mangaList[index]
+    }
+    val flow = mangaFlow.value ?: return null
+    val manga by flow.collectAsState()
+    return manga
+}
+
+/**
+ * Prefetch hint for the far end of a fling.
+ *
+ * The per-cell [SideEffect] in [presentedBrowseManga] only runs for cells that were composed.
+ * A fast fling skips those, so the grid also reports [lastVisibleIndex] whenever it changes.
+ * [LazyPagingItems.get] has to run on the main thread; this effect does.
+ */
+@Composable
+internal fun HintBrowseFarEnd(
+    mangaList: LazyPagingItems<StateFlow<Manga>>,
+    lastVisibleIndex: () -> Int,
+) {
+    LaunchedEffect(mangaList) {
+        snapshotFlow {
+            val count = mangaList.itemCount
+            val last = lastVisibleIndex()
+            last to count
+        }.collect { (last, count) ->
+            if (last in 0 until count) mangaList[last]
+        }
+    }
+}
