         },
     ) { constraints ->
         val measureStart = System.nanoTime()
@@ -1042,6 +1055,11 @@ internal class PanoramaInterval(
 private class PanoramaItemProvider(
     private val intervals: PanoramaIntervalContent,
 ) : LazyLayoutItemProvider {
+    // Harmony: first index of a repeated key, same as the old linear scan. Built once per intervals.
+    private val indexByKey: Map<Any, Int> = buildKeyIndex(intervals)
+
+    fun wraps(content: PanoramaIntervalContent): Boolean = intervals === content
+
     override val itemCount: Int
         get() = intervals.itemCount
 
@@ -1059,10 +1077,16 @@ private class PanoramaItemProvider(
 
     override fun getKey(index: Int): Any = intervals.getKey(index)
 
-    override fun getIndex(key: Any): Int {
-        for (index in 0 until itemCount) {
-            if (getKey(index) == key) return index
-        }
-        return -1
+    override fun getIndex(key: Any): Int = indexByKey[key] ?: -1
+}
+
+private fun buildKeyIndex(intervals: PanoramaIntervalContent): Map<Any, Int> {
+    val count = intervals.itemCount
+    if (count == 0) return emptyMap()
+    val map = HashMap<Any, Int>(count)
+    for (index in 0 until count) {
+        val key = intervals.getKey(index)
+        if (key !in map) map[key] = index
     }
+    return map
 }
