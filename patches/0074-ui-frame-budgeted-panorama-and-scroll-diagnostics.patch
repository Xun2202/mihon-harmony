@@ -0,0 +1,71 @@
+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.lazy.layout.LazyLayoutPrefetchState
+import androidx.compose.ui.unit.Constraints
+
+/** Offscreen composition runs in Compose's frame-budgeted scheduler, never in visible measure. */
+internal class PanoramaMasonryPrefetch {
+    val state = LazyLayoutPrefetchState()
+    private var previousLayout: PanoramaMasonryLayout? = null
+    private var previousKeys: List<Any>? = null
+    private var previousScroll = 0
+    private var forward = true
+    private val candidates = ArrayList<PanoramaMasonryRect>()
+    private val requests = HashMap<Int, Request>()
+
+    private class Request(
+        val width: Int,
+        val height: Int,
+        val handle: LazyLayoutPrefetchState.PrefetchHandle,
+    )
+
+    fun begin(layout: PanoramaMasonryLayout, keys: List<Any>, scroll: Int) {
+        if (layout !== previousLayout || keys !== previousKeys) clear()
+        previousLayout = layout
+        previousKeys = keys
+        if (scroll != previousScroll) forward = scroll > previousScroll
+        previousScroll = scroll
+        candidates.clear()
+    }
+
+    fun offer(rect: PanoramaMasonryRect, top: Int, bottom: Int, start: Int, end: Int, lanes: Int) {
+        // Keep at most one nearby row, on the side the user is approaching.
+        val distance = if (forward) top - end else start - bottom
+        if (distance < 0 || distance > (end - start) / 2 || lanes <= 0) return
+        if (candidates.size < lanes) {
+            candidates.add(rect)
+        } else {
+            val farthest = candidates.indices.maxByOrNull { index ->
+                if (forward) candidates[index].y else -candidates[index].y
+            } ?: return
+            val old = candidates[farthest]
+            if (if (forward) rect.y < old.y else rect.y > old.y) candidates[farthest] = rect
+        }
+    }
+
+    fun submit() {
+        val iterator = requests.iterator()
+        while (iterator.hasNext()) {
+            val (index, request) = iterator.next()
+            val next = candidates.firstOrNull { it.index == index }
+            if (next == null || request.width != next.width || request.height != next.height) {
+                request.handle.cancel()
+                iterator.remove()
+            }
+        }
+        for (rect in candidates) {
+            if (requests.containsKey(rect.index)) continue
+            val handle = state.schedulePrecompositionAndPremeasure(
+                rect.index,
+                Constraints.fixed(rect.width, rect.height),
+            )
+            PanoramaFrameCounters.masonryWork(0L, 0L, 0, 1, 0)
+            requests[rect.index] = Request(rect.width, rect.height, handle)
+        }
+    }
+
+    fun clear() {
+        requests.values.forEach { it.handle.cancel() }
+        requests.clear()
+    }
+}
