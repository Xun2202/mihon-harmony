+
+    private fun diagnosticValue(column: Int, value: Long): String =
+        if (column in T_NAV_NS..T_CELLS_NS) ms(value) else value.toString()
+
+    private fun appendDiagnostics(out: StringBuilder, scope: String, ticks: PerfTable, include: (Int) -> Boolean) {
+        out.append("work_diag scope=").append(scope)
+        val rows = (0 until ticks.rows).filter { include(it) }
+        val arrivals = rows.map { ticks[it, T_ARRIVAL_INTERVAL] }.filter { it > 0L }
+            .toLongArray().also { it.sort() }
+        out.append(" callbacks=").append(rows.size)
+        out.append(" frame_time_nonpositive=").append(
+            rows.count {
+                ticks[it, T_INTERVAL] <= 0L && (ticks[it, T_ARRIVAL_INTERVAL] > 0L || it > 0)
+            },
+        )
+        out.append(" arrival_p90=").append(ms(percentile(arrivals, 90.0)))
+        out.append(" arrival_max=").append(ms(arrivals.lastOrNull() ?: -1L))
+        for ((key, column) in DIAGNOSTICS) {
+            val values = rows.map { ticks[it, column] }
+                .filter { it >= 0L }.toLongArray().also { it.sort() }
+            // Active source counts describe lifetime, so report maximum rather than their sum.
+            if (column != T_NAV_ACTIVE && column != T_SCROLLER_ACTIVE) {
+                out.append(' ').append(key).append("_sum=")
+                    .append(diagnosticValue(column, if (values.isEmpty()) -1L else values.sum()))
+            }
+            out.append(' ').append(key).append("_p90=").append(diagnosticValue(column, percentile(values, 90.0)))
+            out.append(' ').append(key).append("_max=").append(diagnosticValue(column, values.lastOrNull() ?: -1L))
+        }
+        out.appendLine()
+    }
+
+    private fun appendSlowWork(out: StringBuilder, ticks: PerfTable, recentFrom: Long, clock: Clock) {
+        out.appendLine("## Last 30 s: slow work ticks (slowest 60 + latest 60, deduplicated, time order)")
+        out.appendLine("# measure/plan/cells/nav/scroller are inclusive wall ms and overlap; never add them.")
+        out.appendLine("# visible counts measured cells; prefetch counts new scheduled requests, not completed work.")
+        out.appendLine(
+            "# Work belongs to the callback's following frame; association is not a precise node root cause.",
+        )
+        fun longestWork(row: Int): Long = maxOf(
+            ticks[row, T_MEASURE_NS],
+            ticks[row, T_PLAN_NS],
+            ticks[row, T_CELLS_NS],
+            ticks[row, T_NAV_NS],
+            ticks[row, T_SCROLLER_NS],
+        )
+        val candidates = (0 until ticks.rows).filter {
+            tickArrival(ticks, it) >= recentFrom && longestWork(it) >= 4_000_000L
+        }
+        val slowest = candidates.sortedByDescending { longestWork(it) }.take(60)
+        val latest = candidates.sortedByDescending { tickArrival(ticks, it) }.take(60)
+        val selected = (slowest + latest).distinct().sortedBy { tickArrival(ticks, it) }
+        for (row in selected) {
+            out.append("slow_work ").append(clock.time(tickArrival(ticks, row)))
+            out.append(" phase=").append(phaseName(ticks[row, T_PHASE].toInt()))
+            out.append(" frame_interval_ms=").append(ms(ticks[row, T_INTERVAL]))
+            out.append(" arrival_interval_ms=").append(ms(ticks[row, T_ARRIVAL_INTERVAL]))
+            out.append(" measure_ms=").append(ms(ticks[row, T_MEASURE_NS]))
+            out.append(" composed=").append(ticks[row, T_COMPOSED])
+            for ((key, column) in DIAGNOSTICS) {
+                out.append(' ').append(key).append('=').append(diagnosticValue(column, ticks[row, column]))
+            }
+            out.appendLine()
+        }
+        if (selected.isEmpty()) out.appendLine("# none")
+        out.appendLine()
     }
 
     fun ms(nanos: Long): String = if (nanos < 0) "-1" else String.format(Locale.US, "%.2f", nanos / 1_000_000.0)
