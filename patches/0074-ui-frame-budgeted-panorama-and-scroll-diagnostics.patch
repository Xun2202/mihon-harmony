+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.requiredSize
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.layout.onPlaced
+import androidx.compose.ui.layout.positionInParent
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.test.ExperimentalTestApi
+import androidx.compose.ui.test.assertIsDisplayed
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.v2.runComposeUiTest
+import androidx.compose.ui.unit.dp
+import dev.chrisbanes.haze.HazeState
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.launch
+import org.junit.After
+import org.junit.Test
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.GraphicsMode
+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.NATIVE)
+@Config(sdk = [34])
+class NavigationChromeMasonryWorkTest {
+    @After
+    fun restoreDiagnostics() {
+        ScrollGlassDiagnostics.enabled = true
+        PanoramaFrameCounters.enabled = false
+        PanoramaFrameCounters.reset()
+    }
+
+    @Test
+    fun `cold viewport places only visible cells and jumps still reveal complete rows`() {
+        val placed = mutableSetOf<Int>()
+        val state = PanoramaMasonryState()
+        lateinit var scope: CoroutineScope
+        var rowHeight = 0f
+        runComposeUiTest {
+            setContent {
+                scope = rememberCoroutineScope()
+                PanoramaMasonry(
+                    columns = PanoramaColumns.Fixed(2),
+                    modifier = Modifier.requiredSize(360.dp, 640.dp),
+                    state = state,
+                ) {
+                    items(count = 2000, key = { it }, height = { PanoramaCellHeight.Fixed(150.dp) }) { index ->
+                        Box(
+                            Modifier.fillMaxSize().testTag("cell$index").onPlaced {
+                                rowHeight = it.size.height.toFloat()
+                                if (it.positionInParent().y >= 0) placed.add(index)
+                            },
+                        )
+                    }
+                }
+            }
+            runOnIdle {
+                assertEquals((0..9).toSet(), placed, "Offscreen rows must not be placed by the visible measure pass")
+                scope.launch { state.scrollToOffset(rowHeight * 10) }
+            }
+            waitForIdle()
+            onNodeWithTag("cell20").assertIsDisplayed()
+            onNodeWithTag("cell21").assertIsDisplayed()
+            runOnIdle { scope.launch { state.scrollToOffset(0f) } }
+            waitForIdle()
+            onNodeWithTag("cell0").assertIsDisplayed()
+            onNodeWithTag("cell1").assertIsDisplayed()
+        }
+    }
+
+    @Test
+    fun `scroller source detaches when hidden and recording off skips source timing`() {
+        val show = mutableStateOf(true)
+        val haze = HazeState()
+        val baseline = PanoramaFrameCounters.scrollerSources
+        PanoramaFrameCounters.enabled = false
+        PanoramaFrameCounters.reset()
+        runComposeUiTest {
+            setContent {
+                Box(Modifier.requiredSize(40.dp, 40.dp).fastScrollerGlassSource(haze.takeIf { show.value }))
+            }
+            runOnIdle {
+                assertEquals(baseline + 1, PanoramaFrameCounters.scrollerSources)
+                assertEquals(0L, PanoramaFrameCounters.scrollerDrawNanos)
+                show.value = false
+            }
+            waitForIdle()
+            runOnIdle {
+                assertEquals(baseline, PanoramaFrameCounters.scrollerSources)
+                show.value = true
+            }
+            waitForIdle()
+            runOnIdle {
+                assertTrue(PanoramaFrameCounters.scrollerSources > baseline)
+                ScrollGlassDiagnostics.enabled = false
+            }
+            waitForIdle()
+            runOnIdle { assertEquals(baseline, PanoramaFrameCounters.scrollerSources) }
+        }
+        assertEquals(baseline, PanoramaFrameCounters.scrollerSources, "Disposal releases the active-source counter")
+    }
+}
