+                val time = ticks[row, T_TIME]
+                val phase = ticks[row, T_PHASE].toInt()
+                if (size > 0 && times[size - 1] == time) {
+                    workRows[size - 1] = -1
+                    if (phases[size - 1] != phase) phases[size - 1] = -1
+                } else {
+                    times[size] = time
+                    workRows[size] = row
+                    phases[size] = phase
+                    size++
+                }
+            }
+        }
