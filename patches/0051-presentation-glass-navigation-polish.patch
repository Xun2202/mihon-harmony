+package tachiyomi.presentation.core.components.material
+
+import androidx.compose.foundation.layout.WindowInsets
+import androidx.compose.foundation.layout.navigationBars
+import androidx.compose.foundation.layout.statusBars
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.input.nestedscroll.NestedScrollConnection
+import androidx.compose.ui.input.nestedscroll.NestedScrollSource
+import androidx.compose.ui.input.nestedscroll.nestedScroll
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.Dp
+
+/** Each scroll event selects the active pager page; offscreen precomposed pages never drive the header. */
+@Composable
+fun Modifier.observeBrowsingLeadingScroll(leadingOffset: () -> Float): Modifier {
+    val chrome = LocalBrowsingChrome.current?.chrome ?: return this
+    val currentOffset by rememberUpdatedState(leadingOffset)
+    val activeSource = remember(chrome) { { currentOffset() } }
+    DisposableEffect(chrome, activeSource) {
+        onDispose { if (chrome.leadingOffset === activeSource) chrome.leadingOffset = null }
+    }
+    val connection = remember(chrome, activeSource) {
+        object : NestedScrollConnection {
+            override fun onPreScroll(available: Offset, source: NestedScrollSource): Offset {
+                if (kotlin.math.abs(available.y) > kotlin.math.abs(available.x)) chrome.leadingOffset = activeSource
+                return Offset.Zero
+            }
+            override fun onPostScroll(consumed: Offset, available: Offset, source: NestedScrollSource): Offset {
+                if (kotlin.math.abs(consumed.y) > kotlin.math.abs(consumed.x)) chrome.leadingOffset = activeSource
+                return Offset.Zero
+            }
+        }
+    }
+    return nestedScroll(connection)
+}
+
+private class FrozenBrowsingTrack(var insets: Pair<Dp, Dp>? = null)
+
+@Composable
+fun rememberBrowsingScrollInsets(topContentPadding: Dp, bottomContentPadding: Dp, dragging: Boolean): Pair<Dp, Dp> {
+    val chrome = LocalBrowsingChrome.current?.chrome
+    val density = LocalDensity.current
+    val statusTop = WindowInsets.statusBars.getTop(density).toFloat()
+    val systemBottom = WindowInsets.navigationBars.getBottom(density).toFloat()
+    val live = if (chrome == null) {
+        topContentPadding to bottomContentPadding
+    } else {
+        with(density) {
+            val top = browsingTrackInset(
+                topContentPadding.toPx(),
+                chrome.headerHeightPx,
+                chrome.hiddenFraction,
+                statusTop,
+            )
+            val bottom = browsingTrackInset(
+                bottomContentPadding.toPx(),
+                chrome.bottomHeightPx,
+                chrome.hiddenFraction,
+                systemBottom,
+            )
+            top.toDp() to bottom.toDp()
+        }
+    }
+    val frozen = remember(chrome, density.density) { FrozenBrowsingTrack() }
+    // Keep the last displayed track on the first down as well as while dragging.
+    if (!dragging || frozen.insets == null) frozen.insets = live
+    return frozen.insets!!
+}
