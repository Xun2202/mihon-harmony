+
+    @Test
+    fun `a first tall commit while scrolling waits for settle and bumps once`() {
+        val epoch = PanoramaMasonryContentEpoch.intValue
+        val token = Any()
+        PanoramaCoverShapes.setGridScrolling(token, scrolling = true)
+        PanoramaCoverShapes.put(4L, 1.50f)
+        PanoramaCoverShapes.put(5L, 1.70f)
+        PanoramaCoverShapes.put(6L, 0.50f)
+        assertEquals(epoch, PanoramaMasonryContentEpoch.intValue)
+        assertNull(PanoramaCoverShapes.committedRatioOrNull(4L))
+        assertNull(PanoramaCoverShapes.committedRatioOrNull(5L))
+        assertEquals(WIDE_COVER_RATIO, PanoramaCoverShapes.committedRatio(4L))
+        assertEquals(WIDE_COVER_RATIO, PanoramaCoverShapes.committedRatio(5L))
+        assertTrue(committedCoverIsWide(4L))
+        assertTrue(committedCoverIsWide(5L))
+        assertEquals(0.50f, PanoramaCoverShapes.committedRatio(6L))
+        assertTrue(committedCoverIsWide(6L))
+
+        PanoramaCoverShapes.setGridScrolling(token, scrolling = false)
+        assertEquals(epoch + 1, PanoramaMasonryContentEpoch.intValue)
+        assertEquals(1.50f, PanoramaCoverShapes.committedRatio(4L))
+        assertEquals(1.70f, PanoramaCoverShapes.committedRatio(5L))
+        assertFalse(committedCoverIsWide(4L))
+        assertFalse(committedCoverIsWide(5L))
+    }
+
+    @Test
+    fun `a first tall commit while no grid is scrolling commits immediately`() {
+        val epoch = PanoramaMasonryContentEpoch.intValue
+        PanoramaCoverShapes.put(7L, 1.40f)
+        assertEquals(epoch + 1, PanoramaMasonryContentEpoch.intValue)
+        assertEquals(1.40f, PanoramaCoverShapes.committedRatio(7L))
+        assertFalse(committedCoverIsWide(7L))
+    }
+
+    @Test
+    fun `puts on the owner thread collapse into one flush`() {
+        val posted = ArrayList<() -> Unit>()
+        PanoramaCoverShapes.snapshotDispatcher = object : PanoramaSnapshotDispatcher {
+            override fun isOwnerThread(): Boolean = true
+
+            override fun post(block: () -> Unit) {
+                posted.add(block)
+            }
+        }
+        PanoramaCoverShapes.put(8L, 1.50f)
+        PanoramaCoverShapes.put(9L, 1.60f)
+        assertEquals(1, posted.size)
+        assertTrue(committedCoverIsWide(8L))
+        assertTrue(committedCoverIsWide(9L))
+        val epoch = PanoramaMasonryContentEpoch.intValue
+        posted.single().invoke()
+        assertEquals(epoch + 1, PanoramaMasonryContentEpoch.intValue)
+        assertEquals(1.50f, PanoramaCoverShapes.committedRatio(8L))
+        assertEquals(1.60f, PanoramaCoverShapes.committedRatio(9L))
+    }
+
+    @Test
+    fun `a live scroll probe holds a tall commit before the settled flag flips`() {
+        val epoch = PanoramaMasonryContentEpoch.intValue
+        var inProgress = true
+        val token = Any()
+        PanoramaCoverShapes.attachScrollProbe(token) { inProgress }
+        PanoramaCoverShapes.put(20L, 1.55f)
+        assertEquals(epoch, PanoramaMasonryContentEpoch.intValue)
+        assertNull(PanoramaCoverShapes.committedRatioOrNull(20L))
+        assertTrue(committedCoverIsWide(20L))
+
+        inProgress = false
+        PanoramaCoverShapes.put(21L, 0.40f)
+        assertEquals(epoch + 1, PanoramaMasonryContentEpoch.intValue)
+        assertEquals(1.55f, PanoramaCoverShapes.committedRatio(20L))
+        assertFalse(committedCoverIsWide(20L))
+        assertEquals(0.40f, PanoramaCoverShapes.committedRatio(21L))
+    }
 }
 
