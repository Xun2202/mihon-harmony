+package eu.kanade.tachiyomi.data.download
+
+/** A per-download three-second window; this never updates the global notification meter. */
+internal class DownloadItemSpeed(private val clockMillis: () -> Long = { System.nanoTime() / 1_000_000 }) {
+    private val seconds = LongArray(8) { Long.MIN_VALUE }
+    private val bytes = LongArray(8)
+
+    @Synchronized
+    fun addBytes(count: Long) {
+        if (count <= 0) return
+        val second = clockMillis() / 1000
+        val index = Math.floorMod(second, seconds.size.toLong()).toInt()
+        if (seconds[index] != second) {
+            seconds[index] = second
+            bytes[index] = 0
+        }
+        bytes[index] += count
+    }
+
+    @Synchronized
+    fun bytesPerSecond(): Long {
+        val now = clockMillis() / 1000
+        var sum = 0L
+        for (index in seconds.indices) {
+            if (seconds[index] in (now - 2)..now) sum += bytes[index]
+        }
+        return sum / 3
+    }
+
+    @Synchronized
+    fun reset() {
+        seconds.fill(Long.MIN_VALUE)
+        bytes.fill(0)
+    }
+}
