+package eu.kanade.tachiyomi.data.download
+
+import eu.kanade.tachiyomi.data.download.model.Download
+import io.mockk.mockk
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+
+class NavigationChromeDownloadItemSpeedTest {
+    @Test
+    fun `each chapter has independent speed and paused failed or completed chapters reset it`() {
+        val first = Download(mockk(), mockk(), mockk())
+        val second = Download(mockk(), mockk(), mockk())
+        first.status = Download.State.DOWNLOADING
+        second.status = Download.State.DOWNLOADING
+        first.recordNetworkBytes(3000)
+        second.recordNetworkBytes(9000)
+        first.refreshSpeed()
+        second.refreshSpeed()
+        assertEquals(1000L, first.speedBytesPerSecond)
+        assertEquals(3000L, second.speedBytesPerSecondFlow.value)
+        first.status = Download.State.PAUSED
+        assertEquals(0L, first.speedBytesPerSecond)
+        assertEquals(3000L, second.speedBytesPerSecond)
+        second.fail("test")
+        assertEquals(0L, second.speedBytesPerSecond)
+        first.status = Download.State.DOWNLOADING
+        first.recordNetworkBytes(6000)
+        first.refreshSpeed()
+        assertEquals(2000L, first.speedBytesPerSecond)
+        first.status = Download.State.DOWNLOADED
+        assertEquals(0L, first.speedBytesPerSecond)
+        assertEquals(listOf(0, 1, 2, 3, 4, 5), Download.State.entries.map { it.value })
+    }
+}
diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/download/NavigationChromeDownloadPausedStoreTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/download/NavigationChromeDownloadPausedStoreTest.kt
new file mode 100644
index 000000000..eb32c6842
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/data/download/NavigationChromeDownloadPausedStoreTest.kt
@@ -0,0 +1,127 @@
+package eu.kanade.tachiyomi.data.download
+
+import android.content.Context
+import android.content.SharedPreferences
+import eu.kanade.tachiyomi.data.download.model.Download
+import eu.kanade.tachiyomi.source.online.HttpSource
+import io.mockk.Runs
+import io.mockk.coEvery
+import io.mockk.every
+import io.mockk.just
+import io.mockk.mockk
+import kotlinx.coroutines.runBlocking
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.int
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertFalse
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import tachiyomi.domain.chapter.interactor.GetChapter
+import tachiyomi.domain.chapter.model.Chapter
+import tachiyomi.domain.manga.interactor.GetManga
+import tachiyomi.domain.manga.model.Manga
+import tachiyomi.domain.source.service.SourceManager
+
+class NavigationChromeDownloadPausedStoreTest {
+    @Test
+    fun `legacy JSON without paused restores as queued in its stored order`() = runBlocking {
+        val fixture = Fixture()
+        fixture.values["1"] = "{\"mangaId\":1,\"chapterId\":1,\"order\":20}"
+        fixture.values["2"] = "{\"mangaId\":2,\"chapterId\":2,\"order\":10}"
+        val restored = fixture.store.restore()
+        assertEquals(listOf(2L, 1L), restored.map { it.chapter.id })
+        assertTrue(restored.all { it.status == Download.State.QUEUE })
+        assertTrue(fixture.values.isEmpty())
+    }
+
+    @Test
+    fun `paused state survives process restore and later resume without changing initial queue order`() = runBlocking {
+        val fixture = Fixture()
+        val first = fixture.download(1).apply { status = Download.State.PAUSED }
+        val second = fixture.download(2)
+        fixture.store.addAll(listOf(first, second))
+        val restored = fixture.store.restore()
+        assertEquals(listOf(1L, 2L), restored.map { it.chapter.id })
+        assertEquals(listOf(Download.State.PAUSED, Download.State.QUEUE), restored.map { it.status })
+        fixture.store.addAll(restored)
+        val order = fixture.order("1")
+        restored.first().status = Download.State.QUEUE
+        fixture.store.update(restored.first())
+        assertEquals(order, fixture.order("1"))
+        assertTrue(fixture.store.restore().all { it.status == Download.State.QUEUE })
+    }
+
+    @Test
+    fun `updating a pause preserves order and never revives an entry removed during cancellation`() = runBlocking {
+        val fixture = Fixture()
+        val first = fixture.download(1)
+        val second = fixture.download(2)
+        fixture.store.addAll(listOf(first, second))
+        val originalOrder = fixture.order("1")
+        first.status = Download.State.PAUSED
+        fixture.store.update(first)
+        assertEquals(originalOrder, fixture.order("1"))
+        assertEquals(listOf("1", "2"), fixture.values.keys.toList())
+        fixture.store.remove(first)
+        fixture.store.update(first)
+        assertFalse(fixture.values.containsKey("1"))
+        val restored = fixture.store.restore()
+        assertEquals(listOf(2L), restored.map { it.chapter.id })
+    }
+
+    private class Fixture {
+        val values = linkedMapOf<String, String>()
+        private val preferences = mockk<SharedPreferences>()
+        private val editor = mockk<SharedPreferences.Editor>()
+        private val source = mockk<HttpSource>()
+        private val sourceManager = mockk<SourceManager>()
+        private val getManga = mockk<GetManga>()
+        private val getChapter = mockk<GetChapter>()
+        private val mangas = mutableMapOf<Long, Manga>()
+        private val episodes = mutableMapOf<Long, Chapter>()
+        val store: DownloadStore
+
+        init {
+            every { preferences.edit() } returns editor
+            every { preferences.all } answers { values.toMap() }
+            every { preferences.getString(any(), any()) } answers { values[firstArg<String>()] ?: secondArg<String?>() }
+            every { editor.putString(any(), any()) } answers {
+                values[firstArg()] = secondArg()
+                editor
+            }
+            every { editor.remove(any()) } answers {
+                values.remove(firstArg<String>())
+                editor
+            }
+            every { editor.clear() } answers {
+                values.clear()
+                editor
+            }
+            every { editor.apply() } just Runs
+            every { sourceManager.get(1L) } returns source
+            coEvery { getManga.await(any<Long>()) } answers { manga(firstArg()) }
+            coEvery { getChapter.await(any<Long>()) } answers { episode(firstArg()) }
+            val context = mockk<Context> {
+                every { getSharedPreferences("active_downloads", Context.MODE_PRIVATE) } returns preferences
+            }
+            store = DownloadStore(context, sourceManager, Json, getManga, getChapter)
+        }
+
+        private fun manga(value: Long): Manga = mangas.getOrPut(value) {
+            mockk<Manga>().also { manga ->
+                every { manga.id } returns value
+                every { manga.source } returns 1L
+            }
+        }
+
+        private fun episode(value: Long): Chapter = episodes.getOrPut(value) {
+            mockk<Chapter>().also { episode -> every { episode.id } returns value }
+        }
+
+        fun download(id: Long): Download = Download(source, manga(id), episode(id)).apply { status = Download.State.QUEUE }
+
+        fun order(key: String): Int = Json.parseToJsonElement(values.getValue(key)).jsonObject.getValue("order").jsonPrimitive.int
+    }
+}
