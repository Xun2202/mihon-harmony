+package eu.kanade.tachiyomi.data.download
+
+import com.hippo.unifile.UniFile
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.withContext
+import java.io.IOException
+
+internal object DownloadItemControl {
+    fun shouldAppend(code: Int, contentRange: String?, existingLength: Long): Boolean {
+        if (code == 200) return false
+        if (code != 206) throw IOException("Unexpected image HTTP status")
+        val match = Regex("bytes ([0-9]+)-([0-9]+)/([0-9]+|\\*)").matchEntire(contentRange.orEmpty())
+            ?: throw IOException("Invalid partial image range")
+        val start = match.groupValues[1].toLongOrNull()
+        val end = match.groupValues[2].toLongOrNull()
+        val total = match.groupValues[3].takeUnless { it == "*" }?.toLongOrNull()
+        if (start != existingLength || end == null || end < existingLength || total == null || end != total - 1) {
+            throw IOException("Partial image range does not match the saved page")
+        }
+        return true
+    }
+
+    suspend fun stop(job: Job?) {
+        job?.cancel()
+        withContext(NonCancellable) { job?.join() }
+    }
+
+    /** Only generated page files inside this chapter's temporary directory may be reset. */
+    fun clearTemporaryPages(directory: UniFile) {
+        directory.listFiles().orEmpty().filter { it.isFile && isTemporaryPage(it.name.orEmpty()) }.forEach {
+            if (!it.delete()) throw IOException("Cannot reset a temporary download page")
+        }
+    }
+
+    fun isTemporaryPage(name: String): Boolean = PAGE.matches(name)
+
+    private val PAGE = Regex("[0-9]{3,}(?:__[0-9]+)?\\.(?:tmp|jpg|jpeg|png|webp|gif|avif|jxl|heif|heic)", RegexOption.IGNORE_CASE)
+}
