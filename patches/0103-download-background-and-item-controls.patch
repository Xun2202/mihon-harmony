@@ -0,0 +1,126 @@
+package eu.kanade.tachiyomi.data.download
+
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.cancelAndJoin
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.io.IOException
+import java.util.concurrent.atomic.AtomicInteger
+
+class NavigationChromeDownloadAudioPumpTest {
+    @Test
+    fun `cancellation closes the active audio output exactly once`() = runBlocking {
+        val writes = CompletableDeferred<Unit>()
+        val closed = AtomicInteger()
+        val failures = AtomicInteger()
+        val job = launch(start = CoroutineStart.UNDISPATCHED) {
+            DownloadAudioPump.run(create = {
+                object : DownloadAudioPump.Sink {
+                    override suspend fun write(): Int {
+                        writes.complete(Unit)
+                        return 1280
+                    }
+                    override fun close() {
+                        closed.incrementAndGet()
+                    }
+                }
+            }, onFailure = { failures.incrementAndGet() })
+        }
+        withTimeout(3000) { writes.await() }
+        job.cancelAndJoin()
+        assertEquals(1, closed.get())
+        assertEquals(0, failures.get())
+    }
+
+    @Test
+    fun `dead audio output is released before its replacement is opened`() = runBlocking {
+        val opened = AtomicInteger()
+        val closed = AtomicInteger()
+        val failure = AtomicInteger()
+        val recovered = CompletableDeferred<Unit>()
+        val job = launch {
+            DownloadAudioPump.run(create = {
+                val generation = opened.incrementAndGet()
+                if (generation == 2) assertEquals(1, closed.get())
+                object : DownloadAudioPump.Sink {
+                    override suspend fun write(): Int {
+                        if (generation == 1) return -6
+                        recovered.complete(Unit)
+                        return 1280
+                    }
+                    override fun close() {
+                        closed.incrementAndGet()
+                    }
+                }
+            }, onFailure = { failure.incrementAndGet() }, retryDelayMillis = 1)
+        }
+        try {
+            withTimeout(3000) { recovered.await() }
+            assertEquals(2, opened.get())
+            assertEquals(1, failure.get())
+        } finally {
+            job.cancelAndJoin()
+        }
+        assertEquals(2, closed.get())
+    }
+
+    @Test
+    fun `factory failure recovers without a phantom output to release`() = runBlocking {
+        val attempts = AtomicInteger()
+        val closed = AtomicInteger()
+        val recovered = CompletableDeferred<Unit>()
+        val job = launch {
+            DownloadAudioPump.run(create = {
+                if (attempts.incrementAndGet() == 1) throw IOException("synthetic audio init failure")
+                object : DownloadAudioPump.Sink {
+                    override suspend fun write(): Int {
+                        recovered.complete(Unit)
+                        return 1280
+                    }
+                    override fun close() {
+                        closed.incrementAndGet()
+                    }
+                }
+            }, onFailure = {}, retryDelayMillis = 1)
+        }
+        try {
+            withTimeout(3000) { recovered.await() }
+        } finally {
+            job.cancelAndJoin()
+        }
+        assertEquals(2, attempts.get())
+        assertEquals(1, closed.get())
+    }
+
+    @Test
+    fun `repeated zero writes rebuild a stalled output without spinning`() = runBlocking {
+        val opened = AtomicInteger()
+        val failures = AtomicInteger()
+        val recovered = CompletableDeferred<Unit>()
+        val job = launch {
+            DownloadAudioPump.run(create = {
+                val generation = opened.incrementAndGet()
+                object : DownloadAudioPump.Sink {
+                    override suspend fun write(): Int {
+                        if (generation == 1) return 0
+                        recovered.complete(Unit)
+                        return 1280
+                    }
+                    override fun close() = Unit
+                }
+            }, onFailure = { failures.incrementAndGet() }, retryDelayMillis = 1, zeroWriteLimit = 2)
+        }
+        try {
+            withTimeout(3000) { recovered.await() }
+        } finally {
+            job.cancelAndJoin()
+        }
+        assertEquals(2, opened.get())
+        assertTrue(failures.get() == 1)
+    }
+}
