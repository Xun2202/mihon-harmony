@@ -0,0 +1,120 @@
+package eu.kanade.tachiyomi.data.download
+
+import android.content.Context
+import android.media.AudioAttributes
+import android.media.AudioFormat
+import android.media.AudioTrack
+import android.os.PowerManager
+import android.os.SystemClock
+import androidx.core.content.getSystemService
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.launch
+import logcat.LogPriority
+import tachiyomi.core.common.util.system.logcat
+import java.util.concurrent.atomic.AtomicReference
+
+/** Download-owned streaming silence, with explicit cancellation and dead-output recovery. */
+internal class DownloadAudioKeepAlive(context: Context) {
+    private val context = context.applicationContext
+    private val power = this.context.getSystemService<PowerManager>()
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val currentTrack = AtomicReference<AudioTrack?>()
+    private var writer: Job? = null
+    private var wakeLock: PowerManager.WakeLock? = null
+
+    fun start() {
+        if (writer != null) return
+        runCatching {
+            wakeLock = power?.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "${context.packageName}:download-audio")
+                ?.apply {
+                    setReferenceCounted(false)
+                    acquire(WAKE_TIMEOUT)
+                }
+        }.onFailure { logcat(LogPriority.WARN, it) { "Download keep-alive wake lock unavailable" } }
+        writer = scope.launch {
+            DownloadAudioPump.run(
+                create = ::createOutput,
+                onFailure = { error -> logcat(LogPriority.WARN, error) { "Download keep-alive audio rebuilding" } },
+            )
+        }
+    }
+
+    private fun createOutput(): DownloadAudioPump.Sink {
+        var built: AudioTrack? = null
+        var published = false
+        try {
+            val minimum = AudioTrack.getMinBufferSize(RATE, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT)
+            check(minimum > 0) { "Audio minimum buffer invalid: $minimum" }
+            val track = AudioTrack.Builder()
+                .setAudioAttributes(AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_MEDIA).setContentType(AudioAttributes.CONTENT_TYPE_MUSIC).build())
+                .setAudioFormat(AudioFormat.Builder().setSampleRate(RATE).setEncoding(AudioFormat.ENCODING_PCM_16BIT).setChannelMask(AudioFormat.CHANNEL_OUT_MONO).build())
+                .setTransferMode(AudioTrack.MODE_STREAM)
+                .setBufferSizeInBytes(maxOf(minimum, CHUNK_BYTES * 4))
+                .build()
+            built = track
+            check(track.state == AudioTrack.STATE_INITIALIZED) { "Audio output is not initialized" }
+            currentTrack.set(track)
+            published = true
+            track.play()
+            logcat(LogPriority.INFO) {
+                "Download keep-alive audio started mode=stream wakeHeld=${wakeLock?.isHeld} interactive=${power?.isInteractive} idle=${power?.isDeviceIdleMode}"
+            }
+            return object : DownloadAudioPump.Sink {
+                private val silence = ByteArray(CHUNK_BYTES)
+                private var lastLog = SystemClock.elapsedRealtime()
+                override suspend fun write(): Int {
+                    val count = track.write(silence, 0, silence.size, AudioTrack.WRITE_BLOCKING)
+                    val now = SystemClock.elapsedRealtime()
+                    if (now - lastLog >= 30_000) {
+                        lastLog = now
+                        runCatching { if (wakeLock?.isHeld == false) wakeLock?.acquire(WAKE_TIMEOUT) }
+                        logcat(LogPriority.INFO) {
+                            "Download keep-alive audio heartbeat written=$count playState=${track.playState} head=${track.playbackHeadPosition} " +
+                                "wakeHeld=${wakeLock?.isHeld} interactive=${power?.isInteractive} idle=${power?.isDeviceIdleMode}"
+                        }
+                    }
+                    return count
+                }
+                override fun close() {
+                    if (currentTrack.compareAndSet(track, null)) release(track)
+                }
+            }
+        } catch (error: Exception) {
+            built?.let { track ->
+                // The owner may have already released it while the factory was being cancelled.
+                if (!published || currentTrack.compareAndSet(track, null)) release(track)
+            }
+            throw error
+        }
+    }
+
+    suspend fun stopAndJoin() {
+        writer?.cancel()
+        // Release first: a blocking AudioTrack.write must wake before joining its coroutine.
+        currentTrack.getAndSet(null)?.let(::release)
+        try {
+            writer?.join()
+        } finally {
+            scope.cancel()
+            runCatching { if (wakeLock?.isHeld == true) wakeLock?.release() }
+            wakeLock = null
+            writer = null
+            logcat(LogPriority.INFO) { "Download keep-alive audio stopped" }
+        }
+    }
+
+    private fun release(track: AudioTrack) {
+        runCatching { track.stop() }
+        runCatching { track.release() }
+    }
+
+    private companion object {
+        const val RATE = 8000
+        const val CHUNK_BYTES = RATE * 2 * 80 / 1000
+        const val WAKE_TIMEOUT = 12 * 60 * 60 * 1000L
+    }
+}
