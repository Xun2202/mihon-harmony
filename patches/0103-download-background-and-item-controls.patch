+            } finally {
+                exited.countDown()
+            }
+        }
+        val sibling = scope.launch(start = CoroutineStart.UNDISPATCHED) { awaitCancellation() }
+        try {
+            assertTrue(entered.await(3, TimeUnit.SECONDS))
+            val pausing = launch { DownloadItemControl.stop(first) }
+            withTimeout(3000) { while (!first.isCancelled) yield() }
+            assertFalse(pausing.isCompleted)
+            assertTrue(sibling.isActive)
+            release.countDown()
+            withTimeout(3000) { pausing.join() }
+            assertEquals(0L, exited.count)
+            assertTrue(first.isCompleted)
+            assertTrue(sibling.isActive)
+        } finally {
+            release.countDown()
+            owner.cancelAndJoin()
+        }
+    }
+
+    @Test
+    fun `restart deletes generated temporary pages and preserves unknown files and directories`() {
+        val directory = mockk<UniFile>()
+        val files = listOf("001.jpg", "002.tmp", "003__001.jpg", "notes.txt", "final.cbz", "folder")
+            .associateWith { name ->
+                mockk<UniFile>().also { file ->
+                    every { file.name } returns name
+                    every { file.isFile } returns (name != "folder")
+                    every { file.delete() } returns true
+                }
+            }
+        every { directory.listFiles() } returns files.values.toTypedArray()
+        DownloadItemControl.clearTemporaryPages(directory)
+        listOf("001.jpg", "002.tmp", "003__001.jpg").forEach { name -> verify(exactly = 1) { files.getValue(name).delete() } }
+        listOf("notes.txt", "final.cbz", "folder").forEach { name -> verify(exactly = 0) { files.getValue(name).delete() } }
+    }
+
+    @Test
+    fun `failed temporary page deletion aborts restart instead of writing another copy`() {
+        val file = mockk<UniFile> {
+            every { name } returns "001.jpg"
+            every { isFile } returns true
+            every { delete() } returns false
+        }
+        val directory = mockk<UniFile> { every { listFiles() } returns arrayOf(file) }
+        assertThrows(IOException::class.java) { DownloadItemControl.clearTemporaryPages(directory) }
+    }
+
+    @Test
+    fun `partial page append requires a matching Content Range and full responses overwrite`() {
+        assertTrue(DownloadItemControl.shouldAppend(206, "bytes 100-199/200", 100))
+        assertFalse(DownloadItemControl.shouldAppend(200, null, 100))
+        listOf(null, "bytes 0-199/200", "bytes 100-99/200", "bytes 100-199/150", "not a range").forEach {
+            assertThrows(IOException::class.java) { DownloadItemControl.shouldAppend(206, it, 100) }
+        }
+    }
+}
