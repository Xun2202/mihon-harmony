From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Xun2202 <98207886+Xun2202@users.noreply.github.com>
Date: Mon, 12 Oct 2026 05:17:17 +0000
Subject: [PATCH] downloads: do not report a retried failed chapter as
 "already in the queue"

Tapping a chapter whose download failed re-queues it through the same path
as a fresh download (the caller then calls startDownloads()), so 0011
counted it as "already in the queue" and showed the skip snackbar on every
retry. Chapters that are in the queue in ERROR state are now reported as
`retried` and not as skipped. Same change folded into anikku-harmony 0018.
---
 .../eu/kanade/tachiyomi/data/download/Downloader.kt   | 11 ++++++++---
 1 file changed, 8 insertions(+), 3 deletions(-)

diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/download/Downloader.kt b/app/src/main/java/eu/kanade/tachiyomi/data/download/Downloader.kt
index a6278af..58426b4 100644
--- a/app/src/main/java/eu/kanade/tachiyomi/data/download/Downloader.kt
+++ b/app/src/main/java/eu/kanade/tachiyomi/data/download/Downloader.kt
@@ -381,8 +381,10 @@ class Downloader(
                 cache.isChapterDownloaded(it.name, it.scanlator, it.url, manga.title, manga.source)
             }
         }
-        val queuedChapterIds = queueState.value.mapTo(HashSet()) { it.chapter.id }
-        val (alreadyQueued, toQueue) = notDownloaded.partition { it.id in queuedChapterIds }
+        val queuedDownloads = queueState.value.associateBy { it.chapter.id }
+        val (alreadyQueued, toQueue) = notDownloaded.partition { it.id in queuedDownloads }
+        // A failed download the user taps again is restarted by the caller (startDownloads), not skipped.
+        val (retried, stillQueued) = alreadyQueued.partition { queuedDownloads[it.id]?.status == Download.State.ERROR }
         val chaptersToQueue = toQueue
             // Add chapters to queue from the start.
             .sortedByDescending { it.sourceOrder }
@@ -419,8 +421,9 @@ class Downloader(
         }
         return QueueResult(
             queued = chaptersToQueue.size,
+            retried = retried.size,
             alreadyDownloaded = alreadyDownloaded.size,
-            alreadyQueued = alreadyQueued.size,
+            alreadyQueued = stillQueued.size,
             startDownloader = startDownloader,
         )
     }
@@ -430,9 +433,11 @@ class Downloader(
      * started instead of silently dropping chapters.
      *
      * @property startDownloader true when the caller should start the download worker.
+     * @property retried chapters already in the queue in ERROR state; the caller restarts them.
      */
     data class QueueResult(
         val queued: Int = 0,
+        val retried: Int = 0,
         val alreadyDownloaded: Int = 0,
         val alreadyQueued: Int = 0,
         val sourceUnavailable: Int = 0,
