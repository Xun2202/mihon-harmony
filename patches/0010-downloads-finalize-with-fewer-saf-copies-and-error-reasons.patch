+    /** Harmony: retries a storage operation three times (2 s, 4 s) before giving up. */
+    private suspend fun <T> retryStorageOperation(block: () -> T): T {
+        var attempt = 0
+        while (true) {
+            try {
+                return block()
+            } catch (e: IOException) {
+                attempt++
+                if (attempt >= 3) throw e
+                logcat(LogPriority.WARN, e) { "Storage operation failed, retrying ($attempt)" }
+                delay((1L shl attempt) * 1000)
+            }
+        }
+    }
+
