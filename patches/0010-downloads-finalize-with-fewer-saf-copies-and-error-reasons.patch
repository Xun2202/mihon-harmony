 /**
  * Renames this file, falling back to copying and deleting it when the storage provider does not
- * support renaming documents.
+ * support renaming documents (HarmonyOS ZhuoyiTong's SAF bridge, some OEM providers).
  *
+ * For directories the fallback first tries to move the children into the new directory with
+ * [DocumentsContract.moveDocument] (a metadata operation on providers that support it) and only
+ * streams the data through the app when that is unsupported as well. An existing target directory
+ * is reused (merged into) so a previously interrupted fallback can be completed. When the copy
+ * succeeded but the source could not be deleted the copy is kept and the stale source is left
+ * behind: callers that already have the finished data must not lose it over a failed delete.
+ *
+ * @param resolver used for [DocumentsContract.moveDocument]; without it the fallback always copies.
  * @return the renamed file, or the newly created file when the fallback is used.
  */
-fun UniFile.renameToOrCopy(targetName: String): UniFile {
+fun UniFile.renameToOrCopy(targetName: String, resolver: ContentResolver? = null): UniFile {
