+package eu.kanade.presentation.library.components
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.Stable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.saveable.Saver
+import androidx.compose.runtime.saveable.rememberSaveable
+import androidx.compose.runtime.setValue
+import tachiyomi.presentation.core.components.PanoramaColumns
+
+// Harmony -->
+/**
+ * Dominant cover shape of one panorama grid.
+ *
+ * [Unknown] keeps the width-only tier. [Tall] and [Wide] size the auto columns for that shape.
+ * A wide grid does not span a landscape cover across two columns.
+ */
+internal enum class PanoramaShapeMode {
+    Unknown,
+    Tall,
+    Wide,
+}
+
+/** Enter wide columns only at this wide-cover fraction, unless already wide. */
+internal const val PANORAMA_WIDE_ENTER_FRACTION = 0.60
+
+/** Leave wide columns only once the wide-cover fraction falls to this. */
+internal const val PANORAMA_WIDE_EXIT_FRACTION = 0.40
+
+private const val PANORAMA_SHAPE_MIN_KNOWN = 8
+
+/**
+ * Next mode from a settled sample.
+ *
+ * Harmony: [known] counts only ids that already have a committed shape. The 9/16 default is not a
+ * vote. A sample is trusted once [known] reaches min(total, max(8, total / 2)); otherwise the
+ * previous mode stays, including [PanoramaShapeMode.Unknown]. The first trusted sample is wide at
+ * or above 0.60 and tall below that. After that, wide waits for 0.40 before it returns to tall.
+ */
+internal fun nextPanoramaShapeMode(
+    current: PanoramaShapeMode,
+    total: Int,
+    known: Int,
+    wide: Int,
+): PanoramaShapeMode {
+    if (total <= 0 || known <= 0) return current
+    val need = minOf(total, maxOf(PANORAMA_SHAPE_MIN_KNOWN, total / 2))
+    if (known < need) return current
+    val fraction = wide.toDouble() / known.toDouble()
+    return when (current) {
+        PanoramaShapeMode.Wide -> {
+            if (fraction <= PANORAMA_WIDE_EXIT_FRACTION) PanoramaShapeMode.Tall else PanoramaShapeMode.Wide
+        }
+        PanoramaShapeMode.Unknown -> {
+            if (fraction >= PANORAMA_WIDE_ENTER_FRACTION) PanoramaShapeMode.Wide else PanoramaShapeMode.Tall
+        }
+        PanoramaShapeMode.Tall -> {
+            if (fraction >= PANORAMA_WIDE_ENTER_FRACTION) PanoramaShapeMode.Wide else PanoramaShapeMode.Tall
+        }
+    }
+}
+
+/** Votes with [PanoramaCoverShapes.committedRatioOrNull]. An id that was never committed is skipped. */
+internal fun panoramaShapeMode(
+    current: PanoramaShapeMode,
+    total: Int,
+    mangaIdAt: (Int) -> Long?,
+): PanoramaShapeMode {
+    var known = 0
+    var wide = 0
+    for (index in 0 until total) {
+        val id = mangaIdAt(index) ?: continue
+        val ratio = PanoramaCoverShapes.committedRatioOrNull(id) ?: continue
+        known++
+        if (ratio <= RATIO_SWITCH_TO_PANORAMA) wide++
+    }
+    return nextPanoramaShapeMode(current, total, known, wide)
+}
+
+/**
+ * Sample key for one grid. [listSignature] is [panoramaShapeListSignature].
+ * [shapeVersion] is [PanoramaCoverShapes.committedShapeVersion].
+ */
+internal data class PanoramaShapeSampleKey(
+    val listSignature: Long,
+    val shapeVersion: Int,
+)
+
+/**
+ * Harmony: first, quarter, middle, three-quarter, and last id. A category, a search, or a
+ * browse page changes one of those. This does not walk the shelf.
+ */
+internal fun panoramaShapeListSignature(total: Int, mangaIdAt: (Int) -> Long?): Long {
+    if (total <= 0) return 0L
+    val indexes = intArrayOf(0, total / 4, total / 2, total * 3 / 4, total - 1)
+    var hash = total.toLong()
+    var seen = -1
+    for (index in indexes) {
+        if (index == seen) continue
+        seen = index
+        hash = hash * 31 + (mangaIdAt(index) ?: Long.MIN_VALUE)
+    }
+    return hash
+}
+
+/**
+ * One sample per settle key. The key changes when the listed ids change or the shape table
+ * publishes a new version. A repeated key does not sample again.
+ */
+internal class PanoramaShapeModeGate {
+    private var sampled = false
+    private var key = PanoramaShapeSampleKey(Long.MIN_VALUE, Int.MIN_VALUE)
+
+    fun allow(settled: Boolean, key: PanoramaShapeSampleKey): Boolean {
+        if (!settled) {
+            sampled = false
+            return false
+        }
+        if (sampled && this.key == key) return false
+        sampled = true
+        this.key = key
+        return true
+    }
+}
+
+@Stable
+internal class PanoramaShapeModeState(initial: PanoramaShapeMode) {
+    var mode by mutableStateOf(initial)
+        private set
+
+    private val gate = PanoramaShapeModeGate()
+
+    fun onGridSignal(
+        settled: Boolean,
+        total: Int,
+        mangaIdAt: (Int) -> Long?,
+        listSignature: Long,
+        shapeVersion: Int,
+    ) {
+        if (!gate.allow(settled, PanoramaShapeSampleKey(listSignature, shapeVersion))) return
+        val next = panoramaShapeMode(mode, total, mangaIdAt)
+        if (next != mode) mode = next
+    }
+
+    companion object {
+        val Saver: Saver<PanoramaShapeModeState, String> = Saver(
+            save = { it.mode.name },
+            restore = { PanoramaShapeModeState(PanoramaShapeMode.valueOf(it)) },
+        )
+    }
+}
+
+@Composable
+internal fun rememberPanoramaShapeModeState(): PanoramaShapeModeState {
+    return rememberSaveable(saver = PanoramaShapeModeState.Saver) {
+        PanoramaShapeModeState(PanoramaShapeMode.Unknown)
+    }
+}
+
+/** Auto columns for the mode. A fixed column count is the caller's [PanoramaColumns.Fixed]. */
+internal fun panoramaAutoColumns(mode: PanoramaShapeMode): PanoramaColumns {
+    return when (mode) {
+        PanoramaShapeMode.Tall -> PanoramaColumns.Shaped(1.5f)
+        PanoramaShapeMode.Wide -> PanoramaColumns.Shaped(2f / 3f)
+        PanoramaShapeMode.Unknown -> PanoramaGridMinColumnWidth
+    }
+}
