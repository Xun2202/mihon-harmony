+package eu.kanade.presentation.library.components
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNotEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+
+class PanoramaShapeModeTest {
+    @BeforeEach
+    fun reset() {
+        PanoramaCoverShapes.resetForTest()
+        PanoramaCoverShapes.snapshotDispatcher = ImmediateShapeDispatcher
+    }
+
+    @Test
+    fun `an id that has not been committed does not vote`() {
+        assertNull(PanoramaCoverShapes.committedRatioOrNull(1L))
+        assertEquals(WIDE_COVER_RATIO, PanoramaCoverShapes.committedRatio(1L))
+        // Eight missing ids would be 100% wide if the 9/16 default counted.
+        val mode = panoramaShapeMode(PanoramaShapeMode.Unknown, total = 8) { it.toLong() }
+        assertEquals(PanoramaShapeMode.Unknown, mode)
+    }
+
+    @Test
+    fun `the wide band is the existing 0_75 switch`() {
+        repeat(8) { PanoramaCoverShapes.put(it.toLong(), 0.75f) }
+        assertEquals(
+            PanoramaShapeMode.Wide,
+            panoramaShapeMode(PanoramaShapeMode.Unknown, total = 8) { it.toLong() },
+        )
+        PanoramaCoverShapes.resetForTest()
+        PanoramaCoverShapes.snapshotDispatcher = ImmediateShapeDispatcher
+        repeat(8) { PanoramaCoverShapes.put(it.toLong(), 0.76f) }
+        assertEquals(
+            PanoramaShapeMode.Tall,
+            panoramaShapeMode(PanoramaShapeMode.Unknown, total = 8) { it.toLong() },
+        )
+    }
+
+    @Test
+    fun `a sample needs half the shelf and at least eight committed covers`() {
+        assertEquals(
+            PanoramaShapeMode.Unknown,
+            nextPanoramaShapeMode(PanoramaShapeMode.Unknown, total = 40, known = 19, wide = 19),
+        )
+        assertEquals(
+            PanoramaShapeMode.Wide,
+            nextPanoramaShapeMode(PanoramaShapeMode.Unknown, total = 40, known = 20, wide = 20),
+        )
+        // A short shelf has to know every cover. total / 2 is below 8, so the floor is the shelf.
+        assertEquals(
+            PanoramaShapeMode.Unknown,
+            nextPanoramaShapeMode(PanoramaShapeMode.Unknown, total = 5, known = 4, wide = 4),
+        )
+        assertEquals(
+            PanoramaShapeMode.Wide,
+            nextPanoramaShapeMode(PanoramaShapeMode.Unknown, total = 5, known = 5, wide = 5),
+        )
+        // Below the line, a mode that was already chosen stays.
+        assertEquals(
+            PanoramaShapeMode.Wide,
+            nextPanoramaShapeMode(PanoramaShapeMode.Wide, total = 40, known = 19, wide = 0),
+        )
+    }
+
+    @Test
+    fun `wide columns enter at 0_60 and leave at 0_40`() {
+        // 10 known, need max(8, 5) = 8.
+        assertEquals(PanoramaShapeMode.Wide, sample(PanoramaShapeMode.Unknown, wide = 6))
+        assertEquals(PanoramaShapeMode.Tall, sample(PanoramaShapeMode.Unknown, wide = 5))
+        assertEquals(PanoramaShapeMode.Wide, sample(PanoramaShapeMode.Wide, wide = 5))
+        assertEquals(PanoramaShapeMode.Tall, sample(PanoramaShapeMode.Wide, wide = 4))
+        assertEquals(PanoramaShapeMode.Tall, sample(PanoramaShapeMode.Tall, wide = 5))
+        assertEquals(PanoramaShapeMode.Wide, sample(PanoramaShapeMode.Tall, wide = 6))
+    }
+
+    @Test
+    fun `shape mode updates when the grid settles and not when a cover is stored`() {
+        val state = PanoramaShapeModeState(PanoramaShapeMode.Unknown)
+        val firstShelf = { index: Int -> index.toLong() }
+        val signature = panoramaShapeListSignature(10, firstShelf)
+        fun signal(settled: Boolean) {
+            state.onGridSignal(
+                settled = settled,
+                total = 10,
+                mangaIdAt = firstShelf,
+                listSignature = signature,
+                shapeVersion = 1,
+            )
+        }
+        repeat(10) { PanoramaCoverShapes.put(it.toLong(), 0.50f) }
+        signal(settled = false)
+        assertEquals(PanoramaShapeMode.Unknown, state.mode)
+
+        signal(settled = true)
+        assertEquals(PanoramaShapeMode.Wide, state.mode)
+
+        // A repeated key does not sample again, even after the stored ratios change.
+        repeat(10) { PanoramaCoverShapes.put(it.toLong(), 1.60f) }
+        assertEquals(PanoramaShapeMode.Wide, state.mode)
+        signal(settled = true)
+        assertEquals(PanoramaShapeMode.Wide, state.mode)
+
+        signal(settled = false)
+        signal(settled = true)
+        assertEquals(PanoramaShapeMode.Tall, state.mode)
+    }
+
+    @Test
+    fun `a shape version bump while settled resamples without scrolling`() {
+        val state = PanoramaShapeModeState(PanoramaShapeMode.Unknown)
+        val ids = { index: Int -> index.toLong() }
+        val signature = panoramaShapeListSignature(10, ids)
+        state.onGridSignal(
+            settled = true,
+            total = 10,
+            mangaIdAt = ids,
+            listSignature = signature,
+            shapeVersion = PanoramaCoverShapes.committedShapeVersion.intValue,
+        )
+        assertEquals(PanoramaShapeMode.Unknown, state.mode)
+
+        // The shape file and every flush publish this version on the owner thread.
+        repeat(10) { PanoramaCoverShapes.put(it.toLong(), 0.50f) }
+        val version = PanoramaCoverShapes.committedShapeVersion.intValue
+        assertTrue(version > 0)
+        state.onGridSignal(
+            settled = true,
+            total = 10,
+            mangaIdAt = ids,
+            listSignature = signature,
+            shapeVersion = version,
+        )
+        assertEquals(PanoramaShapeMode.Wide, state.mode)
+    }
+
+    @Test
+    fun `the same count with different ids resamples once settled`() {
+        val state = PanoramaShapeModeState(PanoramaShapeMode.Unknown)
+        repeat(10) { PanoramaCoverShapes.put(it.toLong(), 0.50f) }
+        repeat(10) { PanoramaCoverShapes.put(1_000L + it, 1.60f) }
+        val wideShelf = { index: Int -> index.toLong() }
+        val tallShelf = { index: Int -> 1_000L + index }
+        val wideSignature = panoramaShapeListSignature(10, wideShelf)
+        val tallSignature = panoramaShapeListSignature(10, tallShelf)
+        assertNotEquals(wideSignature, tallSignature)
+        val version = PanoramaCoverShapes.committedShapeVersion.intValue
+        state.onGridSignal(true, 10, wideShelf, wideSignature, version)
+        assertEquals(PanoramaShapeMode.Wide, state.mode)
+        state.onGridSignal(true, 10, tallShelf, tallSignature, version)
+        assertEquals(PanoramaShapeMode.Tall, state.mode)
+
+        var reads = 0
+        panoramaShapeListSignature(2_000) {
+            reads++
+            it.toLong()
+        }
+        assertTrue(reads <= 5, "reads $reads")
+    }
+
+    private fun sample(current: PanoramaShapeMode, wide: Int): PanoramaShapeMode {
+        return nextPanoramaShapeMode(current, total = 10, known = 10, wide = wide)
+    }
+}
+
+private object ImmediateShapeDispatcher : PanoramaSnapshotDispatcher {
+    override fun isOwnerThread(): Boolean = true
+
+    override fun post(block: () -> Unit) {
+        block()
+    }
+}
