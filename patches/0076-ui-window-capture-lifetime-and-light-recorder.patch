@@ -0,0 +1,82 @@
+package tachiyomi.presentation.core.components
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.ExperimentalComposeUiApi
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.node.DelegatingNode
+import androidx.compose.ui.node.ModifierNodeElement
+import androidx.compose.ui.node.invalidateDraw
+import androidx.compose.ui.platform.InspectorInfo
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.platform.LocalView
+import androidx.compose.ui.platform.LocalWindowInfo
+import dev.chrisbanes.haze.ExperimentalHazeApi
+import dev.chrisbanes.haze.HazeSourceNode
+import dev.chrisbanes.haze.HazeState
+
+internal data class HazeViewport(
+    val owner: Any,
+    val width: Int,
+    val height: Int,
+    val density: Float,
+    val token: Any? = null,
+    val displayId: Int = -1,
+) {
+    val valid: Boolean get() = width > 0 && height > 0
+}
+
+/** Keep list composition and position; replace only the captured layer at a window boundary. */
+@Composable
+@OptIn(ExperimentalComposeUiApi::class)
+internal fun Modifier.windowHazeSource(state: HazeState, kind: Int): Modifier {
+    val size = LocalWindowInfo.current.containerSize
+    val view = LocalView.current
+    return viewportHazeSource(
+        state,
+        HazeViewport(view, size.width, size.height, LocalDensity.current.density, view.windowToken, view.display?.displayId ?: -1),
+        kind,
+    )
+}
+
+internal fun Modifier.viewportHazeSource(state: HazeState, viewport: HazeViewport, kind: Int): Modifier =
+    this.then(WindowHazeSourceElement(state, viewport, kind))
+
+private data class WindowHazeSourceElement(
+    val state: HazeState,
+    val viewport: HazeViewport,
+    val kind: Int,
+) : ModifierNodeElement<WindowHazeSourceNode>() {
+    override fun create() = WindowHazeSourceNode(state, viewport)
+    override fun update(node: WindowHazeSourceNode) = node.update(state, viewport, kind)
+    override fun InspectorInfo.inspectableProperties() {
+        name = "windowHazeSource"
+    }
+}
+
+@OptIn(ExperimentalHazeApi::class)
+private class WindowHazeSourceNode(state: HazeState, private var viewport: HazeViewport) :
+    DelegatingNode() {
+    private var source = delegate(HazeSourceNode(state))
+
+    fun update(state: HazeState, next: HazeViewport, nextKind: Int) {
+        val ownerChanged = viewport.owner !== next.owner || viewport.displayId != next.displayId ||
+            (viewport.token != null && next.token != null && viewport.token !== next.token)
+        val sizeChanged = viewport.valid && next.valid &&
+            (viewport.width != next.width || viewport.height != next.height || viewport.density != next.density)
+        if (ownerChanged || sizeChanged) {
+            // Haze 1.7.2 keeps the layer on ordinary size updates. Its public source-node
+            // lifecycle releases the old layer on detach and registers a fresh area on attach.
+            undelegate(source)
+            source = delegate(HazeSourceNode(state))
+            if (source.isAttached) source.invalidateDraw()
+            PanoramaScrollTrace.log(
+                0,
+                "glass viewport reset kind=$nextKind ${viewport.width}x${viewport.height}->${next.width}x${next.height} " +
+                    "density=${viewport.density}->${next.density} owner=$ownerChanged",
+            )
+        } else if (source.state !== state) {
+            source.state = state
+        }
+        if (next.valid || ownerChanged) viewport = next
+    }
+}
