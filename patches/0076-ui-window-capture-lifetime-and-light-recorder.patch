+package tachiyomi.presentation.core.components
+
+import android.app.Activity
+import android.os.Looper
+import android.view.View
+import android.view.ViewTreeObserver
+import android.widget.FrameLayout
+import org.junit.Assert.assertEquals
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [34])
+class NavigationChromeDrawPerfObserverTest {
+    @Test
+    fun anotherDrawListenerCanStopSamplingWithoutMutatingDispatch() {
+        val controller = Robolectric.buildActivity(Activity::class.java).setup()
+        val view = controller.get().window.decorView
+        var draws = 0
+        val observer = DrawPerfObserver(view) { draws++ }
+        val stopper = ViewTreeObserver.OnDrawListener { observer.stop() }
+        view.viewTreeObserver.addOnDrawListener(stopper)
+        observer.start()
+        view.viewTreeObserver.dispatchOnDraw()
+        assertEquals(0, draws)
+        shadowOf(Looper.getMainLooper()).idle()
+        view.viewTreeObserver.removeOnDrawListener(stopper)
+        view.viewTreeObserver.dispatchOnDraw()
+        assertEquals(0, draws)
+        controller.pause().stop().destroy()
+    }
+
+    @Test
+    fun detachAndReattachMovesTheListenerWithoutRevivingTheOldOwner() {
+        val controller = Robolectric.buildActivity(Activity::class.java).setup()
+        val activity = controller.get()
+        val root = FrameLayout(activity)
+        activity.setContentView(root)
+        val view = View(activity)
+        var draws = 0
+        val observer = DrawPerfObserver(view) { draws++ }
+        observer.start()
+        root.addView(view)
+        root.viewTreeObserver.dispatchOnDraw()
+        assertEquals(1, draws)
+        root.removeView(view)
+        root.viewTreeObserver.dispatchOnDraw()
+        assertEquals(1, draws)
+        root.addView(view)
+        root.viewTreeObserver.dispatchOnDraw()
+        assertEquals(2, draws)
+        observer.stop()
+        root.viewTreeObserver.dispatchOnDraw()
+        assertEquals(2, draws)
+        controller.pause().stop().destroy()
+    }
+
+    @Test
+    fun actualDrawDispatchStopsAndRestartsWithoutDuplicateDelivery() {
+        val controller = Robolectric.buildActivity(Activity::class.java).setup()
+        val view = controller.get().window.decorView
+        var draws = 0
+        val observer = DrawPerfObserver(view) { draws++ }
+        observer.start()
+        observer.start()
+        view.viewTreeObserver.dispatchOnDraw()
+        assertEquals(1, draws)
+        observer.stop()
+        view.viewTreeObserver.dispatchOnDraw()
+        assertEquals(1, draws)
+        observer.start()
+        view.viewTreeObserver.dispatchOnDraw()
+        assertEquals(2, draws)
+        observer.stop()
+        controller.pause().stop().destroy()
+    }
+
+    @Test
+    fun stopAcrossAttachmentDisablesBothCapturedAndCurrentObserver() {
+        val controller = Robolectric.buildActivity(Activity::class.java).setup()
+        val activity = controller.get()
+        val view = View(activity)
+        val captured = view.viewTreeObserver
+        var draws = 0
+        val observer = DrawPerfObserver(view) { draws++ }
+        observer.start()
+        captured.dispatchOnDraw()
+        assertEquals(1, draws)
+        activity.setContentView(view)
+        observer.stop()
+        if (captured.isAlive) captured.dispatchOnDraw()
+        view.viewTreeObserver.dispatchOnDraw()
+        assertEquals(1, draws)
+        observer.start()
+        view.viewTreeObserver.dispatchOnDraw()
+        assertEquals(2, draws)
+        observer.stop()
+        controller.pause().stop().destroy()
+    }
+
+    @Test
+    fun stoppingInsideDrawDefersRemovalButImmediatelyPreventsDelivery() {
+        val controller = Robolectric.buildActivity(Activity::class.java).setup()
+        val view = controller.get().window.decorView
+        var draws = 0
+        lateinit var observer: DrawPerfObserver
+        observer = DrawPerfObserver(view) {
+            draws++
+            observer.stop()
+        }
+        observer.start()
+        view.viewTreeObserver.dispatchOnDraw()
+        view.viewTreeObserver.dispatchOnDraw()
+        assertEquals(1, draws)
+        shadowOf(Looper.getMainLooper()).idle()
+        view.viewTreeObserver.dispatchOnDraw()
+        assertEquals(1, draws)
+        observer.start()
+        view.viewTreeObserver.dispatchOnDraw()
+        assertEquals(2, draws)
+        shadowOf(Looper.getMainLooper()).idle()
+        controller.pause().stop().destroy()
+    }
+}
