+    @Test
+    fun `rows inserted at the front with the same epoch rebuild instead of appending`() {
+        val cache = PanoramaMasonryLayoutCache()
+        val lanes = intArrayOf(100, 100)
+        val epoch = 11L
+        val firstKeys = listOf("a", "b", "c", "d")
+        cache.layout(
+            count = firstKeys.size,
+            contentEpoch = epoch,
+            heightOf = { _, _ -> 100 },
+            laneWidths = lanes,
+            verticalSpacing = 0,
+            horizontalSpacing = 0,
+            rtl = false,
+            keyAt = { firstKeys[it] },
+        )
+        assertFalse(cache.structuralChange)
+        val secondKeys = listOf("new", "a", "b", "c", "d")
+        fun height(index: Int): Int = if (index == 0) 200 else 100
+        var probedFirst = false
+        val rebuilt = cache.layout(
+            count = secondKeys.size,
+            contentEpoch = epoch,
+            heightOf = { index, _ ->
+                if (index == 0) probedFirst = true
+                height(index)
+            },
+            laneWidths = lanes,
+            verticalSpacing = 0,
+            horizontalSpacing = 0,
+            rtl = false,
+            keyAt = { secondKeys[it] },
+            previousKeys = firstKeys,
+        )
+        assertTrue(cache.structuralChange)
+        assertTrue(probedFirst)
+        assertEquals(200, rebuilt.rects[0].height)
+        val full = layoutPanoramaMasonry(
+            count = secondKeys.size,
+            heightOf = { index, _ -> height(index) },
+            laneWidths = lanes,
+            verticalSpacing = 0,
+            horizontalSpacing = 0,
+        )
+        assertEquals(full.rects.map { it.y }, rebuilt.rects.map { it.y })
+        assertEquals(full.rects.map { it.height }, rebuilt.rects.map { it.height })
+    }
