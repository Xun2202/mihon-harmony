+/** Largest index whose cell intersects the viewport, or [firstVisible] when none does. */
+private fun lastVisibleItemIndex(
+    rects: List<PanoramaMasonryRect>,
+    scrollPx: Int,
+    viewport: Int,
+    topPadding: Int,
+    firstVisible: Int,
+): Int {
+    if (rects.isEmpty()) return firstVisible
+    val viewBottom = scrollPx + viewport
+    var last = firstVisible
+    for (rect in rects) {
+        val top = topPadding + rect.y
+        val bottom = top + rect.height
+        if (bottom > scrollPx && top < viewBottom && rect.index > last) {
+            last = rect.index
+        }
+    }
+    return last
+}
