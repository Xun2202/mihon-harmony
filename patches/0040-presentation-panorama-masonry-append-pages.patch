+/** High 32 bits of [panoramaContentEpoch]. Small test epochs share shape 0. */
+private fun shapeEpoch(contentEpoch: Long): Long = contentEpoch ushr 32
+
+/**
+ * Index to place from, or -1 when the prefix is not reusable.
+ * [previousKeys] is the list aligned with [previous].rects. A full match appends after it.
+ * A mismatch only on the last key redoes that one cell. Anything earlier rebuilds.
+ */
+private fun restartIndex(
+    previous: PanoramaMasonryLayout,
+    previousKeys: List<Any>?,
+    keyAt: ((Int) -> Any)?,
+): Int {
+    if (previousKeys == null || keyAt == null) return -1
+    val oldCount = previous.rects.size
+    if (oldCount == 0 || previousKeys.size != oldCount) return -1
+    var mismatch = oldCount
+    for (index in 0 until oldCount) {
+        if (keyAt(index) != previousKeys[index]) {
+            mismatch = index
+            break
+        }
+    }
+    if (mismatch < oldCount - 1) return -1
+    return mismatch
+}
