+/**
+ * Keeps [previous] through [fromIndex] and places the rest again.
+ * Lane bottoms are rebuilt from the kept rectangles, so a trailing footer can be replaced
+ * without moving the cells above it.
+ */
+private fun relayoutPanoramaTail(
+    previous: PanoramaMasonryLayout,
+    fromIndex: Int,
+    count: Int,
+    spanOf: (Int) -> PanoramaSpan,
+    heightOf: (index: Int, widthPx: Int) -> Int,
+    pairPick: PanoramaPairPick = PANORAMA_PAIR_PICK,
+): PanoramaMasonryLayout {
+    val kept = fromIndex.coerceIn(0, previous.rects.size)
+    val rects = ArrayList<PanoramaMasonryRect>(count)
+    var contentHeight = 0
+    for (index in 0 until kept) {
+        val rect = previous.rects[index]
+        rects.add(rect)
+        val bottom = rect.y + rect.height
+        if (bottom > contentHeight) contentHeight = bottom
+    }
+    val bottoms = laneBottomsBefore(previous, kept)
+    val contentWidth = previous.contentWidth
+    for (index in kept until count) {
+        val rect = placeItem(
+            index = index,
+            span = spanOf(index),
+            heightOf = heightOf,
+            laneWidths = previous.laneWidths,
+            offsets = previous.laneOffsets,
+            bottoms = bottoms,
+            contentWidth = contentWidth,
+            verticalSpacing = previous.verticalSpacing,
+            horizontalSpacing = previous.horizontalSpacing,
+            pairPick = pairPick,
+        )
+        rects.add(rect)
+        val bottom = rect.y + rect.height
+        if (bottom > contentHeight) contentHeight = bottom
+    }
+    return PanoramaMasonryLayout(
+        laneWidths = previous.laneWidths,
+        laneOffsets = previous.laneOffsets,
+        verticalSpacing = previous.verticalSpacing,
+        horizontalSpacing = previous.horizontalSpacing,
+        rtl = previous.rtl,
+        rects = rects,
+        laneBottoms = bottoms,
+        contentHeight = contentHeight,
+    )
+}
+
+/** Lane bottoms after [end] items, including the spacing that follows each lane's last item. */
+private fun laneBottomsBefore(previous: PanoramaMasonryLayout, end: Int): IntArray {
+    val bottoms = IntArray(previous.laneWidths.size)
+    val spacing = previous.verticalSpacing
+    val limit = end.coerceIn(0, previous.rects.size)
+    for (index in 0 until limit) {
+        val rect = previous.rects[index]
+        val laneEnd = rect.y + rect.height + spacing
+        if (rect.fullLine) {
+            for (lane in bottoms.indices) bottoms[lane] = laneEnd
+            continue
+        }
+        val occupied = panoramaLaneSpan(rect.span, bottoms.size).coerceAtLeast(1)
+        for (offset in 0 until occupied) {
+            val lane = rect.lane + offset
+            if (lane in bottoms.indices && laneEnd > bottoms[lane]) bottoms[lane] = laneEnd
+        }
+    }
+    return bottoms
+}
