@@ -0,0 +1,25 @@
+package eu.kanade.presentation.components
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+import java.time.Instant
+import java.time.ZoneId
+import java.util.Locale
+
+class TimelineTimeTest {
+    @Test
+    fun `midnight and afternoon remain ASCII 24 hour time in AM PM and Arabic locales`() {
+        val previous = Locale.getDefault()
+        try {
+            for (locale in listOf(Locale.US, Locale.forLanguageTag("ar-EG"))) {
+                Locale.setDefault(locale)
+                val zone = ZoneId.of("UTC")
+                assertEquals("00:00", timelineTime(Instant.parse("2026-10-26T00:00:00Z").toEpochMilli(), zone))
+                assertEquals("13:05", timelineTime(Instant.parse("2026-10-26T13:05:00Z").toEpochMilli(), zone))
+                assertEquals("", timelineTime(null, zone))
+            }
+        } finally {
+            Locale.setDefault(previous)
+        }
+    }
+}
