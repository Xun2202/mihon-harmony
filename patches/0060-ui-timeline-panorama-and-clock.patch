+package eu.kanade.presentation.components
+
+import androidx.compose.foundation.layout.BoxWithConstraints
+import androidx.compose.foundation.layout.PaddingValues
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.CompositionLocalProvider
+import androidx.compose.runtime.compositionLocalOf
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalDensity
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import eu.kanade.presentation.library.components.LocalPanoramaGridSettled
+import eu.kanade.presentation.library.components.PanoramaCoverShapes
+import eu.kanade.presentation.library.components.PanoramaShapeMode
+import eu.kanade.presentation.library.components.TrackPanoramaCoverShapes
+import eu.kanade.presentation.library.components.panoramaAutoColumns
+import eu.kanade.presentation.library.components.panoramaCoverSpan
+import eu.kanade.presentation.library.components.rememberPanoramaGridSettled
+import eu.kanade.presentation.library.components.rememberPanoramaShapeModeState
+import tachiyomi.presentation.core.components.PanoramaColumns
+import tachiyomi.presentation.core.components.TimelineGrid
+import tachiyomi.presentation.core.components.TimelinePanoramaGrid
+import tachiyomi.presentation.core.components.rememberPanoramaMasonryState
+
+internal val LocalTimelineCoverWide = compositionLocalOf<Boolean?> { null }
+
+@Composable
+internal fun TimelineLayout(
+    count: Int,
+    key: (Int) -> Any,
+    fullLine: (Int) -> Boolean,
+    mangaIdAt: (Int) -> Long?,
+    display: TimelineDisplay,
+    minColumnWidth: Dp,
+    contentPadding: PaddingValues,
+    content: @Composable (Int) -> Unit,
+) {
+    if (display.mode != TimelineDisplayMode.Panorama) {
+        TimelineGrid(
+            count,
+            key,
+            fullLine,
+            if (display.mode == TimelineDisplayMode.List) 1 else display.columns,
+            minColumnWidth,
+            contentPadding,
+            content = content,
+        )
+        return
+    }
+    val state = rememberPanoramaMasonryState()
+    val shapeMode = rememberPanoramaShapeModeState()
+    val settled = rememberPanoramaGridSettled { state.isScrollInProgress }
+    CompositionLocalProvider(LocalPanoramaGridSettled provides settled) {
+        TrackPanoramaCoverShapes(count, shapeMode, mangaIdAt)
+        val mode = shapeMode.mode
+        // Keep the page's chosen bands stable as covers load; a shelf mode change refreshes them.
+        val bands = remember(mode) { HashMap<Long, Boolean>() }
+        fun wide(index: Int): Boolean {
+            val id = mangaIdAt(index) ?: return false
+            return bands.getOrPut(id) {
+                (PanoramaCoverShapes.get(id) ?: PanoramaCoverShapes.committedRatioOrNull(id))
+                    ?.let { it <= 0.75f } ?: (mode == PanoramaShapeMode.Wide)
+            }
+        }
+        val minLane = with(LocalDensity.current) { maxOf(140.dp, 88.dp + 44.sp.toDp()) }
+        val shelfColumns = panoramaAutoColumns(mode)
+        BoxWithConstraints(Modifier.fillMaxSize()) {
+            val fittedColumns = display.columns.coerceAtMost(
+                ((maxWidth - 2.dp) / (minLane + 3.dp)).toInt().coerceAtLeast(1),
+            )
+            val columns = when {
+                fittedColumns > 0 -> PanoramaColumns.Fixed(fittedColumns)
+                shelfColumns is PanoramaColumns.Shaped -> shelfColumns.copy(
+                    minLane = maxOf(shelfColumns.minLane, minLane),
+                )
+                shelfColumns is PanoramaColumns.Adaptive -> PanoramaColumns.Adaptive(
+                    maxOf(shelfColumns.minSize, minLane),
+                )
+                else -> shelfColumns
+            }
+            TimelinePanoramaGrid(
+                count = count,
+                key = key,
+                fullLine = fullLine,
+                wide = ::wide,
+                span = { panoramaCoverSpan(wide(it), mode) },
+                columns = columns,
+                contentPadding = contentPadding,
+                state = state,
+            ) { index ->
+                CompositionLocalProvider(LocalTimelineCoverWide provides wide(index)) { content(index) }
+            }
+        }
+    }
+}
