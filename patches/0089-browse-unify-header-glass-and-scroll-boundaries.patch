+
+/** Compact browse titles share the main toolbar with their horizontally scrollable filters. */
+@Composable
+fun BrowsingToolbarTitle(title: @Composable () -> Unit, content: @Composable () -> Unit) {
+    Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
+        Box(Modifier.widthIn(max = 80.dp).padding(end = 4.dp)) {
+            ProvideTextStyle(MaterialTheme.typography.titleMedium, content = title)
+        }
+        Box(Modifier.weight(1f)) { content() }
+    }
+}
+
+@Composable
+fun BrowsingFilterRow(state: ScrollState, modifier: Modifier = Modifier, content: @Composable RowScope.() -> Unit) {
+    val height = navigationToolbarHeight()
+    CompositionLocalProvider(LocalMinimumInteractiveComponentSize provides minOf(height, 48.dp)) {
+        Row(
+            modifier.height(height).horizontalScroll(state, flingBehavior = rememberFrameTimeProtectedFlingBehavior()).padding(horizontal = 4.dp),
+            horizontalArrangement = Arrangement.spacedBy(4.dp),
+            verticalAlignment = Alignment.CenterVertically,
+            content = content,
+        )
+    }
+}
