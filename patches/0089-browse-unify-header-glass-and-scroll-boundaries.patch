+
+    @Test
+    fun `list returning to first item commits revealed navigation beyond the spacer`() = assertLeadingBoundary(false)
+
+    @Test
+    fun `grid returning to first row commits revealed navigation beyond the spacer`() = assertLeadingBoundary(true)
+
+    private fun assertLeadingBoundary(grid: Boolean) = runComposeUiTest {
+        lateinit var chrome: BrowsingNavigationBarState
+        lateinit var scope: CoroutineScope
+        lateinit var jump: suspend (Int) -> Unit
+        setContent {
+            CompositionLocalProvider(LocalDensity provides Density(1f)) {
+                chrome = rememberBrowsingNavigationBarState(enabled = true, resetKey = Unit)
+                scope = rememberCoroutineScope()
+                Box(Modifier.requiredSize(400.dp, 600.dp)) {
+                    CompositionLocalProvider(LocalBrowsingNavigationBarState provides chrome) {
+                        Scaffold(
+                            topBarScrollBehavior = rememberBrowsingTopAppBarScrollBehavior(),
+                            topBar = { Box(Modifier.height(40.dp)) },
+                        ) { padding ->
+                            if (grid) {
+                                val scroll = rememberLazyGridState(initialFirstVisibleItemIndex = 20)
+                                jump = { scroll.scrollToItem(it) }
+                                FastScrollLazyVerticalGrid(columns = GridCells.Fixed(2), state = scroll, contentPadding = padding) {
+                                    items(100) { Box(Modifier.height(80.dp)) }
+                                }
+                            } else {
+                                val scroll = rememberLazyListState(initialFirstVisibleItemIndex = 20)
+                                jump = { scroll.scrollToItem(it) }
+                                FastScrollLazyColumn(state = scroll, contentPadding = padding) {
+                                    items(100) { Box(Modifier.height(80.dp)) }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        runOnIdle {
+            chrome.nestedScrollConnection.onPostScroll(Offset(0f, -40f), Offset.Zero, NestedScrollSource.UserInput)
+            assertFalse(chrome.visible)
+        }
+        waitForIdle()
+        runOnIdle { scope.launch { jump(0) } }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(chrome.visible)
+            assertEquals(0f, chrome.hiddenFraction, 0.01f)
+            scope.launch { jump(20) }
+        }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(chrome.visible, "Leaving the spacer must not restore an old hidden target")
+            assertEquals(0f, chrome.hiddenFraction, 0.01f)
+        }
+    }
+}
