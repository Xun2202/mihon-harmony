+
+@OptIn(ExperimentalTestApi::class)
+@RunWith(RobolectricTestRunner::class)
+@GraphicsMode(GraphicsMode.Mode.LEGACY)
+@Config(sdk = [34])
+class TimelineGridTest {
+    @Test
+    fun `ten thousand records compose only viewport cells including distant jumps`() = runComposeUiTest {
+        val composed = mutableSetOf<Int>()
+        lateinit var state: LazyStaggeredGridState
+        lateinit var scope: CoroutineScope
+        setContent {
+            MaterialTheme {
+                state = rememberLazyStaggeredGridState()
+                scope = rememberCoroutineScope()
+                Box(Modifier.width(360.dp).height(640.dp)) {
+                    TimelineGrid(10000, {
+                        "record-$it"
+                    }, { it % 25 == 0 }, 2, 140.dp, PaddingValues(), state = state) { index ->
+                        SideEffect { composed.add(index) }
+                        Box(
+                            Modifier.height(
+                                if (index % 25 == 0) {
+                                    32.dp
+                                } else if (index % 2 == 0) {
+                                    150.dp
+                                } else {
+                                    220.dp
+                                },
+                            ),
+                        )
+                    }
+                }
+            }
+        }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(composed.size in 1..100, "Initial composition: ${composed.size}")
+            scope.launch { state.scrollToItem(8000) }
+        }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(state.firstVisibleItemIndex > 7900)
+            assertTrue(composed.size < 200, "Offscreen records were composed: ${composed.size}")
+        }
+    }
+
+    @Test
+    fun `detail return restores position and survives fold and a shortened history`() = runComposeUiTest {
+        var shown by mutableStateOf(true)
+        var expanded by mutableStateOf(false)
+        var count by mutableIntStateOf(10000)
+        lateinit var state: LazyStaggeredGridState
+        lateinit var scope: CoroutineScope
+        setContent {
+            val holder = rememberSaveableStateHolder()
+            MaterialTheme {
+                scope = rememberCoroutineScope()
+                if (shown) {
+                    holder.SaveableStateProvider("history") {
+                        state = rememberLazyStaggeredGridState()
+                        Box(Modifier.width(if (expanded) 700.dp else 360.dp).height(640.dp)) {
+                            TimelineGrid(count, {
+                                "record-$it"
+                            }, { it % 25 == 0 }, 0, 140.dp, PaddingValues(), state = state) { index ->
+                                Box(Modifier.height(if (index % 25 == 0) 32.dp else 180.dp))
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        runOnIdle { scope.launch { state.scrollToItem(8000) } }
+        waitForIdle()
+        runOnIdle { shown = false }
+        waitForIdle()
+        runOnIdle {
+            shown = true
+            expanded = true
+        }
+        waitForIdle()
+        runOnIdle { assertTrue(state.firstVisibleItemIndex in 7900..8100) }
+        runOnIdle { shown = false }
+        waitForIdle()
+        runOnIdle {
+            count = 40
+            shown = true
+            expanded = false
+        }
+        waitForIdle()
+        runOnIdle {
+            assertTrue(state.layoutInfo.visibleItemsInfo.isNotEmpty())
+            assertTrue(state.firstVisibleItemIndex in 0..39)
+        }
+    }
+}
