+import tachiyomi.domain.manga.model.MangaCover as CoverData
+
+@Composable
+internal fun TimelineCover(data: CoverData, mode: TimelineDisplayMode, modifier: Modifier = Modifier) {
+    // Freeze only composed cards. Save the band with the item across detail return/rotation.
+    val ratio = rememberSaveable(data.mangaId) {
+        PanoramaCoverShapes.get(data.mangaId) ?: PanoramaCoverShapes.committedRatioOrNull(data.mangaId) ?: 1.5f
+    }
+    val shape = if (mode == TimelineDisplayMode.Panorama && ratio <= 0.75f) MangaCover.Panorama else MangaCover.Book
+    shape(
+        data = data,
+        modifier = modifier,
+        onCoverLoaded = { result ->
+            val image = result.result.image
+            if (image.width > 0) PanoramaCoverShapes.put(data.mangaId, image.height.toFloat() / image.width)
+        },
+    )
+}
+
+@Composable
+internal fun TimelineCard(
+    title: String,
+    subtitle: String?,
+    coverData: CoverData,
+    mode: TimelineDisplayMode,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    selected: Boolean = false,
+    muted: Boolean = false,
+    onLongClick: (() -> Unit)? = null,
+    badge: @Composable () -> Unit = {},
+    footer: @Composable () -> Unit,
+) {
+    val haptic = LocalHapticFeedback.current
+    val titleColor = if (muted) MaterialTheme.colorScheme.onSurfaceVariant else MaterialTheme.colorScheme.onSurface
+    val overlayColor = Color.White.copy(alpha = if (muted) 0.65f else 1f)
+    val cardModifier = modifier.fillMaxWidth().clip(MaterialTheme.shapes.small)
+        .background(MaterialTheme.colorScheme.surfaceContainerLow)
+        .selectedBackground(selected)
+        .border(
+            2.dp,
+            if (selected) MaterialTheme.colorScheme.primary else Color.Transparent,
+            MaterialTheme.shapes.small,
+        )
+        .combinedClickable(
+            onClick = onClick,
+            onLongClick = onLongClick?.let { action ->
+                {
+                    haptic.performHapticFeedback(HapticFeedbackType.LongPress)
+                    action()
+                }
+            },
+        )
+    if (mode == TimelineDisplayMode.List) {
+        Row(cardModifier, verticalAlignment = Alignment.CenterVertically) {
+            TimelineCover(coverData, mode, Modifier.width(64.dp))
+            Column(Modifier.weight(1f).padding(horizontal = 6.dp)) {
+                Text(
+                    title,
+                    color = titleColor,
+                    maxLines = 2,
+                    overflow = TextOverflow.Ellipsis,
+                    style = MaterialTheme.typography.bodyMedium,
+                )
+                if (subtitle !=
+                    null
+                ) {
+                    Text(
+                        subtitle,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis,
+                        style = MaterialTheme.typography.labelSmall,
+                    )
+                }
+                badge()
+                footer()
+            }
+        }
+    } else {
+        Column(cardModifier) {
+            Box {
+                TimelineCover(coverData, mode, Modifier.fillMaxWidth())
+                Column(
+                    Modifier.align(Alignment.BottomStart).fillMaxWidth()
+                        .background(Brush.verticalGradient(listOf(Color.Transparent, Color.Black.copy(alpha = 0.85f))))
+                        .padding(start = 6.dp, end = 6.dp, top = 16.dp, bottom = 5.dp),
+                ) {
+                    Text(
+                        title,
+                        color = overlayColor,
+                        fontWeight = FontWeight.Medium,
+                        maxLines = 2,
+                        overflow = TextOverflow.Ellipsis,
+                        style = MaterialTheme.typography.bodySmall,
+                    )
+                    if (subtitle !=
+                        null
+                    ) {
+                        Text(
+                            subtitle,
+                            color = Color.White.copy(alpha = 0.85f),
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis,
+                            style = MaterialTheme.typography.labelSmall,
+                        )
+                    }
+                }
+                Box(Modifier.align(Alignment.TopStart).padding(4.dp)) { badge() }
+            }
+            footer()
+        }
+    }
+}
