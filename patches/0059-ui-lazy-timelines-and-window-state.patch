+// Native lazy timeline: progress is item based; no offscreen cell measurement.
+@Composable
+internal fun VerticalTimelineFastScroller(
+    state: androidx.compose.foundation.lazy.staggeredgrid.LazyStaggeredGridState,
+    modifier: Modifier = Modifier,
+    thumbAllowed: () -> Boolean = { true },
+    thumbColor: Color = MaterialTheme.colorScheme.primary,
+    topContentPadding: Dp = Dp.Hairline,
+    bottomContentPadding: Dp = Dp.Hairline,
+    endContentPadding: Dp = Dp.Hairline,
+    content: @Composable () -> Unit,
+) {
+    val thumbGlass = rememberFastScrollerGlass()
+    SubcomposeLayout(modifier = modifier) { constraints ->
+        val contentPlaceable = subcompose("content") {
+            Box(Modifier.fastScrollerGlassSource(thumbGlass), propagateMinConstraints = true) { content() }
+        }.map { it.measure(constraints) }
+        val contentHeight = contentPlaceable.fastMaxBy { it.height }?.height ?: 0
+        val contentWidth = contentPlaceable.fastMaxBy { it.width }?.width ?: 0
+
+        val scrollerConstraints = constraints.copy(minWidth = 0, minHeight = 0)
+        val scrollerPlaceable = subcompose("scroller") {
+            if (!state.canScrollForward && !state.canScrollBackward) return@subcompose
+            val dragInteractionSource = remember { MutableInteractionSource() }
+            // State object so the fade coroutine sees a drag that starts after it is already waiting.
+            val isThumbDraggedState = dragInteractionSource.collectIsDraggedAsState()
+            val isThumbDragged by isThumbDraggedState
+            val thumbPressed = rememberThumbPressed()
+            val density = LocalDensity.current
+            val (trackTopPadding, trackBottomPadding) = rememberBrowsingScrollInsets(
+                topContentPadding = topContentPadding,
+                bottomContentPadding = maxOf(
+                    bottomContentPadding,
+                    with(density) { state.layoutInfo.afterContentPadding.toDp() },
+                ),
+                dragging = isThumbDragged || thumbPressed.pressed,
+            )
+            val thumbTopPadding = with(density) { trackTopPadding.toPx() }
+            val thumbBottomPadding = with(density) { trackBottomPadding.toPx() }
+            var thumbOffsetY by remember { mutableFloatStateOf(thumbTopPadding) }
+            val scrolled = remember {
+                MutableSharedFlow<Unit>(
+                    extraBufferCapacity = 1,
+                    onBufferOverflow = BufferOverflow.DROP_OLDEST,
+                )
+            }
+
+            val heightPx = contentHeight.toFloat() - thumbTopPadding - thumbBottomPadding
+            val thumbHeightPx = with(LocalDensity.current) { ThumbLength.toPx() }
+            val trackHeightPx = heightPx - thumbHeightPx
+            if (trackHeightPx <= 0f) return@subcompose
+
+            LaunchedEffect(thumbOffsetY) {
+                if (!isThumbDragged) return@LaunchedEffect
+                val ratio = ((thumbOffsetY - thumbTopPadding) / trackHeightPx).coerceIn(0f, 1f)
+                state.scrollToItem((ratio * (state.layoutInfo.totalItemsCount - 1)).roundToInt().coerceAtLeast(0))
+                scrolled.tryEmit(Unit)
+            }
+
+            val lastScrollOffset = remember { MutableData(Float.NaN) }
+            // Harmony: a fling moves the offset every frame, and restarting this effect
+            // stalled the shelf. The collector stays up and still skips a grabbed thumb.
+            LaunchedEffect(trackHeightPx, thumbTopPadding, isThumbDragged) {
+                snapshotFlow {
+                    Triple(
+                        state.firstVisibleItemIndex.toFloat(),
+                        (state.layoutInfo.totalItemsCount - 1).coerceAtLeast(1).toFloat(),
+                        state.canScrollForward,
+                    )
+                }.collect { (scrollOffset, maxScroll, canScrollForward) ->
+                    if (isThumbDraggedState.value) return@collect
+                    val proportion = if (!canScrollForward) {
+                        1f
+                    } else {
+                        (scrollOffset / maxScroll).coerceIn(0f, 1f)
+                    }
+                    val target = trackHeightPx * proportion + thumbTopPadding
+                    if (scrollOffset != lastScrollOffset.value) {
+                        lastScrollOffset.value = scrollOffset
+                        scrolled.tryEmit(Unit)
+                    }
+                    thumbOffsetY = target
+                }
+            }
+
+            val alpha = remember { Animatable(0f) }
+            val isThumbVisible = alpha.value > 0f
+            LaunchedEffect(scrolled, alpha) {
+                scrolled
+                    .sample(100)
+                    .collectLatest {
+                        alpha.holdOpaqueWhileThumbGrabbed(
+                            held = { thumbPressed.pressed || isThumbDraggedState.value },
+                            thumbAllowed = thumbAllowed,
+                        ) {
+                            animateTo(
+                                0f,
+                                animationSpec = FastScrollerFadeOutAnimationSpec,
+                            )
+                        }
+                    }
+            }
+
+            // Stay draggable while scrollToOffset reports a scroll, or the drag gesture is
+            // cancelled on the frame that applies it. pressed / isThumbDragged keep the same
+            // pointer attached after the thumb would otherwise have faded out.
+            HarmonyScrollerThumb(
+                offsetY = thumbOffsetY,
+                alpha = alpha.value,
+                thumbColor = thumbColor,
+                glassState = thumbGlass,
+                endInset = endContentPadding,
+                touchEnabled = isThumbVisible || thumbPressed.pressed || isThumbDragged,
+                pressState = thumbPressed,
+                interactionSource = dragInteractionSource,
+                contentScrolling = { state.isScrollInProgress },
+                onDragDelta = { delta ->
+                    val newOffsetY = thumbOffsetY + delta
+                    thumbOffsetY = newOffsetY.coerceIn(
+                        thumbTopPadding,
+                        thumbTopPadding + trackHeightPx,
+                    )
+                },
+                excludeSystemGestures = (isThumbVisible || thumbPressed.pressed) &&
+                    !isThumbDragged &&
+                    !state.isScrollInProgress,
+            )
+        }.map { it.measure(scrollerConstraints) }
+        val scrollerWidth = scrollerPlaceable.fastMaxBy { it.width }?.width ?: 0
+
+        layout(contentWidth, contentHeight) {
+            contentPlaceable.fastForEach {
+                it.place(0, 0)
+            }
+            scrollerPlaceable.fastForEach {
+                it.placeRelative(contentWidth - scrollerWidth, 0)
+            }
+        }
+    }
+}
