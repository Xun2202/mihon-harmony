+package tachiyomi.presentation.core.components
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.BoxWithConstraints
+import androidx.compose.foundation.layout.PaddingValues
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.lazy.staggeredgrid.LazyStaggeredGridState
+import androidx.compose.foundation.lazy.staggeredgrid.LazyVerticalStaggeredGrid
+import androidx.compose.foundation.lazy.staggeredgrid.StaggeredGridCells
+import androidx.compose.foundation.lazy.staggeredgrid.StaggeredGridItemSpan
+import androidx.compose.foundation.lazy.staggeredgrid.rememberLazyStaggeredGridState
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import tachiyomi.presentation.core.components.material.browsingTrailingRemaining
+import tachiyomi.presentation.core.components.material.observeBrowsingLeadingScroll
+import tachiyomi.presentation.core.util.plus
+
+/** Dates span every lane; only viewport items are composed, including on state restoration. */
+@Composable
+fun TimelineGrid(
+    count: Int,
+    key: (Int) -> Any,
+    fullLine: (Int) -> Boolean,
+    columns: Int,
+    minColumnWidth: Dp,
+    contentPadding: PaddingValues,
+    modifier: Modifier = Modifier,
+    state: LazyStaggeredGridState = rememberLazyStaggeredGridState(),
+    content: @Composable (Int) -> Unit,
+) {
+    BoxWithConstraints(modifier.fillMaxSize()) {
+        val fittedColumns = if (columns > 1) {
+            columns.coerceAtMost((maxWidth / 140.dp).toInt().coerceAtLeast(1))
+        } else {
+            columns
+        }
+        VerticalTimelineFastScroller(
+            state = state,
+            modifier = Modifier.fillMaxSize().observeBrowsingLeadingScroll(
+                trailingRemaining = {
+                    val info = state.layoutInfo
+                    browsingTrailingRemaining(
+                        terminalVisible = info.totalItemsCount > 0 &&
+                            info.visibleItemsInfo.any { it.index == info.totalItemsCount - 1 },
+                        lastItemBottom = info.visibleItemsInfo.maxOfOrNull { it.offset.y + it.size.height } ?: 0,
+                        afterPadding = info.afterContentPadding,
+                        viewportEnd = info.viewportEndOffset,
+                    )
+                },
+            ) {
+                state.layoutInfo.visibleItemsInfo.firstOrNull { it.index == 0 }
+                    ?.let { -it.offset.y.toFloat() } ?: Float.POSITIVE_INFINITY
+            },
+            topContentPadding = contentPadding.calculateTopPadding(),
+            bottomContentPadding = contentPadding.calculateBottomPadding(),
+        ) {
+            LazyVerticalStaggeredGrid(
+                columns = if (fittedColumns > 0) {
+                    StaggeredGridCells.Fixed(fittedColumns)
+                } else {
+                    StaggeredGridCells.Adaptive(minColumnWidth)
+                },
+                state = state,
+                modifier = Modifier.fillMaxSize(),
+                contentPadding = contentPadding + PaddingValues(horizontal = 1.dp, vertical = 3.dp),
+                horizontalArrangement = Arrangement.spacedBy(3.dp),
+                verticalItemSpacing = 3.dp,
+            ) {
+                items(
+                    count = count,
+                    key = key,
+                    contentType = { if (fullLine(it)) "heading" else "card" },
+                    span = { if (fullLine(it)) StaggeredGridItemSpan.FullLine else StaggeredGridItemSpan.SingleLane },
+                ) { content(it) }
+            }
+        }
+    }
+}
