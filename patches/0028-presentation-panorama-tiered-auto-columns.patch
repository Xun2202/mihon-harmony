+     * pane. [android.content.res.Configuration.screenWidthDp] is the device width and is not
+     * read here. Lane count is still [staggeredLaneCountAdaptive].
+     *
+     * [Adaptive] stays the single-minimum StaggeredGridCells.Adaptive rule. [Tiered] carries
+     * the breakpoint with the two minima, and measure selects that branch on its own.
+     */
+    data class Tiered(
+        val compactMin: Dp,
+        val expandedMin: Dp,
+        val breakpoint: Dp,
+    ) : PanoramaColumns
 }
 
 /**
@@ -547,6 +565,20 @@ private fun LazyLayoutMeasureScope.measureMasonry(
             spacing = horizontalPx,
             minSize = columns.minSize.roundToPx(),
         )
+        is PanoramaColumns.Tiered -> {
+            // Harmony: the tier is this grid's width, so a freeform pane does not inherit the device screen.
