     return maxOf((availableSize + spacing) / (minSize + spacing), 1)
 }
 
+/**
+ * Column minimum for [PanoramaColumns.Tiered].
+ *
+ * [windowSize] is the grid's own width (lane area plus horizontal content padding), in the
+ * same unit as [breakpoint], [compactMin], and [expandedMin]. Narrower than [breakpoint]
+ * uses [compactMin]. [breakpoint] and wider uses [expandedMin].
+ */
+fun panoramaTieredMinSize(windowSize: Int, breakpoint: Int, compactMin: Int, expandedMin: Int): Int {
+    return if (windowSize < breakpoint) compactMin else expandedMin
+}
