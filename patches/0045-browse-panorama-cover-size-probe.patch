+
+// Harmony: the first page waits up to 400 ms for cover headers. Append and prepend return
+// immediately and learn shapes in the background (2 s, six at a time). Those rows are below
+// the viewport, so a learnt band moves the tail. Local sources are not HttpSource.
+private class BrowseCoverProbePagingSource(
+    private val delegate: PagingSource<Long, Manga>,
+    private val httpSource: () -> HttpSource?,
+    private val panorama: () -> Boolean,
+    parentScope: CoroutineScope,
+) : PagingSource<Long, Manga>() {
+
+    private val probeJob = SupervisorJob(parentScope.coroutineContext[Job])
+    private val probeScope = CoroutineScope(parentScope.coroutineContext + probeJob)
+
+    init {
+        // Paging 3's invalidate() is final. Cancel probes from the callback, and keep forwarding.
+        registerInvalidatedCallback { probeJob.cancel() }
+        delegate.registerInvalidatedCallback { invalidate() }
+    }
+
+    override suspend fun load(params: LoadParams<Long>): LoadResult<Long, Manga> {
+        // Before the delegate, so a slow page does not decide the mode after it has already arrived.
+        val probe = panorama()
+        val result = delegate.load(params)
+        if (result is LoadResult.Page && probe) {
+            val http = httpSource()
+            if (http != null) {
+                try {
+                    when (params) {
+                        is LoadParams.Refresh -> {
+                            HarmonyCoverHeaderProbe.probePage(result.data, http.client, http.headers)
+                        }
+                        is LoadParams.Append, is LoadParams.Prepend -> {
+                            val page = result.data
+                            probeScope.launch {
+                                try {
+                                    HarmonyCoverHeaderProbe.probePage(
+                                        items = page,
+                                        client = http.client,
+                                        headers = http.headers,
+                                        budget = 2.seconds,
+                                    )
+                                } catch (e: CancellationException) {
+                                    throw e
+                                } catch (_: Exception) {
+                                    // Appended rows keep the placeholder until a later probe lands.
+                                }
+                            }
+                        }
+                    }
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (_: Exception) {
+                    // The page is still shown. Covers that were not probed keep the placeholder shape.
+                }
+            }
+        }
+        return result
+    }
+
+    override fun getRefreshKey(state: PagingState<Long, Manga>): Long? {
+        return delegate.getRefreshKey(state)
+    }
+
+    override val jumpingSupported: Boolean
+        get() = delegate.jumpingSupported
+
+    override val keyReuseSupported: Boolean
+        get() = delegate.keyReuseSupported
+}
