+package eu.kanade.tachiyomi.util.system
+
+import com.sun.net.httpserver.HttpExchange
+import com.sun.net.httpserver.HttpServer
+import kotlinx.coroutines.runBlocking
+import okhttp3.Headers
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Assertions.assertNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import org.junit.jupiter.api.Test
+import java.net.InetSocketAddress
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.Executors
+import java.util.concurrent.atomic.AtomicInteger
+
+class HarmonyCoverHeaderProbeTest {
+
+    private val client = OkHttpClient.Builder()
+        .protocols(listOf(Protocol.HTTP_1_1))
+        .retryOnConnectionFailure(false)
+        .build()
+
+    private val headers = Headers.Builder()
+        .add("Referer", "https://example.test/browse")
+        .add("User-Agent", "cover-probe-test")
+        .build()
+
+    @Test
+    fun `png reads IHDR`() {
+        val png = png(width = 32, height = 48)
+        assertEquals(32 to 48, HarmonyCoverHeaderProbe.parseImageSize(png, png.size))
+        assertEquals(32 to 48, HarmonyCoverHeaderProbe.parseImageSize(png + byteArrayOf(1, 2), png.size))
+        assertNull(HarmonyCoverHeaderProbe.parseImageSize(png, 16))
+    }
+
+    @Test
+    fun `gif reads the logical screen`() {
+        val gif89 = gif(version = "GIF89a", width = 100, height = 40)
+        val gif87 = gif(version = "GIF87a", width = 7, height = 9)
+        assertEquals(100 to 40, HarmonyCoverHeaderProbe.parseImageSize(gif89, gif89.size))
+        assertEquals(7 to 9, HarmonyCoverHeaderProbe.parseImageSize(gif87, gif87.size))
+    }
+
+    @Test
+    fun `webp vp8 reads the keyframe size`() {
+        val image = vp8(width = 320, height = 180)
+        assertEquals(320 to 180, HarmonyCoverHeaderProbe.parseImageSize(image, image.size))
+    }
+
+    @Test
+    fun `webp vp8l reads the lossless size`() {
+        val image = vp8l(width = 100, height = 50)
+        assertEquals(100 to 50, HarmonyCoverHeaderProbe.parseImageSize(image, image.size))
+        val wide = vp8l(width = 200, height = 300)
+        assertEquals(200 to 300, HarmonyCoverHeaderProbe.parseImageSize(wide, wide.size))
+    }
+
+    @Test
+    fun `webp vp8x reads the canvas size`() {
+        val image = vp8x(width = 400, height = 300)
+        assertEquals(400 to 300, HarmonyCoverHeaderProbe.parseImageSize(image, image.size))
+    }
+
+    @Test
+    fun `bmp reads the dib size and a negative height`() {
+        val image = bmp(width = 64, height = 48)
+        assertEquals(64 to 48, HarmonyCoverHeaderProbe.parseImageSize(image, image.size))
+        val topDown = bmp(width = 64, height = -48)
+        assertEquals(64 to 48, HarmonyCoverHeaderProbe.parseImageSize(topDown, topDown.size))
+    }
+
+    @Test
+    fun `jpeg skips an APP1 exif segment that contains a thumbnail`() {
+        val image = jpegWithExifThumbnail(
+            thumbWidth = 10,
+            thumbHeight = 20,
+            width = 480,
+            height = 640,
+            padding = 12_000,
+        )
+        assertEquals(480 to 640, HarmonyCoverHeaderProbe.parseImageSize(image, image.size))
+        // The thumbnail SOF is inside the buffer, but the APP1 length is not finished.
+        val cut = image.copyOf(8_000)
+        assertNull(HarmonyCoverHeaderProbe.parseImageSize(cut, cut.size))
+    }
+
+    @Test
+    fun `jpeg truncated before SOF is null`() {
+        val partial = (soi() + segment(0xE0, ByteArray(200))).copyOf(40)
+        assertNull(HarmonyCoverHeaderProbe.parseImageSize(partial, partial.size))
+        assertNull(HarmonyCoverHeaderProbe.parseImageSize(soi(), soi().size))
+    }
+
+    @Test
+    fun `jpeg does not treat DHT JPG or DAC as SOF and skips fill bytes`() {
+        val fakeSof = byteArrayOf(
+            0x00,
+            0xFF.toByte(),
+            0xC0.toByte(),
+            0x00,
+            0x0B,
+            8,
+            0,
+            1,
+            0,
+            1,
+            1,
+            1,
+            0x11,
+            0,
+        )
+        val withDht = soi() + segment(0xC4, fakeSof) + sof(marker = 0xC0, width = 80, height = 90)
+        assertEquals(80 to 90, HarmonyCoverHeaderProbe.parseImageSize(withDht, withDht.size))
+        for (marker in intArrayOf(0xC4, 0xC8, 0xCC)) {
+            val only = soi() + sof(marker = marker, width = 64, height = 64)
+            assertNull(HarmonyCoverHeaderProbe.parseImageSize(only, only.size))
+        }
+        val progressive = soi() + byteArrayOf(0xFF.toByte()) + sof(marker = 0xC2, width = 30, height = 40)
+        assertEquals(30 to 40, HarmonyCoverHeaderProbe.parseImageSize(progressive, progressive.size))
+    }
+
+    @Test
+    fun `garbage and unknown containers are null`() {
+        assertNull(HarmonyCoverHeaderProbe.parseImageSize(byteArrayOf(0, 1, 2, 3, 4, 5), 6))
+        assertNull(HarmonyCoverHeaderProbe.parseImageSize("ftypavif".encodeToByteArray(), 8))
+        assertNull(HarmonyCoverHeaderProbe.parseImageSize("ftypjxl ".encodeToByteArray(), 8))
+        assertNull(HarmonyCoverHeaderProbe.parseImageSize(ByteArray(0), 0))
+        assertNull(HarmonyCoverHeaderProbe.parseImageSize(byteArrayOf(0xFF.toByte(), 0xD8.toByte(), 0x00), 3))
+    }
+
+    @Test
+    fun `a 200 that ignores Range is not drained`() = runBlocking {
+        val png = png(width = 18, height = 27)
+        val payload = png + ByteArray(256 * 1024)
+        val written = AtomicInteger()
+        val ranges = CopyOnWriteArrayList<String?>()
+        val referers = CopyOnWriteArrayList<String?>()
+        val encodings = CopyOnWriteArrayList<String?>()
+        val server = server { exchange ->
+            try {
+                ranges += exchange.requestHeaders.getFirst("Range")
+                referers += exchange.requestHeaders.getFirst("Referer")
+                encodings += exchange.requestHeaders.getFirst("Accept-Encoding")
+                exchange.sendResponseHeaders(200, payload.size.toLong())
+                val out = exchange.responseBody
+                var offset = 0
+                var paused = false
+                while (offset < payload.size) {
+                    val count = minOf(8 * 1024, payload.size - offset)
+                    out.write(payload, offset, count)
+                    out.flush()
+                    written.addAndGet(count)
+                    offset += count
+                    // Past the header window, wait so an aborted client closes before the rest is sent.
+                    if (!paused && offset >= 64 * 1024) {
+                        paused = true
+                        Thread.sleep(300)
+                    }
+                }
+            } catch (_: Exception) {
+                // The client closed after the header window.
+            }
+        }
+        try {
+            val size = HarmonyCoverHeaderProbe.probe(client, url(server), headers)
+            assertEquals(18 to 27, size)
+            assertEquals(listOf("bytes=0-32767"), ranges)
+            assertEquals(listOf("https://example.test/browse"), referers)
+            assertEquals(listOf("identity"), encodings)
+            val sent = written.get()
+            assertTrue(sent > 0) { "sent=$sent" }
+            assertTrue(sent < payload.size / 2) { "sent=$sent payload=${payload.size}" }
+        } finally {
+            server.stop(0)
+        }
+    }
+
+    @Test
+    fun `jpeg whose SOF is past 32 KB does one follow-up range`() = runBlocking {
+        val image = jpegWithExifThumbnail(
+            thumbWidth = 8,
+            thumbHeight = 8,
+            width = 300,
+            height = 400,
+            padding = 40_000,
+        )
+        val ranges = CopyOnWriteArrayList<String?>()
+        val server = server { exchange ->
+            val range = exchange.requestHeaders.getFirst("Range")
+            ranges += range
+            val spec = range!!.removePrefix("bytes=")
+            val start = spec.substringBefore('-').toInt()
+            val end = spec.substringAfter('-').toInt().coerceAtMost(image.size - 1)
+            val count = end - start + 1
+            exchange.responseHeaders.add("Content-Range", "bytes $start-$end/${image.size}")
+            exchange.sendResponseHeaders(206, count.toLong())
+            exchange.responseBody.write(image, start, count)
+        }
+        try {
+            val size = HarmonyCoverHeaderProbe.probe(client, url(server), headers)
+            assertEquals(300 to 400, size)
+            assertEquals(listOf("bytes=0-32767", "bytes=0-131071"), ranges)
+        } finally {
+            server.stop(0)
+        }
+    }
+
+    private fun url(server: HttpServer) = "http://127.0.0.1:${server.address.port}/cover"
+
+    private fun server(handler: (HttpExchange) -> Unit): HttpServer {
+        val http = HttpServer.create(InetSocketAddress("127.0.0.1", 0), 0)
+        http.createContext("/cover") { exchange ->
+            try {
+                handler(exchange)
+            } finally {
+                exchange.close()
+            }
+        }
+        http.executor = Executors.newCachedThreadPool { runnable ->
+            Thread(runnable, "cover-probe-test").apply { isDaemon = true }
+        }
+        http.start()
+        return http
+    }
+
+    private fun png(width: Int, height: Int): ByteArray {
+        val data = ByteArray(13)
+        putBe32(data, 0, width)
+        putBe32(data, 4, height)
+        return byteArrayOf(0x89.toByte(), 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A) +
+            byteArrayOf(0, 0, 0, 13) +
+            "IHDR".encodeToByteArray() +
+            data +
+            byteArrayOf(0, 0, 0, 0)
+    }
+
+    private fun gif(version: String, width: Int, height: Int): ByteArray {
+        return version.encodeToByteArray() + le16(width) + le16(height) + byteArrayOf(0)
+    }
+
+    private fun webp(fourCc: String, payload: ByteArray): ByteArray {
+        val riffSize = 4 + 8 + payload.size
+        return "RIFF".encodeToByteArray() +
+            le32(riffSize) +
+            "WEBP".encodeToByteArray() +
+            fourCc.encodeToByteArray() +
+            le32(payload.size) +
+            payload
+    }
+
+    private fun vp8(width: Int, height: Int): ByteArray {
+        val payload = ByteArray(10)
+        payload[3] = 0x9D.toByte()
+        payload[4] = 0x01
+        payload[5] = 0x2A
+        payload[6] = width.toByte()
+        payload[7] = (width ushr 8).toByte()
+        payload[8] = height.toByte()
+        payload[9] = (height ushr 8).toByte()
+        return webp("VP8 ", payload)
+    }
+
+    private fun vp8l(width: Int, height: Int): ByteArray {
+        val bits = (width - 1) or ((height - 1) shl 14)
+        return webp(
+            "VP8L",
+            byteArrayOf(
+                0x2F,
+                bits.toByte(),
+                (bits ushr 8).toByte(),
+                (bits ushr 16).toByte(),
+                (bits ushr 24).toByte(),
+            ),
+        )
+    }
+
+    private fun vp8x(width: Int, height: Int): ByteArray {
+        val canvasWidth = width - 1
+        val canvasHeight = height - 1
+        val payload = ByteArray(10)
+        payload[4] = canvasWidth.toByte()
+        payload[5] = (canvasWidth ushr 8).toByte()
+        payload[6] = (canvasWidth ushr 16).toByte()
+        payload[7] = canvasHeight.toByte()
+        payload[8] = (canvasHeight ushr 8).toByte()
+        payload[9] = (canvasHeight ushr 16).toByte()
+        return webp("VP8X", payload)
+    }
+
+    private fun bmp(width: Int, height: Int): ByteArray {
+        val bytes = ByteArray(26)
+        bytes[0] = 'B'.code.toByte()
+        bytes[1] = 'M'.code.toByte()
+        bytes[14] = 40
+        putLe32(bytes, 18, width)
+        putLe32(bytes, 22, height)
+        return bytes
+    }
+
+    private fun jpegWithExifThumbnail(
+        thumbWidth: Int,
+        thumbHeight: Int,
+        width: Int,
+        height: Int,
+        padding: Int,
+    ): ByteArray {
+        val thumbnail = soi() + sof(marker = 0xC0, width = thumbWidth, height = thumbHeight)
+        val payload = "Exif\u0000\u0000".encodeToByteArray() + thumbnail + ByteArray(padding)
+        return soi() + segment(marker = 0xE1, payload) + sof(marker = 0xC0, width = width, height = height)
+    }
+
+    private fun soi(): ByteArray = byteArrayOf(0xFF.toByte(), 0xD8.toByte())
+
+    private fun sof(marker: Int, width: Int, height: Int): ByteArray {
+        return segment(
+            marker = marker,
+            payload = byteArrayOf(
+                8,
+                (height ushr 8).toByte(),
+                (height and 0xFF).toByte(),
+                (width ushr 8).toByte(),
+                (width and 0xFF).toByte(),
+                1,
+                1,
+                0x11,
+                0,
+            ),
+        )
+    }
+
+    private fun segment(marker: Int, payload: ByteArray): ByteArray {
+        val length = payload.size + 2
+        require(length <= 0xFFFF)
+        return byteArrayOf(
+            0xFF.toByte(),
+            marker.toByte(),
+            (length ushr 8).toByte(),
+            (length and 0xFF).toByte(),
+        ) + payload
+    }
+
+    private fun le16(value: Int): ByteArray {
+        return byteArrayOf(value.toByte(), (value ushr 8).toByte())
+    }
+
+    private fun le32(value: Int): ByteArray {
+        return byteArrayOf(
+            value.toByte(),
+            (value ushr 8).toByte(),
+            (value ushr 16).toByte(),
+            (value ushr 24).toByte(),
+        )
+    }
+
+    private fun putBe32(bytes: ByteArray, offset: Int, value: Int) {
+        bytes[offset] = (value ushr 24).toByte()
+        bytes[offset + 1] = (value ushr 16).toByte()
+        bytes[offset + 2] = (value ushr 8).toByte()
+        bytes[offset + 3] = value.toByte()
+    }
+
+    private fun putLe32(bytes: ByteArray, offset: Int, value: Int) {
+        bytes[offset] = value.toByte()
+        bytes[offset + 1] = (value ushr 8).toByte()
+        bytes[offset + 2] = (value ushr 16).toByte()
+        bytes[offset + 3] = (value ushr 24).toByte()
+    }
+}
