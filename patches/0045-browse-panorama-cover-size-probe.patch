+package eu.kanade.tachiyomi.util.system
+
+import eu.kanade.presentation.library.components.PanoramaCoverShapes
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+import okhttp3.CacheControl
+import okhttp3.Call
+import okhttp3.Callback
+import okhttp3.Headers
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.Response
+import okhttp3.ResponseBody
+import tachiyomi.domain.manga.model.Manga
+import java.io.IOException
+import kotlin.coroutines.resume
+import kotlin.coroutines.resumeWithException
+import kotlin.time.Duration.Companion.milliseconds
+
+/**
+ * Reads cover width and height from a short HTTP prefix so a panorama cell can be
+ * placed at its final ratio. Unknown covers stay on the placeholder.
+ *
+ * JPEG is walked by segment length, so an EXIF thumbnail inside APP1 is skipped.
+ * EXIF orientation 5–8 is not applied: the tag lives in that same APP1 segment,
+ * and a swapped ratio only lasts until a visible decode stores the oriented size.
+ * AVIF, JXL and HEIF return null.
+ */
+object HarmonyCoverHeaderProbe {
+
+    private const val HTTP_OK = 200
+    private const val HTTP_PARTIAL = 206
+    private const val FIRST_BYTES = 32 * 1024
+    private const val MAX_BYTES = 128 * 1024
+    private const val PROBE_CONCURRENCY = 6
+
+    private val callTimeout = 400.milliseconds
+    private val pageBudget = 400.milliseconds
+    private val noStore = CacheControl.Builder().noStore().build()
+
+    /**
+     * Width then height, from the first [length] bytes of [bytes].
+     * Returns null when the format is unknown or the header is not in the buffer.
+     */
+    fun parseImageSize(bytes: ByteArray, length: Int): Pair<Int, Int>? {
+        val size = parseHeader(bytes, length) as? ImageSize ?: return null
+        return size.width to size.height
+    }
+
+    /**
+     * GET [url] with `Range: bytes=0-32767`, using [headers] unchanged apart from
+     * Range and `Accept-Encoding: identity` (source headers carry Referer).
+     * At most 32 KB is read; a 200 that ignored Range is closed without draining.
+     * When the JPEG segment lengths put SOF past that window, one follow-up
+     * reads `bytes=0-131071`. The call is cancelled with the coroutine.
+     * Nothing is written to Coil, and [client]'s cache is not used.
+     */
+    suspend fun probe(client: OkHttpClient, url: String, headers: Headers): Pair<Int, Int>? {
+        val timed = client.newBuilder()
+            .cache(null)
+            .callTimeout(callTimeout)
+            .build()
+        return withContext(Dispatchers.IO) {
+            try {
+                readSize(timed, url, headers)
+            } catch (e: CancellationException) {
+                throw e
+            } catch (_: Exception) {
+                ensureActive()
+                null
+            }
+        }
+    }
+
+    /**
+     * Probes covers that are not already in [PanoramaCoverShapes], [PROBE_CONCURRENCY]
+     * at a time, and gives the whole page [pageBudget]. Each ratio is stored as it
+     * arrives (height / width). Unfinished calls are cancelled and those covers stay unknown.
+     */
+    suspend fun probePage(
+        items: List<Manga>,
+        client: OkHttpClient,
+        headers: Headers,
+        budget: kotlin.time.Duration = pageBudget,
+    ) {
+        if (items.isEmpty()) return
+        val pending = ArrayList<Manga>(items.size)
+        for (manga in items) {
+            val url = manga.thumbnailUrl
+            if (url.isNullOrBlank() || !url.startsWith("http", ignoreCase = true)) continue
+            if (PanoramaCoverShapes.get(manga.id) != null) continue
+            pending.add(manga)
+        }
+        if (pending.isEmpty()) return
+        withTimeoutOrNull(budget) {
+            coroutineScope {
+                val gate = Semaphore(PROBE_CONCURRENCY)
+                for (manga in pending) {
+                    val url = manga.thumbnailUrl ?: continue
+                    val mangaId = manga.id
+                    launch {
+                        gate.withPermit {
+                            try {
+                                if (PanoramaCoverShapes.get(mangaId) != null) return@withPermit
+                                val size = probe(client, url, headers) ?: return@withPermit
+                                val (width, height) = size
+                                if (width <= 0 || height <= 0) return@withPermit
+                                PanoramaCoverShapes.put(mangaId, height.toFloat() / width.toFloat())
+                            } catch (e: CancellationException) {
+                                throw e
+                            } catch (_: Exception) {
+                                // This cover stays unknown.
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    private suspend fun readSize(client: OkHttpClient, url: String, headers: Headers): Pair<Int, Int>? {
+        val first = fetch(client, url, headers, start = 0, endInclusive = FIRST_BYTES - 1L) ?: return null
+        if (first.offset != 0L) return null
+        when (val parsed = parseHeader(first.bytes, first.bytes.size)) {
+            is ImageSize -> return parsed.width to parsed.height
+            HeaderParse.NotImage -> return null
+            HeaderParse.JpegNeedsMore -> if (!first.hitCap) return null
+        }
+        // SOF is past the first window. One more range, still capped at 128 KB.
+        val more = fetch(client, url, headers, start = 0, endInclusive = MAX_BYTES - 1L) ?: return null
+        if (more.offset != 0L) return null
+        return parseImageSize(more.bytes, more.bytes.size)
+    }
+
+    private suspend fun fetch(
+        client: OkHttpClient,
+        url: String,
+        headers: Headers,
+        start: Long,
+        endInclusive: Long,
+    ): Slice? {
+        val request = Request.Builder()
+            .url(url)
+            .headers(headers)
+            .header("Range", "bytes=$start-$endInclusive")
+            .header("Accept-Encoding", "identity")
+            .cacheControl(noStore)
+            .build()
+        val call = client.newCall(request)
+        // invokeOnCompletion runs only after the job finishes, so a blocked execute() never saw it.
+        // onCancelling fires when the coroutine is cancelled, including during the body read.
+        val cancelOnExit = currentCoroutineContext()[Job]?.invokeOnCompletion(onCancelling = true) { cause ->
+            if (cause is CancellationException) {
+                try {
+                    call.cancel()
+                } catch (_: Throwable) {
+                }
+            }
+        }
+        try {
+            currentCoroutineContext().ensureActive()
+            // Registered before the call runs. Cancellation cancels it instead of waiting out execute.
+            val response = call.awaitResponse()
+            try {
+                if (response.code != HTTP_OK && response.code != HTTP_PARTIAL) return null
+                val requested = (endInclusive - start + 1).coerceAtMost(MAX_BYTES.toLong()).toInt()
+                // A 200 ignored Range. Stop at the window. Cancel so close() does not discard the rest.
+                val cap = if (response.code == HTTP_OK) minOf(requested, MAX_BYTES) else requested
+                val bytes = readAtMost(response.body, cap)
+                val hitCap = bytes.size >= cap
+                if (response.code == HTTP_OK && hitCap) {
+                    // close() otherwise discards the unread body for 100 ms. Cancel first so that
+                    // read fails instead of pulling down a 200 that ignored Range.
+                    call.cancel()
+                }
+                val offset = if (response.code == HTTP_PARTIAL) {
+                    contentRangeStart(response.header("Content-Range")) ?: start
+                } else {
+                    0L
+                }
+                return Slice(bytes = bytes, offset = offset, hitCap = hitCap)
+            } finally {
+                try {
+                    response.close()
+                } catch (e: CancellationException) {
+                    throw e
+                } catch (_: Exception) {
+                    currentCoroutineContext().ensureActive()
+                }
+            }
+        } finally {
+            cancelOnExit?.dispose()
+        }
+    }
+
+    /**
+     * Headers for [this], cancelled with the coroutine.
+     * The continuation is suspended before the response arrives, so [invokeOnCancellation] can
+     * [Call.cancel] a call that would otherwise stay blocked inside execute.
+     */
+    private suspend fun Call.awaitResponse(): Response = suspendCancellableCoroutine { continuation ->
+        continuation.invokeOnCancellation {
+            try {
+                cancel()
+            } catch (_: Throwable) {
+            }
+        }
+        enqueue(object : Callback {
+            override fun onFailure(call: Call, e: IOException) {
+                if (continuation.isCancelled) return
+                continuation.resumeWithException(e)
+            }
+
+            override fun onResponse(call: Call, response: Response) {
+                continuation.resume(response) { _, value, _ ->
+                    try {
+                        value.close()
+                    } catch (_: Throwable) {
+                    }
+                }
+            }
+        })
+    }
+
+    private suspend fun readAtMost(body: ResponseBody, max: Int): ByteArray {
+        if (max <= 0) return ByteArray(0)
+        val source = body.source()
+        val out = ByteArray(max)
+        var offset = 0
+        while (offset < max) {
+            currentCoroutineContext().ensureActive()
+            val count = source.read(out, offset, max - offset)
+            if (count < 0) break
+            offset += count
+        }
+        return if (offset == max) out else out.copyOf(offset)
+    }
+
+    private fun parseHeader(bytes: ByteArray, length: Int): HeaderParse {
+        val n = if (length < 0) 0 else minOf(length, bytes.size)
+        if (n <= 0) return HeaderParse.NotImage
+        parsePng(bytes, n)?.let { return it }
+        parseGif(bytes, n)?.let { return it }
+        parseWebp(bytes, n)?.let { return it }
+        parseBmp(bytes, n)?.let { return it }
+        if (n >= 2 && u8(bytes, 0) == 0xFF && u8(bytes, 1) == 0xD8) return parseJpeg(bytes, n)
+        return HeaderParse.NotImage
+    }
+
+    private fun parsePng(bytes: ByteArray, n: Int): ImageSize? {
+        if (n < 24) return null
+        if (u8(bytes, 0) != 0x89 || u8(bytes, 1) != 0x50 || u8(bytes, 2) != 0x4E || u8(bytes, 3) != 0x47) {
+            return null
+        }
+        if (u8(bytes, 4) != 0x0D || u8(bytes, 5) != 0x0A || u8(bytes, 6) != 0x1A || u8(bytes, 7) != 0x0A) {
+            return null
+        }
+        if (!ascii(bytes, n, 12, "IHDR")) return null
+        return imageSize(u32be(bytes, 16), u32be(bytes, 20))
+    }
+
+    private fun parseGif(bytes: ByteArray, n: Int): ImageSize? {
+        if (n < 10) return null
+        if (!ascii(bytes, n, 0, "GIF87a") && !ascii(bytes, n, 0, "GIF89a")) return null
+        return imageSize(u16le(bytes, 6), u16le(bytes, 8))
+    }
+
+    private fun parseWebp(bytes: ByteArray, n: Int): ImageSize? {
+        if (n < 12 || !ascii(bytes, n, 0, "RIFF") || !ascii(bytes, n, 8, "WEBP")) return null
+        var pos = 12
+        while (pos + 8 <= n) {
+            val kind = fourCc(bytes, pos)
+            val chunkSize = u32le(bytes, pos + 4)
+            val data = pos + 8
+            if (chunkSize > Int.MAX_VALUE) return null
+            when (kind) {
+                "VP8 " -> return parseVp8(bytes, n, data)
+                "VP8L" -> return parseVp8L(bytes, n, data)
+                "VP8X" -> return parseVp8X(bytes, n, data)
+            }
+            val padded = chunkSize + (chunkSize and 1L)
+            val next = data.toLong() + padded
+            if (next > n || next <= pos) return null
+            pos = next.toInt()
+        }
+        return null
+    }
+
+    private fun parseVp8(bytes: ByteArray, n: Int, data: Int): ImageSize? {
+        if (data < 0 || data + 10 > n) return null
+        // Inter frames carry no size. Key frames start 9D 01 2A, then 14-bit width and height.
+        if (u8(bytes, data) and 0x01 != 0) return null
+        if (u8(bytes, data + 3) != 0x9D || u8(bytes, data + 4) != 0x01 || u8(bytes, data + 5) != 0x2A) {
+            return null
+        }
+        val width = u16le(bytes, data + 6) and 0x3FFF
+        val height = u16le(bytes, data + 8) and 0x3FFF
+        return imageSize(width, height)
+    }
+
+    private fun parseVp8L(bytes: ByteArray, n: Int, data: Int): ImageSize? {
+        if (data < 0 || data + 5 > n) return null
+        if (u8(bytes, data) != 0x2F) return null
+        val bits = u32le(bytes, data + 1)
+        val width = (bits and 0x3FFF) + 1
+        val height = ((bits shr 14) and 0x3FFF) + 1
+        return imageSize(width, height)
+    }
+
+    private fun parseVp8X(bytes: ByteArray, n: Int, data: Int): ImageSize? {
+        if (data < 0 || data + 10 > n) return null
+        val width = u24le(bytes, data + 4) + 1
+        val height = u24le(bytes, data + 7) + 1
+        return imageSize(width, height)
+    }
+
+    private fun parseBmp(bytes: ByteArray, n: Int): ImageSize? {
+        if (n < 26 || u8(bytes, 0) != 'B'.code || u8(bytes, 1) != 'M'.code) return null
+        val headerSize = u32le(bytes, 14)
+        if (headerSize == 12L) {
+            if (n < 22) return null
+            return imageSize(u16le(bytes, 18), u16le(bytes, 20))
+        }
+        val width = i32le(bytes, 18)
+        val height = i32le(bytes, 22)
+        if (width <= 0 || height == 0 || height == Int.MIN_VALUE) return null
+        return imageSize(width, if (height < 0) -height else height)
+    }
+
+    private fun parseJpeg(bytes: ByteArray, n: Int): HeaderParse {
+        var i = 2
+        while (i < n) {
+            if (u8(bytes, i) != 0xFF) return HeaderParse.NotImage
+            while (i < n && u8(bytes, i) == 0xFF) i++
+            if (i >= n) return HeaderParse.JpegNeedsMore
+            val marker = u8(bytes, i)
+            i++
+            // Standalone markers have no length. RST and fill bytes show up in front of SOF.
+            when (marker) {
+                0x00 -> return HeaderParse.NotImage
+                0xD9 -> return HeaderParse.NotImage
+                0x01 -> continue
+                0xD8 -> continue
+                in 0xD0..0xD7 -> continue
+                // SOS payload is entropy-coded and is not bounded by its length field.
+                0xDA -> return HeaderParse.NotImage
+            }
+            if (i + 2 > n) return HeaderParse.JpegNeedsMore
+            val segLen = u16be(bytes, i)
+            if (segLen < 2) return HeaderParse.NotImage
+            val next = i.toLong() + segLen
+            if (isSof(marker)) {
+                // Precision, height, width need 5 bytes after the length field (segLen >= 7).
+                if (segLen < 7) return HeaderParse.NotImage
+                if (i + 7 > n) return HeaderParse.JpegNeedsMore
+                val height = u16be(bytes, i + 3)
+                val width = u16be(bytes, i + 5)
+                return imageSize(width, height) ?: HeaderParse.NotImage
+            }
+            if (next > n) return HeaderParse.JpegNeedsMore
+            i = next.toInt()
+        }
+        return HeaderParse.JpegNeedsMore
+    }
+
+    private fun isSof(marker: Int): Boolean {
+        // SOF0–SOF15 except DHT (C4), JPG (C8) and DAC (CC).
+        return marker in 0xC0..0xCF && marker != 0xC4 && marker != 0xC8 && marker != 0xCC
+    }
+
+    private fun contentRangeStart(header: String?): Long? {
+        if (header.isNullOrBlank()) return null
+        val spec = header.trim()
+        val rest = when {
+            spec.startsWith("bytes ") -> spec.substring(6)
+            spec.startsWith("bytes=") -> spec.substring(6)
+            else -> return null
+        }
+        val start = rest.substringBefore('-').trim()
+        if (start.isEmpty() || start == "*") return null
+        return start.toLongOrNull()
+    }
+
+    private fun imageSize(width: Long, height: Long): ImageSize? {
+        if (width <= 0L || height <= 0L || width > Int.MAX_VALUE || height > Int.MAX_VALUE) return null
+        return ImageSize(width.toInt(), height.toInt())
+    }
+
+    private fun imageSize(width: Int, height: Int): ImageSize? {
+        if (width <= 0 || height <= 0) return null
+        return ImageSize(width, height)
+    }
+
+    private fun ascii(bytes: ByteArray, n: Int, offset: Int, text: String): Boolean {
+        if (offset < 0 || text.length > n - offset) return false
+        for (index in text.indices) {
+            if (bytes[offset + index].toInt() != text[index].code) return false
+        }
+        return true
+    }
+
+    private fun fourCc(bytes: ByteArray, offset: Int): String {
+        return charArrayOf(
+            bytes[offset].toInt().toChar(),
+            bytes[offset + 1].toInt().toChar(),
+            bytes[offset + 2].toInt().toChar(),
+            bytes[offset + 3].toInt().toChar(),
+        ).concatToString()
+    }
+
+    private fun u8(bytes: ByteArray, index: Int): Int = bytes[index].toInt() and 0xFF
+
+    private fun u16be(bytes: ByteArray, index: Int): Int {
+        return (u8(bytes, index) shl 8) or u8(bytes, index + 1)
+    }
+
+    private fun u16le(bytes: ByteArray, index: Int): Int {
+        return u8(bytes, index) or (u8(bytes, index + 1) shl 8)
+    }
+
+    private fun u24le(bytes: ByteArray, index: Int): Int {
+        return u8(bytes, index) or (u8(bytes, index + 1) shl 8) or (u8(bytes, index + 2) shl 16)
+    }
+
+    private fun u32be(bytes: ByteArray, index: Int): Long {
+        return (u8(bytes, index).toLong() shl 24) or
+            (u8(bytes, index + 1).toLong() shl 16) or
+            (u8(bytes, index + 2).toLong() shl 8) or
+            u8(bytes, index + 3).toLong()
+    }
+
+    private fun u32le(bytes: ByteArray, index: Int): Long {
+        return u8(bytes, index).toLong() or
+            (u8(bytes, index + 1).toLong() shl 8) or
+            (u8(bytes, index + 2).toLong() shl 16) or
+            (u8(bytes, index + 3).toLong() shl 24)
+    }
+
+    private fun i32le(bytes: ByteArray, index: Int): Int = u32le(bytes, index).toInt()
+
+    private class Slice(
+        val bytes: ByteArray,
+        val offset: Long,
+        val hitCap: Boolean,
+    )
+
+    private class ImageSize(
+        val width: Int,
+        val height: Int,
+    ) : HeaderParse
+
+    private sealed interface HeaderParse {
+        data object NotImage : HeaderParse
+        data object JpegNeedsMore : HeaderParse
+    }
+}
