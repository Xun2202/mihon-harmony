+    private fun showReadingModeNotice(resource: StringResource) {
+        if (readerPaused || isFinishing || isDestroyed) return
+        // Keep this entry-time hint in the reader window. A system Toast creates a separate
+        // platform window while the reader is switching orientation and immersive mode.
+        clearReadingModeNotice()
+        readingModeNotice = stringResource(resource)
+        readingModeNoticeJob = lifecycleScope.launch {
+            delay(2_000)
+            readingModeNotice = null
         }
     }
 
+    private fun clearReadingModeNotice() {
+        readingModeNoticeJob?.cancel()
+        readingModeNoticeJob = null
+        readingModeNotice = null
+    }
