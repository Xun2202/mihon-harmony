+    private fun runtimeStat(name: String): Long? {
+        return try {
+            Debug.getRuntimeStat(name)?.toLongOrNull()
+        } catch (_: Throwable) {
+            null
+        }
+    }
+
+    private fun statDelta(current: Long?, previous: Long, store: (Long) -> Unit): Long {
+        if (current == null) return PerfReport.UNAVAILABLE
+        val delta = if (previous >= 0) current - previous else 0L
+        store(current)
+        return delta
+    }
+
+    private fun readThreadCpuOrNa(): LongArray {
+        if (threadCpuBroken) return LongArray(PerfReport.CPU_BUCKETS) { PerfReport.UNAVAILABLE }
+        return try {
+            readThreadCpuMs()
+        } catch (_: Throwable) {
+            threadCpuBroken = true
+            LongArray(PerfReport.CPU_BUCKETS) { PerfReport.UNAVAILABLE }
+        }
+    }
+
+    private fun readThreadCpuMs(): LongArray {
+        val pid = Process.myPid()
+        val dir = java.io.File("/proc/self/task")
+        val names = dir.list() ?: error("no proc")
+        val hz = clockTicksPerSec()
+        val seen = HashSet<Int>(names.size)
+        val ticks = LongArray(PerfReport.CPU_BUCKETS)
+        for (name in names) {
+            val tid = name.toIntOrNull() ?: continue
+            try {
+                val comm = java.io.File(dir, "$name/comm").readText().trim()
+                val stat = java.io.File(dir, "$name/stat").readText()
+                val cpu = PerfReport.parseStatCpuTicks(stat) ?: continue
+                seen.add(tid)
+                val previous = threadCpuTicks.put(tid, cpu)
+                if (previous == null) continue
+                val delta = (cpu - previous).coerceAtLeast(0L)
+                val bucket = PerfReport.threadCategory(comm, tid == pid)
+                ticks[bucket] += delta
+            } catch (_: Throwable) {
+                // The thread exited between readdir and the read.
+            }
+        }
+        threadCpuTicks.keys.retainAll(seen)
+        return LongArray(PerfReport.CPU_BUCKETS) { ticks[it] * 1000L / hz }
+    }
+
+    private fun clockTicksPerSec(): Long {
+        if (clkTck > 0L) return clkTck
+        val hz = runCatching { Os.sysconf(OsConstants._SC_CLK_TCK) }.getOrDefault(0L)
+        clkTck = if (hz > 0L) hz else 100L
+        return clkTck
+    }
+
+    private fun drainCoil(): IntArray {
+        return intArrayOf(
