+package eu.kanade.tachiyomi.util.system
+
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+
+/**
+ * A/B switches for grid cover loading, flipped from the scroll performance recorder so one
+ * recording can compare arms. They live in memory only: every process start is back on the
+ * defaults, and nothing reads them unless the recorder changed them.
+ */
+object HarmonyPerfToggles {
+
+    enum class Prefetch { BOUNDS, DECODE, OFF }
+
+    /** Coil crossfade on grid covers. Off skips the 300 ms fade for network and disk hits. */
+    var coverCrossfade by mutableStateOf(true)
+
+    /** Hardware bitmaps for grid covers. Off decodes to software bitmaps uploaded on first draw. */
+    var coverHardware by mutableStateOf(true)
+
+    /**
+     * How the browse panorama grid learns cover shapes ahead of the viewport.
+     * BOUNDS reads the image header from the disk cache, DECODE is the old 128 px Coil decode
+     * of every loaded row, OFF learns only from covers that were drawn.
+     */
+    var prefetch by mutableStateOf(Prefetch.BOUNDS)
+
+    fun describe(): String =
+        "crossfade=${if (coverCrossfade) "on" else "off"} " +
+            "hardware=${if (coverHardware) "on" else "off"} " +
+            "prefetch=${prefetch.name.lowercase()}"
+}
