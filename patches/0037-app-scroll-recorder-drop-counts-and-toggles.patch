+    ) {
+        val endSec = input.nowWallMs / 1000L
+        val startSec = maxOf(input.startedWallMs / 1000L, endSec - RECENT_SECONDS)
+        val bySecond = HashMap<Long, SecAcc>()
+        fun acc(second: Long): SecAcc? {
+            if (second < startSec || second > endSec) return null
+            return bySecond.getOrPut(second) { SecAcc() }
+        }
+        for (row in 0 until ticks.rows) {
+            val bucket = acc(clock.epochSecond(ticks[row, T_TIME])) ?: continue
+            bucket.ticks++
+            val phase = ticks[row, T_PHASE].toInt()
+            if (phase in 0..2) bucket.phases[phase]++
+        }
+        var previousIntended = -1L
+        for (row in 0 until frames.rows) {
+            val intended = frames[row, F_INTENDED_VSYNC]
+            val missed = if (previousIntended >= 0L) {
+                missedVsyncs(previousIntended, intended, frames[row, F_DROP], framePeriod[row])
+            } else {
+                0L
+            }
+            previousIntended = intended
+            val bucket = acc(clock.epochSecond(frames[row, F_VSYNC])) ?: continue
+            bucket.rows += row
+            bucket.drops += frames[row, F_DROP].coerceAtLeast(0L)
+            bucket.missed += missed
+        }
+        out.appendLine("## Last 30 s: one line per second")
+        out.appendLine(
+            "# phase = most Choreographer ticks (fling over drag over idle on a tie); " +
+                "missed is charged to the later frame's second",
+        )
+        var second = startSec
+        while (second <= endSec) {
+            out.appendLine(secondLine(second, bySecond[second], frames, clock))
+            second++
+        }
+        out.appendLine()
+    }
+
+    private fun secondLine(second: Long, bucket: SecAcc?, frames: PerfTable, clock: Clock): String {
+        val rows = bucket?.rows
+        val swap = if (rows == null) -1L else percentile(sortedColumn(frames, rows, F_SWAP), 90.0)
+        val sync = if (rows == null) -1L else percentile(sortedColumn(frames, rows, F_SYNC), 90.0)
+        val gpu = if (rows == null) -1L else percentile(sortedColumn(frames, rows, F_GPU), 90.0)
+        return "sec ${clock.second(second)} ticks=${bucket?.ticks ?: 0} frames=${rows?.size ?: 0} " +
+            "drops=${bucket?.drops ?: 0L} missed=${bucket?.missed ?: 0L} phase=${dominantPhase(bucket?.phases)} " +
+            "swap_p90=${ms(swap)} sync_p90=${ms(sync)} gpu_p90=${ms(gpu)}"
+    }
+
+    /** Higher phase wins a tie, so a second that is half fling is not labelled idle. */
+    private fun dominantPhase(phases: IntArray?): String {
+        if (phases == null || phases.sum() == 0) return phaseName(PanoramaScrollTrace.PHASE_IDLE)
+        var best = 0
+        for (phase in 1..2) {
+            if (phases[phase] >= phases[best]) best = phase
+        }
+        return phaseName(best)
+    }
+
+    private fun appendSample(out: StringBuilder, clock: Clock, samples: PerfTable, row: Int) {
+        out.append("sample ").append(clock.time(samples[row, S_TIME]))
+        out.append(" gc=").append(samples[row, S_GC])
+        out.append(" cpu_ms=").append(samples[row, S_CPU_MS])
+        out.append(" refresh=").append(rateMilli(samples[row, S_REFRESH_MILLI]))
+        out.append(" mode=").append(samples[row, S_MODE_ID])
+        out.append('@').append(rateMilli(samples[row, S_MODE_REFRESH_MILLI]))
+        out.append(" thermal=").append(samples[row, S_THERMAL])
+        out.append(" power_save=").append(samples[row, S_POWER_SAVE] == 1L)
+        out.append(" heap_mb=").append(mbFromKb(samples[row, S_HEAP_KB]))
+        out.append(" native_mb=").append(mbFromKb(samples[row, S_NATIVE_KB]))
+        out.append(" gc_time_ms=").append(plain(samples[row, S_GC_TIME_MS]))
+        out.append(" blocking_gc=").append(plain(samples[row, S_BLOCKING_GC]))
+        // cpu_pool is the whole Default dispatcher pool, not Coil alone.
+        // cpu_ok is the OkHttp pool. The export must not contain the letters "http".
+        val cpuKeys = arrayOf(
+            "cpu_main",
+            "cpu_rt",
+            "cpu_hwui",
+            "cpu_pool",
+            "cpu_ok",
+            "cpu_perf",
+            "cpu_other",
+        )
+        for (index in cpuKeys.indices) {
+            out.append(' ').append(cpuKeys[index]).append('=').append(plain(samples[row, S_CPU_MAIN + index]))
+        }
+        out.append(" sample_ms=").append(sampleMs(samples[row, S_SAMPLE_US]))
+        out.append(" coil_mem_cache=").append(samples[row, S_COIL_MEM_CACHE])
+        out.append(" coil_memory=").append(samples[row, S_COIL_MEMORY])
+        out.append(" coil_disk=").append(samples[row, S_COIL_DISK])
+        out.append(" coil_network=").append(samples[row, S_COIL_NETWORK])
+        out.append(" coil_hw=").append(samples[row, S_COIL_HW])
+        out.append(" coil_err=").append(samples[row, S_COIL_ERR])
+        out.append(" coil_start=").append(samples[row, S_COIL_START])
+        out.appendLine()
+    }
+
+    private fun plain(value: Long): String = if (value == UNAVAILABLE) "n/a" else value.toString()
+
+    private fun mbFromKb(kb: Long): String {
+        if (kb == UNAVAILABLE) return "n/a"
+        return String.format(Locale.US, "%.1f", kb / 1024.0)
+    }
+
+    private fun sampleMs(micros: Long): String {
+        if (micros == UNAVAILABLE) return "n/a"
+        return String.format(Locale.US, "%.2f", micros / 1000.0)
+    }
