+            coilMemory.getAndSet(0),
+            coilDisk.getAndSet(0),
+            coilNetwork.getAndSet(0),
+            coilHardware.getAndSet(0),
+            coilErrors.getAndSet(0),
+            coilStarted.getAndSet(0),
+        )
+    }
+
+    private fun resetCoil() {
+        drainCoil()
+    }
