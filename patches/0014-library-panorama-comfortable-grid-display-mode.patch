+                if (state.layoutInfo.totalItemsCount == 0 || isThumbDragged) return@LaunchedEffect
+                val estimate = estimateStaggeredGrid(state) ?: return@LaunchedEffect
+                val extraScrollRange = (estimate.scrollRange - heightPx).coerceAtLeast(1f)
+                val proportion = (estimate.scrollOffset / extraScrollRange).coerceIn(0f, 1f)
